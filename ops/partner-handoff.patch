diff --git a/src/modules/transport/partnerCollectionCore.ts b/src/modules/transport/partnerCollectionCore.ts
new file mode 100644
index 00000000..e8a5d4ac
--- /dev/null
+++ b/src/modules/transport/partnerCollectionCore.ts
@@ -0,0 +1,137 @@
+/**
+ * Twakkal-only optional Partner Collection & Settlement projection.
+ * This file NEVER posts invoices, cash, journals, VAT or transfers.
+ * Amounts passed to allocation functions are integer halalas (SAR * 100).
+ */
+export type PartnerId = string;
+export type PartnerRule = {ownerAlias:string;partnerId:PartnerId};
+export type OwnerClassification =
+  | {status:'assigned';partnerId:PartnerId;source:'explicit'|'default'}
+  | {status:'review';reason:'missing_owner'|'no_default'|'ambiguous_alias'};
+
+/** The alias must match the WHOLE saved owner, never substrings: SAJID ≠ SAJID WINCH. */
+export function ownerKey(value:unknown):string {
+  return String(value??'').trim().replace(/\s+/g,' ').toLocaleUpperCase('en-US');
+}
+export function classifyOwner(owner:unknown,rules:readonly PartnerRule[],defaultPartnerId:PartnerId|null):OwnerClassification {
+  const key=ownerKey(owner);
+  if(!key)return {status:'review',reason:'missing_owner'};
+  const exact=new Set(rules.filter(r=>ownerKey(r.ownerAlias)===key).map(r=>r.partnerId));
+  if(exact.size>1)return {status:'review',reason:'ambiguous_alias'};
+  if(exact.size===1)return {status:'assigned',partnerId:[...exact][0],source:'explicit'};
+  return defaultPartnerId?{status:'assigned',partnerId:defaultPartnerId,source:'default'}:{status:'review',reason:'no_default'};
+}
+export function sarToHalalas(value:string):number {
+  if(!/^(?:0|[1-9]\d{0,11})(?:\.\d{1,2})?$/.test(value.trim()))throw new Error('Enter a nonnegative SAR amount with up to two decimals.');
+  const [whole,fraction='']=value.trim().split('.');
+  const result=Number(whole)*100+Number(fraction.padEnd(2,'0'));
+  if(!Number.isSafeInteger(result))throw new Error('Amount exceeds supported precision.');
+  return result;
+}
+export function halalasToSar(value:number):string {
+  if(!Number.isSafeInteger(value)||value<0)throw new Error('Invalid halalas.');
+  return `${Math.floor(value/100)}.${String(value%100).padStart(2,'0')}`;
+}
+
+/** Each share is remaining invoice-GROSS receivable, including its allocated VAT.
+ *  Does NOT decide the legal P&L or VAT treatment. For partner payout, gross cash received
+ *  and later VAT reimbursement are tracked in SEPARATE movements.
+ */
+export type CollectionCapacity={key:string;partnerId:PartnerId;availableHalalas:number};
+export type PaymentShare={key:string;partnerId:PartnerId;halalas:number};
+function checkedCapacities(input:readonly CollectionCapacity[]):CollectionCapacity[] {
+  const keys=new Set<string>();
+  return input.map(c=>{
+    if(!c.key?.trim()||!c.partnerId?.trim()||keys.has(c.key))throw new Error('Duplicate or invalid invoice/Trip allocation key.');
+    keys.add(c.key);
+    if(!Number.isSafeInteger(c.availableHalalas)||c.availableHalalas<0)throw new Error('Invalid remaining receivable.');
+    return {...c};
+  });
+}
+/** Deterministic largest-remainder proportional allocation; caps are never exceeded. */
+export function autoAllocate(amountHalalas:number,input:readonly CollectionCapacity[]):PaymentShare[] {
+  const capacities=checkedCapacities(input);
+  if(!Number.isSafeInteger(amountHalalas)||amountHalalas<0)throw new Error('Invalid expected amount.');
+  const total=capacities.reduce((sum,c)=>sum+c.availableHalalas,0);
+  if(!Number.isSafeInteger(total)||amountHalalas>total)throw new Error('Payment exceeds selected outstanding.');
+  if(amountHalalas===0)return [];
+  const active=capacities.filter(c=>c.availableHalalas>0).sort((a,b)=>a.key.localeCompare(b.key));
+  // Use quotient and remainder of integer multiplication to eliminate rounding drift.
+  const shares=active.map(c=>{
+    const product=BigInt(amountHalalas)*BigInt(c.availableHalalas);
+    return {...c,allocated:Number(product/BigInt(total)),remainder:product%BigInt(total)};
+  });
+  let leftover=amountHalalas-shares.reduce((s,x)=>s+x.allocated,0);
+  const ranked=[...shares].sort((a,b)=>a.remainder===b.remainder?a.key.localeCompare(b.key):a.remainder>b.remainder?-1:1);
+  for(const x of ranked){if(!leftover)break;if(x.allocated<x.availableHalalas){x.allocated++;leftover--;}}
+  if(leftover!==0)throw new Error('Unable to reconcile distribution.');
+  return shares.filter(x=>x.allocated>0).map(x=>({key:x.key,partnerId:x.partnerId,halalas:x.allocated}));
+}
+export function validateManualAllocation(amountHalalas:number,input:readonly CollectionCapacity[],shares:readonly PaymentShare[]):PaymentShare[] {
+  if(!Number.isSafeInteger(amountHalalas)||amountHalalas<0)throw new Error('Invalid payment.');
+  const capacities=new Map(checkedCapacities(input).map(x=>[x.key,x]));
+  const used=new Set<string>();let sum=0;
+  const results=shares.map(s=>{
+    const c=capacities.get(s.key);
+    if(!c||used.has(s.key)||s.partnerId!==c.partnerId)throw new Error('Unknown, duplicated or mismatched partner allocation.');
+    used.add(s.key);
+    if(!Number.isSafeInteger(s.halalas)||s.halalas<0||s.halalas>c.availableHalalas)throw new Error('Allocation exceeds remaining invoice balance.');
+    sum+=s.halalas;
+    return {...s};
+  });
+  if(sum!==amountHalalas)throw new Error('Partner allocations do not equal the receipt total.');
+  return results.filter(x=>x.halalas>0);
+}
+/**
+ * Partner account is NOT a second statutory AR/GL. Invoice gross receivable is an
+ * analytical attribution of the canonical customer invoice, not a duplicate sale.
+ * Each movement must be sourced from a unique posted invoice, credit or receipt.
+ * VAT due/reimbursed are a separate partner-to-Twakkal clearing balance; the tax
+ * obligation and legal principal-vs-agent treatment are decided outside this file.
+ */
+export type PartnerAccountMovement = {
+  kind:
+   | 'invoice_billed' | 'invoice_credit'
+   | 'customer_received' | 'customer_refunded'
+   | 'partner_advance' | 'partner_paid' | 'partner_returned'
+   | 'vat_due' | 'vat_reimbursed' | 'vat_reimbursement_refunded';
+  halalas:number;
+};
+export function partnerAccountSummary(movements:readonly PartnerAccountMovement[]) {
+  let billed=0,credits=0,customerReceived=0,customerRefunded=0;
+  let partnerAdvanced=0,partnerPaid=0,partnerReturned=0;
+  let vatDue=0,vatReimbursed=0,vatReimbursementRefunded=0;
+  for(const m of movements) {
+    if(!Number.isSafeInteger(m.halalas)||m.halalas<0)throw new Error('Invalid partner account movement amount.');
+    switch(m.kind){
+      case 'invoice_billed':billed+=m.halalas;break;
+      case 'invoice_credit':credits+=m.halalas;break;
+      case 'customer_received':customerReceived+=m.halalas;break;
+      case 'customer_refunded':customerRefunded+=m.halalas;break;
+      case 'partner_advance':partnerAdvanced+=m.halalas;break;
+      case 'partner_paid':partnerPaid+=m.halalas;break;
+      case 'partner_returned':partnerReturned+=m.halalas;break;
+      case 'vat_due':vatDue+=m.halalas;break;
+      case 'vat_reimbursed':vatReimbursed+=m.halalas;break;
+      case 'vat_reimbursement_refunded':vatReimbursementRefunded+=m.halalas;break;
+      default:throw new Error('Unknown movement kind.');
+    }
+  }
+  const invoicedGross=billed-credits;
+  const appliedCollections=customerReceived-customerRefunded;
+  const customerReceivable=invoicedGross-appliedCollections;
+  const heldForPartner=appliedCollections-partnerAdvanced-partnerPaid+partnerReturned;
+  const partnerVatReceivable=vatDue-vatReimbursed+vatReimbursementRefunded;
+  if(![invoicedGross,appliedCollections,customerReceivable,heldForPartner,partnerVatReceivable].every(Number.isSafeInteger))
+    throw new Error('Account calculation exceeds supported precision.');
+  if(invoicedGross<0||customerReceivable<0||appliedCollections<0||partnerVatReceivable<0)
+    throw new Error('Partner account movements do not reconcile.');
+  // Held may be negative when Twakkal has paid an advance ahead of collection.
+  return {invoicedGross,appliedCollections,customerReceivable,
+    partnerAdvanced,partnerPaid,partnerReturned,heldForPartner,
+    vatDue,vatReimbursed,vatReimbursementRefunded,partnerVatReceivable};
+}
+/** Return maximum normal partner payout. Advances are separate, explicitly approved events. */
+export function availablePartnerPayout(movements:readonly PartnerAccountMovement[]):number {
+  return Math.max(0,partnerAccountSummary(movements).heldForPartner);
+}
diff --git a/src/modules/transport/partnerLedgerReview.ts b/src/modules/transport/partnerLedgerReview.ts
new file mode 100644
index 00000000..379d6e1c
--- /dev/null
+++ b/src/modules/transport/partnerLedgerReview.ts
@@ -0,0 +1,84 @@
+/**
+ * Partner invoice-level analytical receivables; never creates statutory AR or GL entries.
+ * A customer receipt can be assigned to a partner only when the invoice has exactly
+ * one partner OR when a separate immutable, approved per-partner allocation exists.
+ * Existing mixed-partner paid invoices are quarantined, not redistributed by ratio.
+ * Monetary inputs are integer halalas (SAR x 100), not floating-point SAR.
+ */
+export type PartnerInvoiceEvidence = {
+  invoiceId:string;
+  partnerId:string;
+  partnerGrossHalalas:number;
+  invoiceGrossHalalas:number;
+  summedTripGrossHalalas:number;
+  canonicalReceivedHalalas:number;
+  canonicalAllocationHalalas:number;
+  partnerCount:number;
+  status:'posted'|'draft'|'cancelled'|string;
+  hasOpeningMismatch:boolean;
+  hasHistoricalCustomerReceipt:boolean;
+  hasOpeningSettlement:boolean;
+  hasAdjustment:boolean;
+  hasReversal:boolean;
+  missingPartner:boolean;
+  linkedReceivedHalalas?:number;
+  linkedReceiptHalalas?:number;
+  linkedComplete?:boolean;
+};
+export type PartnerLedgerFlag =
+  |'NOT_POSTED'|'INVALID_EVIDENCE'|'INVOICE_TRIP_MISMATCH'
+  |'CANONICAL_RECEIPT_MISMATCH'|'OVERPAYMENT'|'HISTORICAL_RECEIPT_REVIEW'
+  |'OPENING_SETTLEMENT_REVIEW'|'OPENING_SOURCE_CONFLICT'
+  |'ADJUSTMENT_REVIEW'|'REVERSAL_REVIEW'|'UNATTRIBUTED_OWNER'
+  |'MIXED_PARTNER_PRIOR_RECEIPT';
+
+export type PartnerLedgerAssessment = {
+  invoiceId:string;
+  flags:PartnerLedgerFlag[];
+  verified:boolean;
+  invoicedGrossHalalas:number;
+  receivedHalalas:number|null;
+  receivableHalalas:number|null;
+};
+export function assessPartnerInvoice(e:PartnerInvoiceEvidence):PartnerLedgerAssessment{
+  const flags:PartnerLedgerFlag[]=[];
+  const add=(x:PartnerLedgerFlag)=>{if(!flags.includes(x))flags.push(x);};
+  const amounts=[e.partnerGrossHalalas,e.invoiceGrossHalalas,e.summedTripGrossHalalas,e.canonicalReceivedHalalas,e.canonicalAllocationHalalas, ...(e.linkedReceivedHalalas===undefined?[]:[e.linkedReceivedHalalas]), ...(e.linkedReceiptHalalas===undefined?[]:[e.linkedReceiptHalalas])];
+  const valid=!!e.invoiceId&&!!e.partnerId&&Number.isInteger(e.partnerCount)&&e.partnerCount>0&&
+    amounts.every(v=>Number.isSafeInteger(v)&&v>=0)&&e.partnerGrossHalalas<=e.invoiceGrossHalalas;
+  if(!valid)add('INVALID_EVIDENCE');
+  if(e.status!=='posted')add('NOT_POSTED');
+  if(e.missingPartner)add('UNATTRIBUTED_OWNER');
+  if(e.summedTripGrossHalalas!==e.invoiceGrossHalalas)add('INVOICE_TRIP_MISMATCH');
+  if(e.canonicalReceivedHalalas!==e.canonicalAllocationHalalas)add('CANONICAL_RECEIPT_MISMATCH');
+  if(e.canonicalReceivedHalalas>e.invoiceGrossHalalas)add('OVERPAYMENT');
+  if(e.hasOpeningMismatch)add('OPENING_SOURCE_CONFLICT');
+  if(e.hasHistoricalCustomerReceipt)add('HISTORICAL_RECEIPT_REVIEW');
+  if(e.hasOpeningSettlement)add('OPENING_SETTLEMENT_REVIEW');
+  if(e.hasAdjustment)add('ADJUSTMENT_REVIEW');
+  if(e.hasReversal)add('REVERSAL_REVIEW');
+  const complete=e.linkedComplete===true&&e.linkedReceiptHalalas===e.canonicalReceivedHalalas;
+  if(e.partnerCount>1&&e.canonicalReceivedHalalas>0&&!complete)add('MIXED_PARTNER_PRIOR_RECEIPT');
+  if(complete&&((e.linkedReceivedHalalas??0)>e.partnerGrossHalalas))add('OVERPAYMENT');
+  const verified=flags.length===0;
+  const received=verified&&e.partnerCount===1?e.canonicalReceivedHalalas:verified&&complete?(e.linkedReceivedHalalas??0):verified?0:null;
+  const outstanding=received===null?null:e.partnerGrossHalalas-received;
+  if(outstanding!==null&&outstanding<0){add('OVERPAYMENT');return {invoiceId:e.invoiceId,flags,verified:false,invoicedGrossHalalas:e.partnerGrossHalalas,receivedHalalas:null,receivableHalalas:null};}
+  return {invoiceId:e.invoiceId,flags,verified,invoicedGrossHalalas:e.partnerGrossHalalas,
+    receivedHalalas:received,receivableHalalas:outstanding};
+}
+export function summarizePartnerInvoices(rows:readonly PartnerLedgerAssessment[]){
+  let verifiedInvoices=0,reviewInvoices=0,verifiedBilled=0,verifiedReceived=0,verifiedOutstanding=0,reviewBilled=0;
+  const ids=new Set<string>();
+  for(const r of rows){
+    if(ids.has(r.invoiceId))throw new Error('Duplicate invoice counted in partner receivables.');ids.add(r.invoiceId);
+    if(!Number.isSafeInteger(r.invoicedGrossHalalas)||r.invoicedGrossHalalas<0)throw new Error('Invalid invoice amount.');
+    if(r.verified){
+      if(r.flags.length||r.receivedHalalas===null||r.receivableHalalas===null||r.receivedHalalas+r.receivableHalalas!==r.invoicedGrossHalalas)
+        throw new Error('Verified balance did not reconcile.');
+      verifiedInvoices++;verifiedBilled+=r.invoicedGrossHalalas;verifiedReceived+=r.receivedHalalas;verifiedOutstanding+=r.receivableHalalas;
+    }else{reviewInvoices++;reviewBilled+=r.invoicedGrossHalalas;}
+  }
+  if(![verifiedBilled,verifiedReceived,verifiedOutstanding,reviewBilled].every(Number.isSafeInteger))throw new Error('Ledger amount overflow.');
+  return {verifiedInvoices,reviewInvoices,verifiedBilled,verifiedReceived,verifiedOutstanding,reviewBilled};
+}
diff --git a/src/modules/transport/partnerMonthlySettlement.ts b/src/modules/transport/partnerMonthlySettlement.ts
new file mode 100644
index 00000000..325b2f57
--- /dev/null
+++ b/src/modules/transport/partnerMonthlySettlement.ts
@@ -0,0 +1,52 @@
+/** Verified-source partner month-end analytical statement, without new accounting postings. */
+import {parseSarHalalas,sarString} from './partnerSettlementUtils.js';
+export type PartnerEventKind='invoice'|'customer_receipt'|'partner_transfer'|'partner_advance'|'partner_vat_received';
+export type PartnerEvent={
+ sourceId:string;partnerId:string;companyId:string;businessUnitId:string;
+ date:string;kind:PartnerEventKind; amountSar:string;
+ vatSar?:string;verified:boolean;reversed?:boolean;
+};
+export type MonthBalance={receivableSar:string;cashHeldSar:string;vatRecoverableSar:string};
+export type MonthlyStatement={partnerId:string;month:string;opening:MonthBalance;movement:MonthBalance;closing:MonthBalance;
+ reviewRequired:boolean;reviewReasons:string[];eventsThisMonth:number;eligibleForMonthClose:boolean};
+const isoDate=/^\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\d|3[01])$/;
+function validDate(s:string){if(!isoDate.test(s))return false;const d=new Date(s+'T00:00:00Z');return !Number.isNaN(d.valueOf())&&d.toISOString().slice(0,10)===s;}
+const plus=(a:number,b:number)=>{const v=a+b;if(!Number.isSafeInteger(v))throw Error('SAR overflow');return v};
+type Amounts={receivable:number;held:number;vat:number};
+const empty=():Amounts=>({receivable:0,held:0,vat:0});
+const render=(a:Amounts):MonthBalance=>({receivableSar:sarString(a.receivable),cashHeldSar:sarString(a.held),vatRecoverableSar:sarString(a.vat)});
+export function buildPartnerMonthlyStatement(input:{partnerId:string;companyId:string;businessUnitId:string;month:string;events:PartnerEvent[]; sourceConflicts?:string[]}):MonthlyStatement {
+ const {partnerId,companyId,businessUnitId,month,events}=input;
+ if(!/^\d{4}-(?:0[1-9]|1[0-2])$/.test(month))throw Error('Invalid statement month');
+ if(!partnerId||!companyId||!businessUnitId)throw Error('Missing scope');
+ const before=empty(),thisMonth=empty(),reasons=new Set<string>(input.sourceConflicts??[]);const seen=new Set<string>();
+ let monthCount=0;
+ for(const ev of events){
+  if(ev.partnerId!==partnerId||ev.companyId!==companyId||ev.businessUnitId!==businessUnitId)throw Error('Cross-scope settlement event');
+  if(!ev.sourceId||!validDate(ev.date))throw Error('Invalid source/date');
+  // An immutable source ID may only contribute once, even if a bad import changes the event kind.
+  const unique=ev.sourceId;
+  if(seen.has(unique)){reasons.add('DUPLICATE_SOURCE_EVENT');continue;}seen.add(unique);
+  if(ev.date.slice(0,7)>month)continue;
+  if(!ev.verified){reasons.add('UNVERIFIED_SOURCE');continue;}
+  if(ev.reversed){reasons.add('REVERSED_SOURCE_REQUIRES_RECONCILIATION');continue;}
+  const amount=parseSarHalalas(ev.amountSar);if(amount<=0)throw Error('Movement must be positive');
+  const target=ev.date.slice(0,7)<month?before:thisMonth;
+  if(target===thisMonth)monthCount++;
+  if(ev.kind==='invoice'){
+   const vat=parseSarHalalas(ev.vatSar??'0');if(vat<0||vat>amount)throw Error('Invoice VAT invalid');
+   target.receivable=plus(target.receivable,amount);target.vat=plus(target.vat,vat);
+  }else if(ev.kind==='customer_receipt'){
+   target.receivable=plus(target.receivable,-amount);target.held=plus(target.held,amount);
+  }else if(ev.kind==='partner_transfer')target.held=plus(target.held,-amount);
+  else if(ev.kind==='partner_advance')target.held=plus(target.held,-amount);
+  else if(ev.kind==='partner_vat_received')target.vat=plus(target.vat,-amount);
+  else throw Error('Unsupported event kind');
+ }
+ const closing:Amounts={receivable:plus(before.receivable,thisMonth.receivable),held:plus(before.held,thisMonth.held),vat:plus(before.vat,thisMonth.vat)};
+ if(closing.receivable<0)reasons.add('CUSTOMER_RECEIPTS_EXCEED_INVOICES');
+ if(closing.held<0)reasons.add('PARTNER_ADVANCES_EXCEED_COLLECTION');
+ if(closing.vat<0)reasons.add('VAT_REIMBURSEMENT_EXCEEDS_ASSESSED');
+ return {partnerId,month,opening:render(before),movement:render(thisMonth),closing:render(closing),
+  reviewRequired:reasons.size>0,reviewReasons:[...reasons].sort(),eventsThisMonth:monthCount,eligibleForMonthClose:reasons.size===0};
+}
diff --git a/src/modules/transport/partnerPostingPlan.ts b/src/modules/transport/partnerPostingPlan.ts
new file mode 100644
index 00000000..a00a2611
--- /dev/null
+++ b/src/modules/transport/partnerPostingPlan.ts
@@ -0,0 +1,89 @@
+/**
+ * NAVILO Partner Collection: controlled accounting journal preflight ONLY.
+ * No database writes and no GL posting are performed by this module.
+ * Approval flags MUST come from authenticated server checks, never client form controls.
+ */
+import {parseSarHalalas,sarString,type SettlementKind} from './partnerSettlementUtils.js';
+export type COAAccount = {
+ id:string; code:string; name:string;
+ type:'asset'|'liability'|'income'|'revenue'|'expense'|'equity'|string;
+ detail_type:string; is_active:boolean; is_group:boolean; allow_manual_entries:boolean;
+ company_id:string;
+};
+export type FinanceMapping = {
+ company_id:string;
+ partner_payable_account_id:string;
+ partner_advance_account_id:string;
+ partner_vat_receivable_account_id:string;
+ approved:boolean;
+};
+export type PostingPreflight = {
+ kind:SettlementKind; amountSar:string; bankAccountId:string;
+ partnerId:string; companyId:string;
+ statementReviewed:boolean;
+ canonicalEvidenceVerified:boolean;
+ /** Server-side journal ledger recognition, NOT a user-entered account balance. */
+ recognizedPartnerPayableSar:string;
+ recognizedPartnerVatReceivableSar:string;
+ confirmedCollectedCashHeldSar:string;
+ unrecoveredPartnerVatSar:string;
+ /** Controlled, explicit approval for negative cash-held advance situations. */
+ advanceApproved:boolean;
+ /** User-visible evidence ref recorded by server. */
+ reference:string;
+ requestId:string;
+};
+export type PostingLine={accountId:string;side:'debit'|'credit';amountSar:string;purpose:string};
+export type PostingPlan={
+ kind:SettlementKind; reference:string; requestId:string; partnerId:string;
+ lines:PostingLine[];
+ eligibleForServerPosting:boolean; blockingReasons:string[];
+ journalEffect:'cash_out'|'cash_in';
+};
+const NON_PARTNER_DETAILS=new Set(['Accounts Receivable','Accounts Payable','Input VAT','Output VAT']);
+const idRx=/^[a-f\d]{8}(-[a-f\d]{4}){3}-[a-f\d]{12}$/i;
+function approvedAccount(a:COAAccount|undefined,c:string,kind:'asset'|'liability'){
+ return Boolean(a&&a.company_id===c&&a.type===kind&&a.is_active&&!a.is_group&&a.allow_manual_entries&&!NON_PARTNER_DETAILS.has(a.detail_type));
+}
+function safeMoney(x:string){return parseSarHalalas(x,{allowNegative:true});}
+export function planPartnerCashPosting(pre:PostingPreflight,mapping:FinanceMapping|null,accounts:COAAccount[]):PostingPlan {
+ if(!['partner_transfer','partner_advance','partner_vat_received'].includes(pre.kind))throw Error('Invalid posting kind');
+ const amount=parseSarHalalas(pre.amountSar);
+ if(amount<=0)throw Error('Amount must exceed zero');
+ const held=safeMoney(pre.confirmedCollectedCashHeldSar);
+ const payable=safeMoney(pre.recognizedPartnerPayableSar);
+ const vat=safeMoney(pre.unrecoveredPartnerVatSar);
+ const vatGl=safeMoney(pre.recognizedPartnerVatReceivableSar);
+ const errors=new Set<string>();
+ const accountMap=new Map(accounts.map(a=>[a.id,a]));
+ if(!pre.companyId||!idRx.test(pre.partnerId)||!idRx.test(pre.requestId))errors.add('INVALID_SCOPE_OR_IDEMPOTENCY_KEY');
+ if(!mapping?.approved||mapping.company_id!==pre.companyId)errors.add('UNAPPROVED_FINANCE_MAPPING');
+ const ids=mapping?[mapping.partner_payable_account_id,mapping.partner_advance_account_id,mapping.partner_vat_receivable_account_id]:[];
+ if(new Set(ids).size!==3)errors.add('GL_ACCOUNT_REUSED');
+ if(!approvedAccount(accountMap.get(ids[0]),pre.companyId,'liability'))errors.add('PARTNER_PAYABLE_GL_MISSING');
+ if(!approvedAccount(accountMap.get(ids[1]),pre.companyId,'asset'))errors.add('PARTNER_ADVANCE_GL_MISSING');
+ if(!approvedAccount(accountMap.get(ids[2]),pre.companyId,'asset'))errors.add('PARTNER_VAT_RECOVERY_GL_MISSING');
+ const bank=accountMap.get(pre.bankAccountId);
+ if(!bank||bank.company_id!==pre.companyId||bank.type!=='asset'||!bank.is_active||bank.is_group||!bank.allow_manual_entries||!['Bank Account','Cash on Hand'].includes(bank.detail_type))errors.add('CASH_BANK_GL_INVALID');
+ if(ids.includes(pre.bankAccountId))errors.add('COUNTERPART_IS_CASH_ACCOUNT');
+ if(!pre.statementReviewed||!pre.canonicalEvidenceVerified)errors.add('UNRECONCILED_PARTNER_LEDGER');
+ if(pre.reference.trim().length<8||pre.reference.trim().length>160)errors.add('EVIDENCE_REFERENCE_REQUIRED');
+ if(pre.kind==='partner_transfer'){
+  if(held<amount)errors.add('INSUFFICIENT_VERIFIED_COLLECTION');
+  if(payable<amount)errors.add('PARTNER_LIABILITY_NOT_RECOGNIZED');
+ }
+ if(pre.kind==='partner_advance'&&!pre.advanceApproved)errors.add('ADVANCE_APPROVAL_REQUIRED');
+ if(pre.kind==='partner_vat_received'){
+  if(vat<amount)errors.add('VAT_RECOVERY_OVERLIMIT');
+  if(vatGl<amount)errors.add('VAT_RECEIVABLE_NOT_RECOGNIZED');
+ }
+ const cashOut=pre.kind!=='partner_vat_received';
+ const counter=pre.kind==='partner_transfer'?ids[0]:pre.kind==='partner_advance'?ids[1]:ids[2];
+ const lines:PostingLine[]=[
+  {accountId:cashOut?counter:pre.bankAccountId,side:'debit',amountSar:sarString(amount),purpose:cashOut?'Recognized partner liability/advance':'Bank receipt of VAT reimbursement'},
+  {accountId:cashOut?pre.bankAccountId:counter,side:'credit',amountSar:sarString(amount),purpose:cashOut?'Bank transfer to partner':'Settle recognized VAT recovery asset'},
+ ];
+ // There is deliberately NO client callable posting action here.
+ return {kind:pre.kind,reference:pre.reference.trim(),requestId:pre.requestId,partnerId:pre.partnerId,lines,
+  eligibleForServerPosting:errors.size===0,blockingReasons:[...errors].sort(),journalEffect:cashOut?'cash_out':'cash_in'};
+}
diff --git a/src/modules/transport/partnerPostingRehearsal.ts b/src/modules/transport/partnerPostingRehearsal.ts
new file mode 100644
index 00000000..4fb537ca
--- /dev/null
+++ b/src/modules/transport/partnerPostingRehearsal.ts
@@ -0,0 +1,38 @@
+/** Standalone in-memory transactional rehearsal. NOT a Supabase RPC or production posting implementation. */
+import {planPartnerCashPosting,type COAAccount,type FinanceMapping,type PostingPreflight,type PostingPlan} from './partnerPostingPlan.js';
+import {parseSarHalalas,sarString} from './partnerSettlementUtils.js';
+export type DryRunJournal={requestId:string;partnerId:string;companyId:string;kind:PostingPlan['kind'];reference:string;lines:PostingPlan['lines'];status:'posted';};
+export type DryRunResult={status:'created'|'idempotent';journal:DryRunJournal};
+export class PartnerPostingRehearsal {
+ private readonly posted=new Map<string,{fingerprint:string;journal:DryRunJournal}>();
+ private readonly recognized=new Map<string,{payable:number;vat:number;held:number;unrecoveredVat:number}>();
+ constructor(private readonly mapping:FinanceMapping,private readonly accounts:COAAccount[]){}
+ seedRecognized(partnerId:string,values:{payableSar:string;vatSar:string;heldSar:string;unrecoveredVatSar:string}){
+  if(this.posted.size)throw Error('Cannot re-seed after first posting');
+  this.recognized.set(partnerId,{payable:parseSarHalalas(values.payableSar),vat:parseSarHalalas(values.vatSar),held:parseSarHalalas(values.heldSar,{allowNegative:true}),unrecoveredVat:parseSarHalalas(values.unrecoveredVatSar)});
+ }
+ preview(pre:PostingPreflight):PostingPlan{
+  const b=this.recognized.get(pre.partnerId);if(!b)throw Error('NO_RECOGNIZED_OPENING');
+  return planPartnerCashPosting({...pre,recognizedPartnerPayableSar:sarString(b.payable),recognizedPartnerVatReceivableSar:sarString(b.vat),confirmedCollectedCashHeldSar:sarString(b.held),unrecoveredPartnerVatSar:sarString(b.unrecoveredVat)},this.mapping,this.accounts);
+ }
+ post(pre:PostingPreflight):DryRunResult{
+  // Fingerprint includes the transaction fields, never mutable server-calculated balances.
+  const fingerprint=JSON.stringify({kind:pre.kind,amountSar:pre.amountSar,bankAccountId:pre.bankAccountId,partnerId:pre.partnerId,companyId:pre.companyId,statementReviewed:pre.statementReviewed,canonicalEvidenceVerified:pre.canonicalEvidenceVerified,advanceApproved:pre.advanceApproved,reference:pre.reference});
+  const existing=this.posted.get(pre.requestId);
+  if(existing){if(existing.fingerprint!==fingerprint)throw Error('IDEMPOTENCY_PAYLOAD_MISMATCH');return {status:'idempotent',journal:existing.journal};}
+  const plan=this.preview(pre);
+  if(!plan.eligibleForServerPosting)throw Error('POSTING_BLOCKED: '+plan.blockingReasons.join(','));
+  const debit=plan.lines.filter(l=>l.side==='debit').reduce((s,l)=>s+parseSarHalalas(l.amountSar),0);
+  const credit=plan.lines.filter(l=>l.side==='credit').reduce((s,l)=>s+parseSarHalalas(l.amountSar),0);
+  if(plan.lines.length!==2||debit!==credit)throw Error('UNBALANCED_JOURNAL');
+  const b=this.recognized.get(pre.partnerId)!;const amount=parseSarHalalas(pre.amountSar);
+  // Atomic in this single-threaded simulation; production must lock rows in PostgreSQL.
+  if(pre.kind==='partner_transfer'){b.payable-=amount;b.held-=amount;}
+  else if(pre.kind==='partner_advance'){b.held-=amount;}
+  else if(pre.kind==='partner_vat_received'){b.vat-=amount;b.unrecoveredVat-=amount;}
+  const journal:DryRunJournal={requestId:pre.requestId,partnerId:pre.partnerId,companyId:pre.companyId,kind:pre.kind,reference:pre.reference,lines:plan.lines,status:'posted'};
+  this.posted.set(pre.requestId,{fingerprint,journal});return {status:'created',journal};
+ }
+ balances(partnerId:string){const b=this.recognized.get(partnerId);if(!b)throw Error('Missing partner');return {payableSar:sarString(b.payable),vatSar:sarString(b.vat),heldSar:sarString(b.held),unrecoveredVatSar:sarString(b.unrecoveredVat)};}
+ get count(){return this.posted.size;}
+}
diff --git a/src/modules/transport/partnerReceiptLink.ts b/src/modules/transport/partnerReceiptLink.ts
new file mode 100644
index 00000000..b161dc9b
--- /dev/null
+++ b/src/modules/transport/partnerReceiptLink.ts
@@ -0,0 +1,79 @@
+/** Canonical posted customer receipt -> analytical partner distribution. No bank/AR/VAT writes. */
+import {autoAllocate,validateManualAllocation,sarToHalalas,type PaymentShare,type CollectionCapacity} from './partnerCollectionCore.js';
+
+export type PostedReceipt = {
+  receipt_allocation_id:string;
+  invoice_id:string;
+  reference:string|null;
+  allocation_date:string;
+  amount:number;
+  journal_status:string;
+  reversed:boolean;
+  saved_shares: Array<{partner_id:string;amount:number}>;
+};
+export type ReceiptPartner = {partner_id:string;partner_name:string;gross:number;saved_on_other_receipts:number};
+export type ReceiptLinkAssessment = {flags:string[]; amountHalalas:number; capacities:CollectionCapacity[]; existingShares:PaymentShare[]};
+function cash(n:unknown):number {
+  const value=Number(n);
+  if(!Number.isFinite(value)||value<0)throw new Error('Invalid cash amount');
+  const rounded=Math.round(value*100);
+  if(!Number.isSafeInteger(rounded)||Math.abs(value*100-rounded)>0.00001)throw new Error('Invalid amount precision');
+  return rounded;
+}
+/** Allow reviewed historical receipt links; never infer where an old mixed invoice payment belongs. */
+export function assessPostedReceipt(receipt:PostedReceipt, partners:ReceiptPartner[]):ReceiptLinkAssessment {
+  const flags:string[]=[];
+  if(receipt.journal_status!=='posted')flags.push('RECEIPT_NOT_POSTED');
+  if(receipt.reversed)flags.push('REVERSED_RECEIPT');
+  if(!receipt.receipt_allocation_id||!receipt.invoice_id)flags.push('MISSING_CANONICAL_LINK');
+  let amountHalalas=0;
+  try{amountHalalas=cash(receipt.amount);if(!amountHalalas)flags.push('ZERO_RECEIPT');}catch{flags.push('INVALID_RECEIPT_AMOUNT');}
+  const capacities:CollectionCapacity[]=[],known=new Set<string>();
+  for(const p of partners){
+    if(!p.partner_id||known.has(p.partner_id)){flags.push('DUPLICATE_PARTNER');continue;}
+    known.add(p.partner_id);
+    try{
+      const cap=cash(p.gross)-cash(p.saved_on_other_receipts);
+      if(cap<0)flags.push('NEGATIVE_PARTNER_CAPACITY');
+      capacities.push({key:p.partner_id,partnerId:p.partner_id,availableHalalas:Math.max(0,cap)});
+    }catch{flags.push('INVALID_PARTNER_CAPACITY');}
+  }
+  if(!capacities.length)flags.push('NO_PARTNERS');
+  if(capacities.reduce((sum,p)=>sum+p.availableHalalas,0)<amountHalalas)flags.push('INSUFFICIENT_RECEIVABLE');
+  const existingShares:PaymentShare[]=[];
+  try {
+    for(const saved of receipt.saved_shares){
+      if(!known.has(saved.partner_id))flags.push('SAVED_PARTNER_NOT_IN_INVOICE');
+      existingShares.push({key:saved.partner_id,partnerId:saved.partner_id,halalas:cash(saved.amount)});
+    }
+    if(existingShares.length && existingShares.reduce((sum,r)=>sum+r.halalas,0)!==amountHalalas)flags.push('PARTIAL_EXISTING_LINK');
+  }catch{flags.push('INVALID_SAVED_SPLIT');}
+  return {flags:[...new Set(flags)],amountHalalas,capacities,existingShares};
+}
+export function calculatePostedReceiptSplit(
+ receipt:PostedReceipt, partners:ReceiptPartner[],
+ method:'auto'|'manual', manual?:readonly PaymentShare[]
+):PaymentShare[]{
+  const check=assessPostedReceipt(receipt,partners);
+  if(check.flags.length)throw new Error(`Receipt cannot be linked: ${check.flags.join(', ')}`);
+  if(check.existingShares.length)throw new Error('This posted receipt is already linked. Its evidence cannot be overwritten.');
+  if(method==='manual')return validateManualAllocation(check.amountHalalas,check.capacities,manual??[]);
+  return autoAllocate(check.amountHalalas,check.capacities);
+}
+/** Request only references an existing posted allocation row. Never creates a receipt. */
+export function makeReceiptLinkRequest(
+ receipt:PostedReceipt, partners:ReceiptPartner[],method:'auto'|'manual',
+ shares:PaymentShare[],evidenceReference:string
+){
+  const check=assessPostedReceipt(receipt,partners);
+  if(check.flags.length||check.existingShares.length)throw new Error('Receipt no longer available for linking. Refresh.');
+  validateManualAllocation(check.amountHalalas,check.capacities,shares);
+  const evidence=evidenceReference.trim();
+  if((partners.length>1||method==='manual')&&evidence.length<6)throw new Error('A reviewed source reference is required for a manual/mixed-partner receipt.');
+  return {
+    p_receipt_allocation_id:receipt.receipt_allocation_id,
+    p_method:method,
+    p_evidence_reference:evidence,
+    p_shares:shares.filter(x=>x.halalas>0).map(x=>({partner_id:x.partnerId,amount:sarToHalalas((x.halalas/100).toFixed(2))/100}))
+  };
+}
diff --git a/src/modules/transport/partnerReceiptPlan.ts b/src/modules/transport/partnerReceiptPlan.ts
new file mode 100644
index 00000000..dd12099a
--- /dev/null
+++ b/src/modules/transport/partnerReceiptPlan.ts
@@ -0,0 +1,56 @@
+/** Twakkal: collection preview only. NO financial writes, no inferred historic allocations. */
+import {autoAllocate,validateManualAllocation, type PaymentShare, type CollectionCapacity} from './partnerCollectionCore.js';
+
+export type InvoiceReview = {
+  invoice_id:string; order_no:string; order_date:string; status:string;
+  invoice_gross:number;trip_gross:number;order_paid:number;posted_allocated:number;
+  allocation_rows:number;reversed_rows:number;opening_conflict_count:number;
+  historical_customer_received:number;opening_settled_document_count:number;
+  adjustment_count:number;partner_count:number;trip_count:number;
+  partners:Array<{partner_id:string|null;partner_name:string;partner_code:string;
+    net:number;vat:number;gross:number;trip_count:number;opening_conflicts:number}>;
+};
+export type ReviewFlag =
+  'NOT_POSTED'|'MISSING_TRIPS'|'UNATTRIBUTED_OWNER'|'LINE_TOTAL_MISMATCH'|
+  'PAYMENT_TIEOUT_MISMATCH'|'OVERPAYMENT'|'OPENING_SOURCE_CONFLICT'|
+  'ADJUSTMENT_REVIEW'|'REVERSED_RECEIPT_REVIEW'|'MIXED_PARTNER_PRIOR_RECEIPT'|
+  'HISTORICAL_RECEIPT_REVIEW'|'OPENING_SETTLEMENT_REVIEW';
+const cents=(n:number)=>{
+  if(!Number.isFinite(n)||n<0)throw new Error('Amount is invalid.');
+  const val=Math.round(n*100);
+  if(!Number.isSafeInteger(val)||Math.abs(n*100-val)>0.0001)throw new Error('Amount precision must be at most two decimals.');
+  return val;
+};
+/** Find every blocker before a partner-balance or payment preview is presented as verified. */
+export function reviewInvoice(r:InvoiceReview):{flags:ReviewFlag[];capacities:CollectionCapacity[];remainingHalalas:number}{
+  const flags:ReviewFlag[]=[];
+  const add=(flag:ReviewFlag)=>{if(!flags.includes(flag))flags.push(flag);};
+  if(r.status!=='posted')add('NOT_POSTED');
+  if(!Number.isSafeInteger(r.trip_count)||r.trip_count<1||!r.partners.length)add('MISSING_TRIPS');
+  if(r.partners.some(p=>!p.partner_id||p.partner_code==='review_required'))add('UNATTRIBUTED_OWNER');
+  const invoice=cents(r.invoice_gross),trip=cents(r.trip_gross),paid=cents(r.order_paid),allocated=cents(r.posted_allocated);
+  if(trip!==invoice||r.partners.reduce((sum,p)=>sum+cents(p.gross),0)!==invoice)add('LINE_TOTAL_MISMATCH');
+  if(paid!==allocated)add('PAYMENT_TIEOUT_MISMATCH');
+  if(paid>invoice)add('OVERPAYMENT');
+  if(r.historical_customer_received>0)add('HISTORICAL_RECEIPT_REVIEW');
+  if(r.opening_settled_document_count>0)add('OPENING_SETTLEMENT_REVIEW');
+  if(r.opening_conflict_count>0||r.partners.some(p=>p.opening_conflicts>0))add('OPENING_SOURCE_CONFLICT');
+  if(r.adjustment_count>0)add('ADJUSTMENT_REVIEW');
+  if(r.reversed_rows>0)add('REVERSED_RECEIPT_REVIEW');
+  if(r.partner_count>1&&paid>0)add('MIXED_PARTNER_PRIOR_RECEIPT');
+  const remaining=Math.max(0,invoice-paid);
+  // Do not attribute historical partial mixed-partner receipts without exact posted evidence.
+  if(flags.length)return {flags,capacities:[],remainingHalalas:remaining};
+  const capacities=r.partners.map(p=>({key:p.partner_id!,partnerId:p.partner_id!,availableHalalas:cents(p.gross)-(r.partner_count===1?paid:0)}));
+  if(capacities.some(x=>x.availableHalalas<0))return {flags:['OVERPAYMENT'],capacities:[],remainingHalalas:remaining};
+  if(capacities.reduce((s,x)=>s+x.availableHalalas,0)!==remaining)return {flags:['LINE_TOTAL_MISMATCH'],capacities:[],remainingHalalas:remaining};
+  return {flags:[],capacities,remainingHalalas:remaining};
+}
+/** For approved invoices only: expected (future) customer payment, NOT receipt posting. */
+export function planExpectedReceipt(r:InvoiceReview,amountHalalas:number,manual?:readonly PaymentShare[]):PaymentShare[]{
+  const review=reviewInvoice(r);
+  if(review.flags.length)throw new Error('This invoice requires reconciliation before partner payment preview.');
+  if(!Number.isSafeInteger(amountHalalas)||amountHalalas<=0||amountHalalas>review.remainingHalalas)
+    throw new Error('Expected payment must be positive and cannot exceed verified invoice outstanding.');
+  return manual?validateManualAllocation(amountHalalas,review.capacities,manual):autoAllocate(amountHalalas,review.capacities);
+}
