+   <p className="rounded border border-emerald-200 bg-emerald-50 p-2 text-emerald-900">Verified for future receipt preview. This does not post or reallocate any previous customer payment.</p>}
+  <div className="overflow-x-auto rounded border"><table className="w-full min-w-[630px] text-xs"><thead className="bg-slate-50"><tr><th className="p-2 text-left">Partner</th><th className="p-2 text-right">Trips</th><th className="p-2 text-right">Sales (net)</th><th className="p-2 text-right">VAT</th><th className="p-2 text-right">Invoice gross</th><th className="p-2 text-right">Available for preview</th></tr></thead>
+   <tbody>{review.partners.map(p=><tr key={p.partner_id??'unknown'} className="border-t"><td className="p-2">{p.partner_name}</td><td className="p-2 text-right">{p.trip_count}</td><td className="p-2 text-right">{money(p.net)}</td><td className="p-2 text-right">{money(p.vat)}</td><td className="p-2 text-right">{money(p.gross)}</td><td className="p-2 text-right">{assessment.flags.length?'Blocked':money((assessment.capacities.find(c=>c.partnerId===p.partner_id)?.availableHalalas??0)/100)}</td></tr>)}</tbody></table></div>
+  {!assessment.flags.length&&assessment.remainingHalalas>0&&<div className="rounded border p-3 space-y-2">
