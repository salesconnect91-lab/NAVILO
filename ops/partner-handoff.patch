+create function public.transport_collection_post(p_request uuid,p_partner uuid,p_kind text,p_date date,p_amount numeric,p_bank uuid,p_invoice uuid,p_reference text) returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();m public.transport_collection_finance_mapping%rowtype;o public.transport_collection_openings%rowtype;payload jsonb;prior public.transport_collection_requests%rowtype;r jsonb;pos jsonb;j uuid;off_j uuid;off_amount numeric;net numeric;vat numeric;gross numeric;ledger jsonb;row_data jsonb;
+begin
+ perform public.transport_collection_assert('post');
+ if p_request is null or p_date is null or p_date>current_date or p_kind not in('invoice_recognition','partner_transfer','partner_advance','partner_vat_received') or length(btrim(coalesce(p_reference,''))) not between 8 and 160 then raise exception 'Valid posting date, kind, request UUID and evidence reference required';end if;
+ perform pg_advisory_xact_lock(hashtextextended('partner-request:'||c::text||':'||b::text||':'||p_request::text,0));
+ payload:=jsonb_build_object('partner',p_partner,'kind',p_kind,'date',p_date,'amount',p_amount,'bank',p_bank,'invoice',p_invoice,'reference',btrim(p_reference));
+ select * into prior from public.transport_collection_requests where company_id=c and business_unit_id=b and request_id=p_request;
+ if found then if prior.payload<>payload then raise exception 'Idempotency payload mismatch';end if;return prior.result;end if;
+ perform pg_advisory_xact_lock(hashtextextended('partner-owner-map:'||c::text||':'||b::text,0));
+ perform pg_advisory_xact_lock(hashtextextended('partner:'||c::text||':'||b::text||':'||p_partner::text,0));
+ select * into strict m from public.transport_collection_finance_mapping where company_id=c and business_unit_id=b and is_approved and revenue_clearing_account_id is not null;
+ select * into strict o from public.transport_collection_openings where company_id=c and business_unit_id=b and partner_id=p_partner;
+ if p_date<o.cutover_date then raise exception 'Posting before confirmed cutover prohibited';end if;
+ if (select kind from public.transport_collection_month_events where partner_id=p_partner and company_id=c and business_unit_id=b and month=date_trunc('month',p_date)::date order by created_at desc,id desc limit 1)='close' then raise exception 'Partner month is closed; reopen with audit reason';end if;
+ if not exists(select 1 from public.transport_collection_partners where id=p_partner and company_id=c and business_unit_id=b and is_active) or exists(select 1 from public.transport_collection_settings where company_id=c and business_unit_id=b and default_partner_id=p_partner) then raise exception 'Active external partner required; own-business default is excluded from partner payouts';end if;
+ if p_kind in('partner_transfer','partner_advance','partner_vat_received') then
+  select rq.* into prior from public.transport_collection_requests rq where rq.company_id=c and rq.business_unit_id=b and rq.payload->>'partner'=p_partner::text and rq.payload->>'kind'=p_kind and rq.payload->>'date'=to_char(p_date,'YYYY-MM-DD') and lower(rq.payload->>'reference')=lower(btrim(p_reference));
+  if found then if prior.payload<>payload then raise exception 'Bank reference already used with different payment details';end if;return prior.result;end if;
+ end if;
+ pos:=public.transport_collection_position(p_partner,p_date);
+ if p_kind='invoice_recognition' then
+  if p_invoice is null or p_amount is not null or p_bank is not null then raise exception 'Invoice recognition uses canonical amounts only';end if;
+  perform 1 from public.sales_orders where id=p_invoice and company_id=c and business_unit_id=b for update;
+  if not found then raise exception 'Invoice outside workspace';end if;
+  if not exists(select 1 from public.sales_orders s join public.transport_customer_documents d on d.sales_order_id=s.id join public.transport_active_journals j on j.id=d.journal_entry_id where s.id=p_invoice and s.company_id=c and s.business_unit_id=b and s.status='posted' and s.currency_code='SAR' and s.order_date>=o.cutover_date and s.order_date<=p_date) then raise exception 'Active posted SAR invoice after cutover required';end if;
+  if exists(select 1 from public.transport_collection_financial_entries e join public.transport_active_journals j on j.id=e.journal_entry_id where e.partner_id=p_partner and e.invoice_id=p_invoice and e.kind='invoice_recognition') then raise exception 'Invoice partner share already recognized';end if;
+  ledger:=public.transport_collection_partner_invoice_ledger(p_partner,null,null,(select order_no from public.sales_orders where id=p_invoice),200,0);
+  select x into row_data from jsonb_array_elements(ledger->'rows') x where x->>'invoice_id'=p_invoice::text;
+  if row_data is null or not (row_data->>'verified')::boolean then raise exception 'Invoice partner source requires reconciliation';end if;
+  net:=(row_data->>'partner_net')::numeric;vat:=(row_data->>'partner_vat')::numeric;gross:=(row_data->>'partner_gross')::numeric;
+  if net<=0 or gross<>net+vat then raise exception 'Invalid invoice share';end if;
+  if (select coalesce(sum(l.credit-l.debit),0) from public.transport_customer_documents d join public.journal_lines l on l.entry_id=d.journal_entry_id where d.sales_order_id=p_invoice and l.account_id=m.revenue_clearing_account_id)<>(select sum(l.rate_snapshot) from public.transport_customer_documents d join public.transport_customer_document_trips l on l.document_id=d.id where d.sales_order_id=p_invoice) then raise exception 'Original invoice revenue does not match approved reclassification account';end if;
+  j:=public.transport_collection_journal(p_partner,p_date,'invoice_recognition',jsonb_build_array(jsonb_build_object('account_id',m.revenue_clearing_account_id,'debit',net,'credit',0),jsonb_build_object('account_id',m.partner_vat_receivable_account_id,'debit',vat,'credit',0),jsonb_build_object('account_id',m.partner_payable_account_id,'debit',0,'credit',gross)),p_reference);
+  insert into public.transport_collection_financial_entries(company_id,business_unit_id,partner_id,kind,invoice_id,journal_entry_id,reference,created_by) values(c,b,p_partner,p_kind,p_invoice,j,p_reference,auth.uid());
+ else
+  if p_invoice is not null or p_amount is null or p_amount<=0 or p_amount<>round(p_amount,2) or not exists(select 1 from public.chart_of_accounts where id=p_bank and company_id=c and is_active and not is_group and allow_manual_entries and type='asset' and detail_type in('Bank Account','Cash on Hand')) then raise exception 'Positive exact amount and active Cash/Bank GL required';end if;
+  if p_kind='partner_advance' then perform public.transport_collection_assert('post',true);end if;
+  if p_kind='partner_transfer' then
+   ledger:=public.transport_collection_partner_invoice_ledger(p_partner);
+   if (ledger->>'review_invoice_count')::int>0 then raise exception 'Unreconciled invoice source blocks payout';end if;
+   if p_amount>(pos->>'held')::numeric or p_amount>(pos->>'payable')::numeric then raise exception 'Insufficient verified collection or recognized payable';end if;
+   off_amount:=least(greatest((pos->>'advance')::numeric,0),greatest((pos->>'payable')::numeric,0));
+   if p_amount>(pos->>'payable')::numeric-off_amount then raise exception 'Advance adjustment leaves insufficient payable';end if;
+   if off_amount>0 then
+    off_j:=public.transport_collection_journal(p_partner,p_date,'advance_offset',jsonb_build_array(jsonb_build_object('account_id',m.partner_payable_account_id,'debit',off_amount,'credit',0),jsonb_build_object('account_id',m.partner_advance_account_id,'debit',0,'credit',off_amount)),p_reference||' advance adjustment');
+    insert into public.transport_collection_financial_entries(company_id,business_unit_id,partner_id,kind,journal_entry_id,reference,created_by) values(c,b,p_partner,'advance_offset',off_j,p_reference,auth.uid());
+   end if;
+  elsif p_kind='partner_vat_received' and p_amount>(pos->>'vat_receivable')::numeric then raise exception 'VAT reimbursement exceeds recognized recoverable VAT';end if;
+  j:=public.transport_collection_journal(p_partner,p_date,p_kind,jsonb_build_array(jsonb_build_object('account_id',case when p_kind='partner_vat_received' then p_bank else case when p_kind='partner_transfer' then m.partner_payable_account_id else m.partner_advance_account_id end end,'debit',p_amount,'credit',0),jsonb_build_object('account_id',case when p_kind='partner_vat_received' then m.partner_vat_receivable_account_id else p_bank end,'debit',0,'credit',p_amount)),p_reference);
+  perform public.transport_collection_link_posted_cash_evidence(p_partner,p_kind,j,p_reference);
+ end if;
+ r:=jsonb_build_object('journal_entry_id',j,'advance_offset_journal_id',off_j,'kind',p_kind,'partner_id',p_partner,'position',public.transport_collection_position(p_partner));
+ insert into public.transport_collection_requests(company_id,business_unit_id,request_id,payload,result,created_by) values(c,b,p_request,payload,r,auth.uid());return r;
+end $$;
