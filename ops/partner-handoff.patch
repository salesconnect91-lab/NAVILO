+create function public.transport_collection_monthly_report(p_partner_id uuid,p_month date)
+returns jsonb language plpgsql stable security definer set search_path=public,pg_temp as $$
+declare c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();first_day date;next_month date;result jsonb;ledger jsonb;
+begin
+ if auth.uid() is null or c is null or b is null or p_month is null
+ or not public.has_module_permission(c,'transport','view') or not public.has_module_permission(c,'accounting','view')
+ or not exists(select 1 from public.transport_collection_settings where company_id=c and business_unit_id=b and enabled)
+ or not exists(select 1 from public.transport_collection_partners where id=p_partner_id and company_id=c and business_unit_id=b and is_active)
+ then raise exception 'Authorized partner and statement month required';end if;
+ first_day:=date_trunc('month',p_month)::date;next_month:=(first_day+interval '1 month')::date;
+ ledger:=public.transport_collection_partner_invoice_ledger(p_partner_id,null,next_month-1,'',1,0);
+ with invoice_events as (
+  select s.order_date date,'invoice'::text kind,sum(l.rate_snapshot+l.vat_snapshot) amount,sum(l.vat_snapshot) vat
+  from public.transport_customer_documents d
+  join public.sales_orders s on s.id=d.sales_order_id and s.company_id=c and s.business_unit_id=b and s.status='posted'
+  join public.transport_active_journals j on j.id=d.journal_entry_id
+  join public.transport_customer_document_trips l on l.document_id=d.id and l.company_id=c and l.business_unit_id=b
+  join public.transport_trips t on t.id=l.trip_id and t.company_id=c and t.business_unit_id=b
+  join public.transport_collection_settings cfg on cfg.company_id=c and cfg.business_unit_id=b
+  left join public.transport_collection_owner_aliases a on a.company_id=c and a.business_unit_id=b and a.owner_key=upper(regexp_replace(btrim(t.owner_name_snapshot),E'\\s+',' ','g'))
+  where d.company_id=c and d.business_unit_id=b and s.order_date<next_month
+  and btrim(coalesce(t.owner_name_snapshot,''))<>'' and coalesce(a.partner_id,cfg.default_partner_id)=p_partner_id
+  group by s.order_date
+ ), receipt_events as (
+  select a.allocation_date date,'customer_receipt'::text kind,sum(sh.amount) amount,0::numeric vat
+  from public.transport_collection_receipt_shares sh
+  join public.invoice_payment_allocations a on a.id=sh.receipt_allocation_id and a.company_id=c and a.business_unit_id=b
+  join public.sales_orders s on s.id=a.sales_order_id and s.company_id=c and s.business_unit_id=b and s.status='posted'
+  join public.transport_active_journals j on j.id=a.journal_entry_id
+  where sh.company_id=c and sh.business_unit_id=b and sh.partner_id=p_partner_id and a.allocation_date<next_month
+  group by a.allocation_date
+ ), cash_events as (
+  select j.entry_date date,e.kind,sum(e.amount) amount,0::numeric vat
+  from public.transport_collection_cash_evidence e join public.transport_active_journals j on j.id=e.journal_entry_id and j.company_id=c and j.business_unit_id=b
+  where e.company_id=c and e.business_unit_id=b and e.partner_id=p_partner_id and j.entry_date<next_month
+  group by j.entry_date,e.kind
+ ), events as (select * from invoice_events union all select * from receipt_events union all select * from cash_events),
+ changes as (
+  select date,case kind when 'invoice' then amount when 'customer_receipt' then -amount else 0 end receivable,
+  case kind when 'customer_receipt' then amount when 'partner_transfer' then -amount when 'partner_advance' then -amount else 0 end held,
+  case kind when 'invoice' then vat when 'partner_vat_received' then -amount else 0 end vat from events
