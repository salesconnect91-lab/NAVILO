+ 'opening',jsonb_build_object('receivable',coalesce(sum(receivable) filter(where date<first_day),0),'held',coalesce(sum(held) filter(where date<first_day),0),'vat',coalesce(sum(vat) filter(where date<first_day),0)),
+ 'movement',jsonb_build_object('receivable',coalesce(sum(receivable) filter(where date>=first_day),0),'held',coalesce(sum(held) filter(where date>=first_day),0),'vat',coalesce(sum(vat) filter(where date>=first_day),0)),
+ 'closing',jsonb_build_object('receivable',coalesce(sum(receivable),0),'held',coalesce(sum(held),0),'vat',coalesce(sum(vat),0)),
+ 'review_invoice_count',ledger->'review_invoice_count','close_enabled',false,
+ 'basis','Current canonical posting/reversal state; dated transaction movements, not a frozen historical closing',
+ 'review_reasons',jsonb_build_array('SIGNED_OPENING_NOT_CONFIRMED',case when (ledger->>'review_invoice_count')::int>0 then 'INVOICE_RECONCILIATION_REQUIRED' end)) into result from changes;
+ return result;
+end $$;
+revoke all on function public.transport_collection_monthly_report(uuid,date) from public,anon,authenticated;
+grant execute on function public.transport_collection_monthly_report(uuid,date) to authenticated;
