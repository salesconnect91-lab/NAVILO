+/**
+ * Twakkal-only optional Partner Collection & Settlement foundation.
+ * Stage 2 UI: Partner Master + verified Owner alias mapping + Sales evidence.
+ * It does not alter statutory AR, Sales, VAT, profit, posted receipts or GL.
+ * Sales snapshot is NOT partner collection/held balance until allocations reconcile.
+ */
+import {useCallback,useEffect,useMemo,useState} from 'react';
+import {useAuth} from '@/auth/AuthContext';
+import {supabase} from '@/lib/supabase';
+import {financialNumber} from './transportFinancialTypes';
+import {classifyOwner,ownerKey} from './partnerCollectionCore';
+import PartnerFinanceWorkflow from './PartnerFinanceWorkflow';
+import PartnerInvoiceLedger from './PartnerInvoiceLedger';
+import PartnerReceiptLinks from './PartnerReceiptLinks';
+import PartnerRunningStatement from './PartnerRunningStatement';
+import PartnerReceivableReview from './PartnerReceivableReview';
+
+type Partner={id:string;code:string;name:string;is_active:boolean};
+type Alias={id:string;owner_key:string;partner_id:string};
+type Summary={partner_id:string|null;partner_code:string;partner_name:string;trip_count:number;invoiced_trip_count:number;unbilled_trip_count:number;overlap_trip_count:number;invoice_net:number;invoice_vat:number;invoice_gross:number};
+
+export default function PartnerCollectionAccounts(){
+ const {activeCompany,activeBusinessUnit,isPlatformOwner}=useAuth();
+ const company=activeCompany?.company_id??'',businessUnit=activeBusinessUnit?.business_unit_id??'';
+ const role=activeBusinessUnit?.membership_role??activeCompany?.membership_role;
+ const canManage=isPlatformOwner||role==='company_owner'||role==='admin';
+ const [partners,setPartners]=useState<Partner[]>([]);
+ const [aliases,setAliases]=useState<Alias[]>([]);
+ const [summary,setSummary]=useState<Summary[]>([]);
+ const [defaultPartner,setDefaultPartner]=useState<string|null>(null);
+ const [newCode,setNewCode]=useState('');const [newName,setNewName]=useState('');
+ const [aliasReference,setAliasReference]=useState('');
+ const [ownerAlias,setOwnerAlias]=useState('');const [aliasPartner,setAliasPartner]=useState('');
+ const [from,setFrom]=useState('');const [to,setTo]=useState('');
+ const [loading,setLoading]=useState(true);const [busy,setBusy]=useState(false);const [error,setError]=useState('');const [notice,setNotice]=useState('');
+ const [enabled,setEnabled]=useState(false);
+ const [setupName,setSetupName]=useState('');
+ async function initialize(){
+  if(!canManage||busy||!setupName.trim())return;
+  setBusy(true);setError('');
+  try{const r=await supabase.rpc('transport_collection_initialize',{p_default_name:setupName.trim()});if(r.error)throw r.error;await load();}
+  catch(e){setError((e as Error).message??'Setup failed');}finally{setBusy(false);}
+ }
+ const load=useCallback(async()=>{
+  if(!company||!businessUnit){setEnabled(false);setLoading(false);return;}
+  setLoading(true);setError('');
+  try{
+   const settings=await supabase.from('transport_collection_settings')
+    .select('enabled,default_partner_id').eq('company_id',company).eq('business_unit_id',businessUnit).maybeSingle();
+   if(settings.error)throw settings.error;
+   if(!settings.data?.enabled){setEnabled(false);setPartners([]);setAliases([]);setSummary([]);return;}
+   setEnabled(true);setDefaultPartner(settings.data.default_partner_id);
+   const [p,a,s]=await Promise.all([
+    supabase.from('transport_collection_partners').select('id,code,name,is_active').eq('company_id',company).eq('business_unit_id',businessUnit).order('name'),
+    supabase.from('transport_collection_owner_aliases').select('id,owner_key,partner_id').eq('company_id',company).eq('business_unit_id',businessUnit).order('owner_key'),
+    supabase.rpc('transport_collection_sales_preview',{p_from:from||null,p_to:to||null})
+   ]);
+   if(p.error||a.error||s.error)throw p.error||a.error||s.error;
+   setPartners((p.data??[]) as Partner[]);setAliases((a.data??[]) as Alias[]);setSummary((s.data??[]) as Summary[]);
+  }catch(e){setEnabled(false);setError((e as {message?:string})?.message??'Could not load Partner Collections');}
+  finally{setLoading(false);}
+ },[company,businessUnit,from,to]);
+ useEffect(()=>{void load();},[load]);
+ const displayAliases=useMemo(()=>aliases.map(a=>({
+  ...a,partnerName:partners.find(p=>p.id===a.partner_id)?.name??'Unknown'
+ })),[aliases,partners]);
+ const classified=useMemo(()=>{
+  const rules=aliases.map(a=>({ownerAlias:a.owner_key,partnerId:a.partner_id}));
+  return ownerAlias.trim()?classifyOwner(ownerAlias,rules,defaultPartner):null;
+ },[ownerAlias,aliases,defaultPartner]);
+ const previewName=classified?.status==='assigned'?partners.find(p=>p.id===classified.partnerId)?.name??'Unknown':null;
+ async function addPartner(){
+  if(!canManage||busy||!newCode.trim()||!newName.trim())return;
+  setBusy(true);setError('');setNotice('');
+  try{
+   const r=await supabase.rpc('transport_collection_add_partner',{p_code:newCode.trim().toLowerCase(),p_name:newName.trim()});
+   if(r.error)throw r.error;
+   setNewCode('');setNewName('');setNotice('Partner registered. Existing Trip/Invoice history unchanged.');await load();
+  }catch(e){setError((e as {message?:string})?.message??'Unable to register partner');}
+  finally{setBusy(false);}
+ }
+ async function addAlias(){
+  if(!canManage||busy||!ownerAlias.trim()||!aliasPartner)return;
+  setBusy(true);setError('');setNotice('');
+  try{
+   const r=await supabase.rpc('transport_collection_map_verified_owner',{p_owner_key:ownerKey(ownerAlias),p_partner_id:aliasPartner,p_reference:aliasReference.trim()});
+   if(r.error)throw r.error;
+   setNotice('New exact Owner alias saved. Existing posted allocation remains unmodified.');
+   setOwnerAlias('');setAliasPartner('');setAliasReference('');await load();
+  }catch(e){setError((e as {message?:string})?.message??'Unable to map Owner');}
+  finally{setBusy(false);}
+ }
+ if(loading)return <section className="rounded border bg-white p-3 text-sm" role="status">Loading Partner Collections…</section>;
+ if(error&&!enabled)return <p role="alert" className="text-sm text-red-700">{error}</p>;
+ if(!enabled)return <section className="space-y-2 rounded border bg-white p-3 text-xs"><h2 className="font-bold">Partner Collection &amp; Settlement setup</h2><p>Initialize the partner master for this Transport workspace. Historical balances and accounting mappings require separate reconciliation.</p>{canManage&&<div className="flex gap-2"><input className="input h-8" aria-label="Default partner name" placeholder="Default partner name" value={setupName} onChange={e=>setSetupName(e.target.value)}/><button className="btn h-8" disabled={busy||!setupName.trim()} onClick={()=>void initialize()}>Initialize Partner Master</button></div>}</section>;
+ const money=(x:number)=>`SAR ${financialNumber(x)}`;
+ const grand=summary.reduce((o,r)=>({trips:o.trips+Number(r.trip_count||0),invoiced:o.invoiced+Number(r.invoice_gross||0),unbilled:o.unbilled+Number(r.unbilled_trip_count||0),overlap:o.overlap+Number(r.overlap_trip_count||0)}),{trips:0,invoiced:0,unbilled:0,overlap:0});
+ return <section className="space-y-3 rounded-lg border bg-white p-3 text-[12px]">
+  <div className="flex flex-wrap items-start justify-between gap-2">
+   <div><h2 className="text-base font-bold">Partner Collection &amp; Settlement</h2><p className="text-xs text-slate-600">Owner-based Trip classification. Read-only invoice evidence; no second Sales, AR, bank or VAT posting.</p></div>
+   <button className="btn" disabled={busy} onClick={()=>void load()}>Refresh</button>
+  </div>
+  <p className="rounded border border-amber-200 bg-amber-50 p-2 text-amber-900">Partner sales attribution preview: Trip/invoice amounts below are an attribution preview, NOT confirmed partner receivables or transferable cash. Overlapping imported and native invoices require review before settlement. Actual Received, customer outstanding, VAT reimbursements and partner payouts will only be released after canonical allocation reconciliation.</p>
+  {error&&<p role="alert" className="text-red-700">{error}</p>}{notice&&<p role="status" className="text-emerald-700">{notice}</p>}
+  <div className="flex flex-wrap items-end gap-2">
+   <label className="grid gap-1">Trip date from<input className="input h-8" type="date" value={from} onChange={e=>setFrom(e.target.value)}/></label>
+   <label className="grid gap-1">Trip date to<input className="input h-8" type="date" value={to} onChange={e=>setTo(e.target.value)}/></label>
+  </div>
+  {from&&to&&from>to?<p role="alert" className="text-red-700">From date cannot exceed To date.</p>:<div className="overflow-auto rounded border"><table className="w-full min-w-[740px] text-right text-xs"><thead className="bg-slate-50"><tr><th className="p-2 text-left">Partner</th><th className="p-2">Trips</th><th className="p-2">Invoiced Trips</th><th className="p-2">Unbilled Trips</th><th className="p-2">Source Overlap</th><th className="p-2">Invoice Net</th><th className="p-2">Invoice VAT</th><th className="p-2">Invoice Gross</th></tr></thead><tbody>{summary.map(r=><tr key={r.partner_id??'review_required'} className="border-t"><td className="p-2 text-left font-semibold">{r.partner_name}</td><td className="p-2">{r.trip_count}</td><td className="p-2">{r.invoiced_trip_count}</td><td className="p-2">{r.unbilled_trip_count}</td><td className="p-2">{r.overlap_trip_count}</td><td className="p-2">{money(r.invoice_net)}</td><td className="p-2">{money(r.invoice_vat)}</td><td className="p-2">{money(r.invoice_gross)}</td></tr>)}</tbody><tfoot className="bg-slate-100 font-semibold"><tr><td className="p-2 text-left">TOTAL</td><td className="p-2">{grand.trips}</td><td className="p-2"></td><td className="p-2">{grand.unbilled}</td><td className="p-2">{grand.overlap}</td><td colSpan={2}></td><td className="p-2">{money(grand.invoiced)}</td></tr></tfoot></table></div>}
+  <div className="grid gap-3 lg:grid-cols-2">
+   <div className="rounded border p-3"><h3 className="font-bold">Partner Master</h3>
+    <p className="mb-2 text-slate-600">Default for all other verified Owners: <strong>{partners.find(p=>p.id===defaultPartner)?.name??'Not configured'}</strong>. No Vehicle Number mapping.</p>
+    <table className="w-full text-left text-xs"><thead><tr><th>Name</th><th>Code</th><th>Status</th></tr></thead><tbody>{partners.map(p=><tr className="border-t" key={p.id}><td className="py-1">{p.name}</td><td>{p.code}</td><td>{p.is_active?'Active':'Inactive'}</td></tr>)}</tbody></table>
+    {canManage&&<div className="mt-3 flex flex-wrap gap-2"><input aria-label="New partner code" placeholder="Partner code" className="input h-8 w-28" value={newCode} onChange={e=>setNewCode(e.target.value)}/><input aria-label="New partner name" placeholder="Partner name" className="input h-8 w-40" value={newName} onChange={e=>setNewName(e.target.value)}/><button className="btn" disabled={busy||!newCode||!newName} onClick={()=>void addPartner()}>Add Partner</button></div>}
+   </div>
+   <div className="rounded border p-3"><h3 className="font-bold">Owner Mapping</h3>
+    <p className="mb-2 text-slate-600">Exact Owner names only. A supplier like SAJID WINCH stays under Twakkal unless explicitly mapped.</p>
+    <div className="max-h-40 overflow-auto"><table className="w-full text-left text-xs"><thead><tr><th>Saved Owner</th><th>Partner</th></tr></thead><tbody>{displayAliases.map(a=><tr key={a.id} className="border-t"><td className="py-1">{a.owner_key}</td><td>{a.partnerName}</td></tr>)}</tbody></table></div>
+    {canManage&&<div className="mt-3 flex flex-wrap gap-2"><input aria-label="New exact Owner name" placeholder="Owner name" className="input h-8 min-w-40" value={ownerAlias} onChange={e=>setOwnerAlias(e.target.value)}/><select aria-label="Owner partner" className="input h-8" value={aliasPartner} onChange={e=>setAliasPartner(e.target.value)}><option value="">Select partner</option>{partners.filter(p=>p.is_active).map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</select><input aria-label="Owner mapping evidence reference" className="input h-8 w-48" placeholder="Reconciliation reference" maxLength={160} value={aliasReference} onChange={e=>setAliasReference(e.target.value)}/><button className="btn" disabled={busy||!ownerAlias||!aliasPartner||aliasReference.trim().length<6} onClick={()=>void addAlias()}>Map Verified Owner</button></div>}
+    {ownerAlias&&<p className="mt-2">Preview: <strong>{previewName??'Needs review'}</strong>{classified?.status==='assigned'&&` (${classified.source})`}</p>}
+   </div>
+  </div>
+  <PartnerFinanceWorkflow partners={partners} defaultPartner={defaultPartner}/>
+  <PartnerRunningStatement partners={partners}/>
+  <PartnerInvoiceLedger partners={partners}/>
+  <PartnerReceiptLinks/>
+  <PartnerReceivableReview/>
+  <p className="text-xs text-slate-500">Partner posting requires approved GL mapping, verified openings and canonical source reconciliation. Profit Distribution remains separate.</p>
+ </section>;
+}
