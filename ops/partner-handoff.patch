+create function public.transport_collection_position(p_partner uuid,p_as_of date default current_date) returns jsonb language plpgsql stable security definer set search_path=public,pg_temp as $$
+declare c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();m public.transport_collection_finance_mapping%rowtype;o public.transport_collection_openings%rowtype;r jsonb;begin
+ perform public.transport_collection_assert('view');
+ select * into strict m from public.transport_collection_finance_mapping where company_id=c and business_unit_id=b and is_approved;
+ select * into strict o from public.transport_collection_openings where partner_id=p_partner and company_id=c and business_unit_id=b;
+ if p_as_of is null or p_as_of<o.cutover_date then raise exception 'Position date before confirmed cutover';end if;
+ if o.proof_journal_id is not null and not exists(select 1 from public.transport_active_journals where id=o.proof_journal_id) then raise exception 'Opening GL proof reversed; reconciliation required';end if;
+ with ids as (
+ select journal_entry_id id from public.transport_collection_financial_entries where partner_id=p_partner and company_id=c and business_unit_id=b
+ union select e.journal_entry_id from public.transport_collection_cash_evidence e join public.journal_entries j on j.id=e.journal_entry_id where e.partner_id=p_partner and e.company_id=c and e.business_unit_id=b and j.entry_date>=o.cutover_date
+ ),amounts as (
+ select coalesce(sum(l.credit-l.debit) filter(where l.account_id=m.partner_payable_account_id),0) payable,coalesce(sum(l.debit-l.credit) filter(where l.account_id=m.partner_advance_account_id),0) advance,coalesce(sum(l.debit-l.credit) filter(where l.account_id=m.partner_vat_receivable_account_id),0) vat from ids join public.transport_active_journals j on j.id=ids.id join public.journal_lines l on l.entry_id=j.id where j.company_id=c and j.business_unit_id=b and j.entry_date<=p_as_of
+ ),cash as (
+ select o.payable-o.customer_receivable-o.advance + coalesce((select sum(sh.amount) from public.transport_collection_receipt_shares sh join public.invoice_payment_allocations a on a.id=sh.receipt_allocation_id join public.transport_active_journals j on j.id=a.journal_entry_id where sh.company_id=c and sh.business_unit_id=b and sh.partner_id=p_partner and a.allocation_date>=o.cutover_date and a.allocation_date<=p_as_of),0) - coalesce((select sum(e.amount) from public.transport_collection_cash_evidence e join public.transport_active_journals j on j.id=e.journal_entry_id where e.company_id=c and e.business_unit_id=b and e.partner_id=p_partner and j.entry_date>=o.cutover_date and j.entry_date<=p_as_of and e.kind in('partner_transfer','partner_advance')),0) held
+ ) select jsonb_build_object('payable',o.payable+a.payable,'advance',o.advance+a.advance,'vat_receivable',o.vat_receivable+a.vat,'held',cash.held,'cutover_date',o.cutover_date) into r from amounts a cross join cash;
+ return r;
+end $$;
