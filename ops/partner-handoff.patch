+create function public.transport_collection_month_action(p_partner uuid,p_month date,p_action text,p_reference text) returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();m date;last_kind text;r jsonb;ledger jsonb;begin
+ perform public.transport_collection_assert('post',true);
+ perform pg_advisory_xact_lock(hashtextextended('partner-owner-map:'||c::text||':'||b::text,0));
+ m:=date_trunc('month',p_month)::date;
+ if p_month is null or m>date_trunc('month',current_date)::date or p_action not in('close','reopen') or length(btrim(coalesce(p_reference,''))) not between 8 and 160 then raise exception 'Month action and evidence reference required';end if;
+ perform pg_advisory_xact_lock(hashtextextended('partner:'||c::text||':'||b::text||':'||p_partner::text,0));
+ select kind into last_kind from public.transport_collection_month_events where company_id=c and business_unit_id=b and partner_id=p_partner and month=m order by created_at desc,id desc limit 1;
+ if p_action=last_kind or (p_action='reopen' and last_kind is distinct from 'close') then raise exception 'Month already in requested state or has not been closed';end if;
+ if p_action='close' then
+  if (m+interval '1 month')::date>current_date then raise exception 'Close only completed calendar months';end if;
+  ledger:=public.transport_collection_partner_invoice_ledger(p_partner,null,(m+interval '1 month - 1 day')::date,'',1,0);
