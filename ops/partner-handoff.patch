@@ -0,0 +1,27 @@
+import {useEffect,useRef,useState} from 'react';
+import {supabase} from '@/lib/supabase';
+type Balance={receivable:number;held:number;vat:number};
+type Report={month:string;opening:Balance;movement:Balance;closing:Balance;review_invoice_count:number;basis:string;opening_confirmed?:boolean;closed_snapshot?:boolean;source_changed_since_close?:boolean;close_enabled?:boolean};
+export default function PartnerMonthlyReport({partnerId}:{partnerId:string}){
+ const [month,setMonth]=useState(()=>new Date().toISOString().slice(0,7)),[report,setReport]=useState<Report|null>(null),[error,setError]=useState(''),[loading,setLoading]=useState(false);
+ const sequence=useRef(0);const [refresh,setRefresh]=useState(0);
+ useEffect(()=>{const changed=()=>setRefresh(x=>x+1);window.addEventListener('navilo:partner-change',changed);return()=>window.removeEventListener('navilo:partner-change',changed);},[]);
+ useEffect(()=>{
+  const token=++sequence.current;setReport(null);setError('');
+  if(!partnerId||!/^\d{4}-\d{2}$/.test(month)){setLoading(false);return;}
+  setLoading(true);
+  void (async()=>{try{
+   const r=await supabase.rpc('transport_collection_monthly_report',{p_partner_id:partnerId,p_month:month+'-01'});
+   if(r.error)throw r.error;if(token===sequence.current)setReport(r.data as Report);
+  }catch(e){if(token===sequence.current)setError((e as Error).message||'Monthly report unavailable');}
+  finally{if(token===sequence.current)setLoading(false);}})();
+  return()=>{sequence.current++;};
+ },[partnerId,month,refresh]);
+ const money=(x:number)=>Number(x).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
+ return <section className="space-y-2 rounded border p-2 text-xs" aria-label="Partner monthly report">
+  <h4 className="font-bold">Monthly Partner Statement · SAR</h4>
+  <label className="flex items-center gap-2">Statement month<input aria-label="Statement month" type="month" className="input h-8" value={month} onChange={e=>setMonth(e.target.value)}/></label>
+  {loading&&<p role="status">Loading monthly statement…</p>}{error&&<p role="alert" className="text-red-700">{error}</p>}
+  {report&&<><table className="w-full text-right"><thead><tr><th className="text-left">Balance</th><th>Opening</th><th>Movement</th><th>Closing</th></tr></thead><tbody>{([['receivable','Customer receivable'],['held','Collection held / advance'],['vat','VAT reimbursement outstanding']] as const).map(([key,label])=><tr key={key} className="border-t"><th className="py-1 text-left font-normal">{label}</th><td>{money(report.opening[key])}</td><td>{money(report.movement[key])}</td><td>{money(report.closing[key])}</td></tr>)}</tbody></table><p className="text-slate-600">{report.basis}.</p><p className="rounded bg-amber-50 p-2 text-amber-900">{report.closed_snapshot?'Closed monthly snapshot.':report.opening_confirmed?'Opening confirmed; complete source recognition and reconciliation before close.':'Monthly close remains blocked pending signed opening reconciliation.'} Invoices requiring review: {report.review_invoice_count}. Amounts include attributed source movements and require reconciliation before settlement.</p>{report.source_changed_since_close&&<p role="alert" className="text-red-700">Canonical source changed after this close. Reopen and reconcile; the saved closing remains preserved.</p>}</>}
+ </section>;
+}
diff --git a/src/modules/transport/PartnerReceiptLinks.tsx b/src/modules/transport/PartnerReceiptLinks.tsx
