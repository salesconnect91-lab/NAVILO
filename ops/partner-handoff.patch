+   <div className="rounded bg-slate-50 p-2"><div className="text-slate-600">Already received · SAR</div><b>{money(review.posted_allocated)}</b></div>
+   <div className="rounded bg-slate-50 p-2"><div className="text-slate-600">Customer outstanding · SAR</div><b>{money(assessment.remainingHalalas/100)}</b></div>
+   <div className="rounded bg-slate-50 p-2"><div className="text-slate-600">Source conflicts / partners</div><b>{review.opening_conflict_count} / {review.partner_count}</b></div>
+  </div>
+  {(review.historical_customer_received>0||review.opening_settled_document_count>0)&&<p className="rounded bg-slate-50 p-2 text-slate-700">Previous customer collection evidence: SAR {money(review.historical_customer_received)} · Opening invoices with settlement evidence: {review.opening_settled_document_count}. Never add these amounts to posted receipts without matching their source.</p>}
