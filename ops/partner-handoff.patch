+     <option value="">Select invoice</option>
+     {choices.map(x=><option key={x.invoice_id} value={x.invoice_id}>{x.invoice_no} · {money(x.gross)} · {x.status}</option>)}
+    </select></label></div>
+  {busy&&<p role="status">Checking posted invoice and receipt evidence…</p>}
