diff --git a/supabase/tests/partner_native_concurrency.mjs b/supabase/tests/partner_native_concurrency.mjs
new file mode 100644
index 00000000..306018ad
--- /dev/null
+++ b/supabase/tests/partner_native_concurrency.mjs
@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict';
+import {randomUUID} from 'node:crypto';
+export async function runPartnerConcurrency(db,Client){
+ const found=await db.query("select c.id company_id,b.id business_unit_id,cm.user_id,p.id partner_id,(select account_id from account_mappings where company_id=c.id and mapping_key='cash') bank_id from companies c join business_units b on b.company_id=c.id and b.is_default join company_memberships cm on cm.company_id=c.id and cm.role='company_owner' join transport_collection_partners p on p.company_id=c.id and p.business_unit_id=b.id and p.code='partner2' where c.name='Service rehearsal'");
+ assert.equal(found.rows.length,1,'Synthetic Partner fixture required');const f=found.rows[0];
+ await db.query("update business_unit_memberships set permissions='{}' where business_unit_id=$1 and user_id=$2",[f.business_unit_id,f.user_id]);
+ const connect=async()=>{const x=new Client({host:'127.0.0.1',port:6543,user:'postgres',password:'navilo-rehearsal-only',database:'navilo_transport_rehearsal'});await x.connect();await x.query("select set_config('request.jwt.claim.sub',$1,false)",[f.user_id]);await x.query('set role authenticated');return x;};
+ const a=await connect(),b=await connect();
+ try{
+  const current=await a.query('select transport_collection_position($1) position',[f.partner_id]);const held=Number(current.rows[0].position.held);assert(held>=3,'Fixture must retain enough collected cash');
+  const date=(await a.query('select current_date::text d')).rows[0].d;
+  const post=(client,request,amount,ref)=>client.query("select transport_collection_post($1,$2,'partner_transfer',$3,$4,$5,null,$6) result",[request,f.partner_id,date,amount,f.bank_id,ref]);
+  const same=randomUUID();const retry=await Promise.all([post(a,same,held,'NATIVE-SAME-REQUEST'),post(b,same,held,'NATIVE-SAME-REQUEST')]);
+  assert.equal(retry[0].rows[0].result.journal_entry_id,retry[1].rows[0].result.journal_entry_id,'Concurrent retry duplicated posting');
+  const original=retry[0].rows[0].result.journal_entry_id;
+  await a.query('select transport_collection_reverse($1,$2,$3,$4)',[randomUUID(),original,date,'NATIVE-RESTORE-FIXTURE']);
+  const amount=Math.ceil(held*75)/100;
+  const payout=await Promise.allSettled([post(a,randomUUID(),amount,'NATIVE-CAPACITY-A'),post(b,randomUUID(),amount,'NATIVE-CAPACITY-B')]);
+  assert.equal(payout.filter(x=>x.status==='fulfilled').length,1,'Concurrent payout exceeded capacity or both valid attempts failed');
+  const failure=payout.find(x=>x.status==='rejected');assert.match(failure.reason.message,/Insufficient verified collection|Advance adjustment/);
+  const paid=payout.find(x=>x.status==='fulfilled').value.rows[0].result.journal_entry_id;
+  const reversal=await Promise.allSettled([a.query('select transport_collection_reverse($1,$2,$3,$4)',[randomUUID(),paid,date,'NATIVE-REVERSAL-A']),b.query('select transport_collection_reverse($1,$2,$3,$4)',[randomUUID(),paid,date,'NATIVE-REVERSAL-B'])]);
+  assert.equal(reversal.filter(x=>x.status==='fulfilled').length,1,'Concurrent reversal duplicated or both attempts failed');
+  const ending=(await a.query('select transport_collection_position($1) position',[f.partner_id])).rows[0].position;assert.equal(Number(ending.held),held);
+  console.log('PASS native Partner concurrency: same request, capacity competition and double reversal');
+ }finally{await Promise.all([a.end(),b.end()]);}
+}
