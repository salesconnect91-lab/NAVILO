+   onKeyDown={e=>{if(e.key==='Enter')void findInvoices();}} placeholder="Search posted or draft invoices"/></label>
+   <button className="btn h-8" disabled={busy} onClick={()=>void findInvoices()}>Search invoices</button>
+   <label className="grid gap-1">Invoice
