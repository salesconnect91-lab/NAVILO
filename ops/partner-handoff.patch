+++ b/src/modules/transport/partnerSettlementUtils.ts
@@ -0,0 +1,96 @@
+/**
+ * Read-only partner settlement decision support.
+ * Nothing here authorizes or executes cash, bank, VAT, AR/AP or GL postings.
+ * Currency: SAR, represented internally in exact integer halalas.
+ */
+export type SettlementKind='partner_transfer'|'partner_advance'|'partner_vat_received';
+export type StatementSnapshot={
+ partner_id:string;
+ verified_received:number|string;
+ verified_customer_outstanding:number|string;
+ cash_held_before_vat_reimbursement:number|string;
+ partner_vat_balance:number|string;
+ partner_advances_paid:number|string;
+ partner_transfers_paid:number|string;
+ review_required:boolean;
+ review_invoice_count:number;
+ payout_enabled:boolean;
+ review_reasons:(string|null)[];
+};
+export type SettlementPreview={
+ kind:SettlementKind; amountHalalas:number;
+ requestedSar:string; customerOutstandingSar:string;
+ cashHeldBeforeSar:string; cashHeldAfterSar:string;
+ vatDueBeforeSar:string; vatDueAfterSar:string;
+ transferredBeforeSar:string; transferredAfterSar:string;
+ advancedBeforeSar:string; advancedAfterSar:string;
+ balanceSufficient:boolean;
+ reviewRequired:boolean; flags:string[];
+ canPost:boolean;
+};
+
+/** Avoid float-based arithmetic even when PostgreSQL numeric arrives as JS number. */
+export function parseSarHalalas(value:number|string,{allowNegative=false}:{allowNegative?:boolean}={}):number {
+ const raw=typeof value==='number'?String(value):value.trim();
+ if(!/^-?(?:0|[1-9]\d*)(?:\.\d{1,2})?$/.test(raw))throw new Error('Invalid SAR amount: use at most two decimals');
+ const negative=raw.startsWith('-');
+ if(negative&&!allowNegative)throw new Error('Amount cannot be negative');
+ const digits=negative?raw.slice(1):raw;
+ const [whole,fraction='']=digits.split('.');
+ const n=Number(whole)*100+Number(fraction.padEnd(2,'0'));
+ if(!Number.isSafeInteger(n))throw new Error('SAR amount exceeds safe precision');
+ return negative?-n:n;
+}
+export function sarString(halalas:number):string {
+ if(!Number.isSafeInteger(halalas))throw new Error('Money amount is not an integer');
+ return (halalas<0?'-':'')+Math.floor(Math.abs(halalas)/100).toString()+'.'+String(Math.abs(halalas)%100).padStart(2,'0');
+}
+function safeAdd(a:number,b:number):number {
+ const r=a+b;
+ if(!Number.isSafeInteger(r))throw new Error('Settlement preview amount overflow');
+ return r;
+}
+export function previewPartnerSettlement(input:{statement:StatementSnapshot;kind:SettlementKind;amountSar:string}):SettlementPreview {
+ const {statement:s,kind}=input;
+ if(!s.partner_id?.trim())throw new Error('Partner is required');
+ if(!['partner_transfer','partner_advance','partner_vat_received'].includes(kind))throw new Error('Invalid settlement movement');
+ const amount=parseSarHalalas(input.amountSar);
+ if(amount<=0)throw new Error('Amount must be greater than zero');
+ const held=parseSarHalalas(s.cash_held_before_vat_reimbursement,{allowNegative:true});
+ const vat=parseSarHalalas(s.partner_vat_balance,{allowNegative:true});
+ const advance=parseSarHalalas(s.partner_advances_paid);
+ const transferred=parseSarHalalas(s.partner_transfers_paid);
+ const outstanding=parseSarHalalas(s.verified_customer_outstanding,{allowNegative:true});
+ const reasons=new Set<string>();
+ if(s.review_required||s.review_invoice_count>0)reasons.add('SOURCE_RECONCILIATION_PENDING');
+ for(const reason of s.review_reasons??[]){if(reason?.trim())reasons.add(reason.trim());}
+ if(held<0)reasons.add('UNRECOVERED_PARTNER_ADVANCE');
+ if(vat<0)reasons.add('VAT_REIMBURSEMENT_CREDIT_REVIEW');
+ let cashHeldAfter=held,vatAfter=vat,advanceAfter=advance,transferAfter=transferred;
+ if(kind==='partner_transfer'){
+  if(amount>Math.max(0,held))reasons.add('INSUFFICIENT_CONFIRMED_COLLECTION');
+  cashHeldAfter=safeAdd(held,-amount);
+  transferAfter=safeAdd(transferred,amount);
+ }else if(kind==='partner_advance'){
+  cashHeldAfter=safeAdd(held,-amount);
+  advanceAfter=safeAdd(advance,amount);
+  reasons.add('ADVANCE_REQUIRES_SEPARATE_APPROVAL');
+ }else{
+  vatAfter=safeAdd(vat,-amount);
+  if(vat<=0||amount>vat)reasons.add('VAT_OVER_RECOVERY_REVIEW');
+  // VAT recovery is not a customer receipt, and cannot increase partner-held cash.
+ }
+ // This is only an analytical preview; Stage 6 deliberately has no payout/GL posting API.
+ reasons.add('POSTING_NOT_ENABLED');
+ if(!s.payout_enabled)reasons.add('PARTNER_PAYOUT_DISABLED');
+ const flags=[...reasons].sort();
+ return {
+  kind,amountHalalas:amount,requestedSar:sarString(amount),customerOutstandingSar:sarString(outstanding),
+  cashHeldBeforeSar:sarString(held),cashHeldAfterSar:sarString(cashHeldAfter),
+  vatDueBeforeSar:sarString(vat),vatDueAfterSar:sarString(vatAfter),
+  transferredBeforeSar:sarString(transferred),transferredAfterSar:sarString(transferAfter),
+  advancedBeforeSar:sarString(advance),advancedAfterSar:sarString(advanceAfter),
+  balanceSufficient:kind==='partner_vat_received'?vat>=amount:held>=amount,
+  reviewRequired:flags.length>0,flags,canPost:false
+ };
+}
