+create function public.transport_collection_reverse(p_request uuid,p_journal uuid,p_date date,p_reason text) returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();p uuid;src public.journal_entries%rowtype;j uuid;lines jsonb;prior public.transport_collection_requests%rowtype;payload jsonb;r jsonb;begin
+ perform public.transport_collection_assert('post',true);
+ if p_request is null or p_date is null or p_date>current_date or length(btrim(coalesce(p_reason,''))) not between 8 and 160 then raise exception 'Reversal request, date and reason required';end if;
+ perform pg_advisory_xact_lock(hashtextextended('partner-request:'||c::text||':'||b::text||':'||p_request::text,0));
+ payload:=jsonb_build_object('reverse',p_journal,'date',p_date,'reason',btrim(p_reason));select * into prior from public.transport_collection_requests where company_id=c and business_unit_id=b and request_id=p_request;
+ if found then if prior.payload<>payload then raise exception 'Idempotency payload mismatch';end if;return prior.result;end if;
+ select * into src from public.journal_entries where id=p_journal and company_id=c and business_unit_id=b and source_document_type like 'partner_collection_%' and status='posted' and reversal_of_entry_id is null;
+ if not found or src.source_document_id is null then raise exception 'Canonical Partner Collection journal required';end if;p:=src.source_document_id;
+ perform pg_advisory_xact_lock(hashtextextended('partner:'||c::text||':'||b::text||':'||p::text,0));
+ if p_date<src.entry_date or exists(select 1 from public.journal_entries where reversal_of_entry_id=p_journal and status='posted') then raise exception 'Already reversed or invalid reversal date';end if;
+ if (select kind from public.transport_collection_month_events where company_id=c and business_unit_id=b and partner_id=p and month=date_trunc('month',p_date)::date order by created_at desc,id desc limit 1)='close' then raise exception 'Reversal month closed';end if;
+ if src.source_document_type='partner_collection_partner_advance' and (public.transport_collection_position(p)->>'advance')::numeric<(select sum(debit) from public.journal_lines where entry_id=p_journal and account_id=(select partner_advance_account_id from public.transport_collection_finance_mapping where company_id=c and business_unit_id=b)) then raise exception 'Reverse dependent advance offsets first';end if;
+ if src.source_document_type='partner_collection_invoice_recognition' and (exists(select 1 from public.transport_collection_financial_entries e join public.transport_active_journals j0 on j0.id=e.journal_entry_id where e.partner_id=p and e.kind='advance_offset') or exists(select 1 from public.transport_collection_cash_evidence e join public.transport_active_journals j0 on j0.id=e.journal_entry_id where e.partner_id=p and e.kind in('partner_transfer','partner_vat_received'))) then raise exception 'Reverse dependent partner payments/VAT evidence before recognition';end if;
+ select jsonb_agg(jsonb_build_object('account_id',account_id,'debit',credit,'credit',debit)) into lines from public.journal_lines where entry_id=p_journal;
+ j:=public.transport_collection_journal(p,p_date,'reversal',lines,p_reason,p_journal);
+ r:=jsonb_build_object('reversal_entry_id',j,'original_entry_id',p_journal);
+ insert into public.transport_collection_requests(company_id,business_unit_id,request_id,payload,result,created_by) values(c,b,p_request,payload,r,auth.uid());return r;
+end $$;
