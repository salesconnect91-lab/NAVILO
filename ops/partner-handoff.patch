+-- Internal canonical journal constructor. Not callable by application roles.
+create function public.transport_collection_journal(p_partner uuid,p_date date,p_kind text,p_lines jsonb,p_reference text,p_reversal uuid default null) returns uuid language plpgsql security definer set search_path=public,pg_temp as $$
+declare c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();loc uuid:=public.current_operating_location_id();u uuid:=public.legacy_data_user_id();j uuid:=gen_random_uuid();n text;begin
+ if loc is null then raise exception 'Active operating location required';end if;
+ n:=public.next_document_number('manual_journal','PC-');
+ insert into public.journal_entries(id,user_id,company_id,business_unit_id,operating_location_id,entry_no,entry_date,description,status,trans_type,currency_code,exchange_rate,party_name,source_module,source_document_type,source_document_id,created_by,reversal_of_entry_id,reversal_reason)
+ select j,u,c,b,loc,n,p_date,p_reference,'draft','Partner Collection','SAR',1,p.name,'transport','partner_collection_'||p_kind,p_partner,auth.uid(),p_reversal,case when p_reversal is not null then p_reference end from public.transport_collection_partners p where p.id=p_partner and p.company_id=c and p.business_unit_id=b;
+ insert into public.journal_lines(user_id,company_id,business_unit_id,operating_location_id,entry_id,account_id,account,debit,credit,base_debit,base_credit,party_name)
+ select u,c,b,loc,j,a.id,a.code||' - '||a.name,x.debit,x.credit,x.debit,x.credit,p.name from jsonb_to_recordset(p_lines) x(account_id uuid,debit numeric,credit numeric) join public.chart_of_accounts a on a.id=x.account_id and a.company_id=c join public.transport_collection_partners p on p.id=p_partner where x.debit+x.credit>0;
+ perform public.post_journal_entry(j);return j;
+end $$;
