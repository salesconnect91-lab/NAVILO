+/** Stage 7 preview ONLY. This panel deliberately has no submit or payment action. */
+import {useMemo,useState} from 'react';
+import {previewPartnerSettlement,type SettlementKind,type StatementSnapshot} from './partnerSettlementUtils';
+const movements=[
+ {value:'partner_transfer',label:'Transfer partner collected cash'},
+ {value:'partner_advance',label:'Partner advance payment'},
+ {value:'partner_vat_received',label:'Partner VAT reimbursement received'}
+] as const;
+export default function PartnerSettlementPreview({statement}:{statement:StatementSnapshot}){
+ const [kind,setKind]=useState<SettlementKind>('partner_transfer');
+ const [amount,setAmount]=useState('');
+ const evaluation=useMemo(()=>{
+  if(!amount.trim())return null;
+  try{return {data:previewPartnerSettlement({statement,kind,amountSar:amount}),error:''};}
+  catch(e){return {data:null,error:e instanceof Error?e.message:'Invalid preview'};}
+ },[statement,kind,amount]);
+ return <section className="rounded border border-slate-200 bg-white p-3 space-y-2 text-xs" aria-label="Partner settlement preview">
+  <div><h4 className="font-bold text-sm">Partner Settlement &amp; VAT — Preview Only</h4>
+   <p className="text-slate-600">See what a proposed partner transfer, advance or VAT recovery would do. No bank, VAT, journal, receipt, or ledger posting occurs here.</p></div>
+  <div className="flex flex-wrap gap-2 items-end">
+   <label className="grid gap-1">Movement<select className="input h-8" value={kind} onChange={e=>{setKind(e.target.value as SettlementKind);setAmount('');}}>{movements.map(m=><option key={m.value} value={m.value}>{m.label}</option>)}</select></label>
+   <label className="grid gap-1">Amount (SAR)<input className="input h-8 w-36" aria-label="Preview amount in SAR" inputMode="decimal" placeholder="0.00" value={amount} onChange={e=>setAmount(e.target.value)}/></label>
+  </div>
+  {evaluation?.error&&<p role="alert" className="text-red-700">{evaluation.error}</p>}
+  {evaluation?.data&&<>
+   <div className="grid grid-cols-2 gap-2 sm:grid-cols-4">
+    <div className="rounded bg-slate-50 p-2"><span>Proposed amount</span><p className="font-semibold tabular-nums">SAR {evaluation.data.requestedSar}</p></div>
+    <div className="rounded bg-slate-50 p-2"><span>Collection held before</span><p className="font-semibold tabular-nums">SAR {evaluation.data.cashHeldBeforeSar}</p></div>
+    <div className="rounded bg-slate-50 p-2"><span>Collection held after</span><p className="font-semibold tabular-nums">SAR {evaluation.data.cashHeldAfterSar}</p></div>
+    <div className="rounded bg-slate-50 p-2"><span>VAT recovery outstanding after</span><p className="font-semibold tabular-nums">SAR {evaluation.data.vatDueAfterSar}</p></div>
+   </div>
+   <p className="rounded border border-amber-200 bg-amber-50 p-2 text-amber-900" role="status">NOT POSTABLE — {evaluation.data.flags.join(' · ')}. Amounts above are hypothetical; actual payment needs approved GL mapping, verified source balances and separate authorization.</p>
+  </>}
+  {!evaluation&&<p className="text-slate-500">Enter a proposed amount to inspect its impact. No payment button is available.</p>}
+ </section>;
+}
