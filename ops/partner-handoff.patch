+create function public.transport_collection_confirm_opening(p_partner uuid,p_cutover date,p_receivable numeric,p_payable numeric,p_advance numeric,p_vat numeric,p_proof uuid,p_reference text) returns void language plpgsql security definer set search_path=public,pg_temp as $$
+declare c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();m public.transport_collection_finance_mapping%rowtype;begin
+ perform public.transport_collection_assert('edit',true);
+ perform pg_advisory_xact_lock(hashtextextended('partner:'||c::text||':'||b::text||':'||p_partner::text,0));
+ if p_cutover is null or p_cutover>current_date or length(btrim(coalesce(p_reference,''))) not between 8 and 160 or p_receivable is null or p_payable is null or p_advance is null or p_vat is null or least(p_receivable,p_payable,p_advance,p_vat)<0 or p_receivable<>round(p_receivable,2) or p_payable<>round(p_payable,2) or p_advance<>round(p_advance,2) or p_vat<>round(p_vat,2) then raise exception 'Signed cutover balances with two decimals and reference required';end if;
+ if not exists(select 1 from public.transport_collection_partners where id=p_partner and company_id=c and business_unit_id=b and is_active) then raise exception 'Partner outside workspace';end if;
+ select * into strict m from public.transport_collection_finance_mapping where company_id=c and business_unit_id=b and is_approved;
+ if p_payable+p_advance+p_vat>0 then
+  if not exists(select 1 from public.transport_active_journals j join public.transport_collection_partners p on p.id=p_partner where j.id=p_proof and j.company_id=c and j.business_unit_id=b and j.currency_code='SAR' and j.entry_date<=p_cutover and j.party_name=p.name) or exists(select 1 from public.transport_collection_cash_evidence where journal_entry_id=p_proof) or exists(select 1 from public.transport_collection_financial_entries where journal_entry_id=p_proof) then raise exception 'Existing posted partner-named SAR opening proof required; no new opening journal is created';end if;
+  if (select coalesce(sum(credit-debit),0) from public.journal_lines where entry_id=p_proof and account_id=m.partner_payable_account_id)<>p_payable or (select coalesce(sum(debit-credit),0) from public.journal_lines where entry_id=p_proof and account_id=m.partner_advance_account_id)<>p_advance or (select coalesce(sum(debit-credit),0) from public.journal_lines where entry_id=p_proof and account_id=m.partner_vat_receivable_account_id)<>p_vat then raise exception 'Signed opening differs from canonical GL proof';end if;
+ elsif p_proof is not null then raise exception 'Zero-opening confirmation must not attach unrelated GL proof';end if;
+ insert into public.transport_collection_openings(partner_id,company_id,business_unit_id,cutover_date,customer_receivable,payable,advance,vat_receivable,proof_journal_id,reference,confirmed_by) values(p_partner,c,b,p_cutover,p_receivable,p_payable,p_advance,p_vat,p_proof,p_reference,auth.uid());
+end $$;
