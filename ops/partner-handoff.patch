+/** Stage 5: canonical POSTED receipt → immutable analytical partner attribution.
+ * Never posts another receipt, bank entry, GL, AR or VAT. Server RPC revalidates all amounts.
+ */
+import {useCallback,useEffect,useMemo,useRef,useState} from 'react';
+import {supabase} from '@/lib/supabase';
+import {formatNaviloDate} from '@/lib/naviloDate';
+import {assessPostedReceipt,calculatePostedReceiptSplit,makeReceiptLinkRequest,type PostedReceipt,type ReceiptPartner} from './partnerReceiptLink';
+import {halalasToSar,type PaymentShare} from './partnerCollectionCore';
+
+type ReceiptRow={receipt_allocation_id:string;sales_order_id:string;invoice_no:string;allocation_date:string;
+ amount:number;reference:string|null;journal_status:string;linked_partner_count:number;linked_amount:number};
+type Evidence={receipt:{receipt_allocation_id:string;sales_order_id:string;invoice_no:string;amount:number;
+   reference:string|null;allocation_date:string;invoice_total:number;paid_amount:number;invoice_status:string;
+   journal_status:string;currency_code:string|null;reversed:boolean}|null;
+ partners:Array<{partner_id:string|null;partner_name:string;gross:number;previously_linked:number;capacity:number}>;
+ source_trip_gross:number;has_adjustment:boolean;prior_unlinked_count:number;
+ canonical_invoice_allocation_total:number;saved_shares:Array<{partner_id:string;amount:number;evidence_reference:string}>};
+const fmt=(n:number|undefined|null)=>Number(n??0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
+const parseSar=(raw:string):number|null=>/^(0|[1-9]\d*)(?:\.\d{1,2})?$/.test(raw.trim())?Number(raw):null;
+
+export default function PartnerReceiptLinks(){
+ const [search,setSearch]=useState('');const [submittedSearch,setSubmittedSearch]=useState('');
+ const [receipts,setReceipts]=useState<ReceiptRow[]>([]);const [selected,setSelected]=useState('');
+ const [evidence,setEvidence]=useState<Evidence|null>(null);
+ const [method,setMethod]=useState<'auto'|'manual'>('auto');
+ const [manual,setManual]=useState<Record<string,string>>({});const [sourceRef,setSourceRef]=useState('');
+ const [loading,setLoading]=useState(false);const [saving,setSaving]=useState(false);
+ const [error,setError]=useState('');const [message,setMessage]=useState('');
+ const generation=useRef(0);
+ const loadList=useCallback(async(term:string)=>{
+   const token=++generation.current;setLoading(true);setError('');setMessage('');
+   try{const {data,error:e}=await supabase.rpc('transport_collection_receipt_list',{p_search:term,p_limit:50});
+    if(e)throw e;if(token===generation.current)setReceipts((data??[]) as ReceiptRow[]);
+   }catch(e){if(token===generation.current){setError((e as Error).message||'Receipt list unavailable');setReceipts([]);}}
+   finally{if(token===generation.current)setLoading(false);}
+ },[]);
+ useEffect(()=>{void loadList('');return()=>{generation.current++;};},[loadList]);
+ useEffect(()=>{
+   let cancelled=false;setEvidence(null);setError('');setMessage('');setManual({});setSourceRef('');setMethod('auto');
+   if(!selected)return;
+   void (async()=>{try{const {data,error:e}=await supabase.rpc('transport_collection_receipt_evidence',{p_receipt_allocation_id:selected});
+    if(e)throw e;if(!cancelled)setEvidence(data as Evidence);
+   }catch(e){if(!cancelled)setError((e as Error).message||'Receipt evidence unavailable');}})();
+   return()=>{cancelled=true;};
+ },[selected]);
+ const match:PostedReceipt|null=useMemo(()=>evidence?.receipt?{
+   receipt_allocation_id:evidence.receipt.receipt_allocation_id,invoice_id:evidence.receipt.sales_order_id,
+   reference:evidence.receipt.reference,allocation_date:evidence.receipt.allocation_date,
+   amount:evidence.receipt.amount,journal_status:evidence.receipt.journal_status,
+   reversed:evidence.receipt.reversed,saved_shares:evidence.saved_shares
+ }:null,[evidence]);
+ const partners:ReceiptPartner[]=useMemo(()=>(evidence?.partners??[]).filter(p=>p.partner_id!==null)
+   .map(p=>({partner_id:p.partner_id!,partner_name:p.partner_name,gross:Number(p.gross),saved_on_other_receipts:Number(p.previously_linked)})),[evidence]);
+ const flags=useMemo(()=>{
+   if(!evidence||!match)return [] as string[];
+   const problems=[...assessPostedReceipt(match,partners).flags];
+   if(evidence.partners.some(p=>!p.partner_id))problems.push('UNATTRIBUTED_OWNER');
+   if(evidence.prior_unlinked_count>0)problems.push('OLDER_RECEIPT_NOT_LINKED');
+   if(evidence.has_adjustment)problems.push('INVOICE_ADJUSTMENT_REVIEW');
+   if(evidence.receipt?.invoice_status!=='posted')problems.push('INVOICE_NOT_POSTED');
+   if(evidence.receipt?.currency_code&&evidence.receipt.currency_code!=='SAR')problems.push('CURRENCY_NOT_SAR');
+   if(Math.abs(Number(evidence.source_trip_gross)-Number(evidence.receipt?.invoice_total))>.005)problems.push('TRIP_TOTAL_MISMATCH');
+   if(Math.abs(Number(evidence.canonical_invoice_allocation_total)-Number(evidence.receipt?.paid_amount))>.005)
+     problems.push('CANONICAL_ALLOCATION_MISMATCH');
+   return [...new Set(problems)];
+ },[evidence,match,partners]);
+ const preview=useMemo(()=>{
+   if(!match||flags.length)return {shares:[] as PaymentShare[],error:''};
+   try{
+     if(method==='auto')return {shares:calculatePostedReceiptSplit(match,partners,'auto'),error:''};
+     const splits=partners.filter(p=>manual[p.partner_id]&&Number(manual[p.partner_id])>0).map(p=>{
+       const value=parseSar(manual[p.partner_id]??'');
+       if(value===null)throw new Error('Use SAR amounts with at most two decimals.');
+       return {key:p.partner_id,partnerId:p.partner_id,halalas:Math.round(value*100)};
+     });
+     return {shares:calculatePostedReceiptSplit(match,partners,'manual',splits),error:''};
+   }catch(e){return {shares:[],error:(e as Error).message};}
+ },[match,partners,flags,method,manual]);
+ async function save(){
+   if(!match||!evidence||flags.length||preview.error||!preview.shares.length||saving)return;
+   setError('');setMessage('');setSaving(true);
+   try{
+     const request=makeReceiptLinkRequest(match,partners,method,preview.shares,sourceRef);
+     const {error:e}=await supabase.rpc('transport_collection_link_posted_receipt',request);
+     if(e)throw e;
+     setMessage('Canonical receipt permanently linked to partner subledger. No customer receipt or GL re-posted.');
+     const [updated,list]=await Promise.all([
+       supabase.rpc('transport_collection_receipt_evidence',{p_receipt_allocation_id:selected}),
+       supabase.rpc('transport_collection_receipt_list',{p_search:submittedSearch,p_limit:50})
+     ]);
+     if(updated.error)throw updated.error;if(list.error)throw list.error;
+     setEvidence(updated.data as Evidence);setReceipts((list.data??[]) as ReceiptRow[]);
+   }catch(e){setError((e as Error).message||'Could not link posted receipt.');}
+   finally{setSaving(false);}
+ }
+ function doSearch(){const term=search.trim();setSubmittedSearch(term);setSelected('');void loadList(term);}
+ return <section className="space-y-2 rounded border bg-white p-3 text-xs">
+   <div className="flex flex-wrap items-start justify-between gap-2"><div><h3 className="text-sm font-bold">Posted Customer Receipt → Partner Link</h3>
+     <p className="text-slate-600">Existing Cash Counter receipt only. Auto split or reviewed manual split; no new receipt, AR, bank, GL or VAT entry.</p></div>
+     <span className="rounded bg-slate-100 px-2 py-1">Immutable analytical evidence · SAR</span></div>
+   <div className="flex flex-wrap items-end gap-2"><label className="grid gap-1">Invoice or receipt reference<input aria-label="Receipt search" className="input h-8 min-w-60" value={search} onChange={e=>setSearch(e.target.value)} onKeyDown={e=>{if(e.key==='Enter')doSearch();}}/></label>
+     <button className="btn h-8" onClick={doSearch} disabled={loading||saving}>Search</button>
+     <button className="btn h-8" onClick={()=>void loadList(submittedSearch)} disabled={loading||saving}>Refresh</button></div>
+   {loading&&<p role="status">Loading posted receipt allocations…</p>}
+   <div className="max-h-52 overflow-auto rounded border"><table className="w-full min-w-[720px] text-xs"><thead className="bg-slate-50"><tr><th className="p-2 text-left">Invoice</th><th>Date</th><th className="text-right">Receipt (SAR)</th><th>Reference</th><th>Status</th><th></th></tr></thead><tbody>
+     {receipts.map(r=><tr key={r.receipt_allocation_id} className="border-t"><td className="p-2 font-semibold">{r.invoice_no}</td><td className="p-2">{formatNaviloDate(r.allocation_date)}</td><td className="p-2 text-right">{fmt(r.amount)}</td><td className="p-2">{r.reference||'—'}</td>
+       <td className="p-2">{Number(r.linked_partner_count)>0?'Linked':'Unlinked'}</td><td className="p-2"><button className="btn" disabled={saving} onClick={()=>setSelected(r.receipt_allocation_id)}>{selected===r.receipt_allocation_id?'Selected':'Review'}</button></td></tr>)}
+     {!receipts.length&&!loading&&<tr><td colSpan={6} className="p-3 text-center text-slate-500">No matching Transport customer receipts.</td></tr>}
+   </tbody></table></div>
+   {error&&<p role="alert" className="rounded bg-red-50 p-2 text-red-800">{error}</p>}
+   {message&&<p role="status" className="rounded bg-green-50 p-2 text-green-800">{message}</p>}
+   {match&&evidence&&<div className="space-y-2 rounded border p-2">
+     <div className="flex flex-wrap justify-between gap-2"><strong>{evidence.receipt?.invoice_no} · Posted Receipt SAR {fmt(match.amount)}</strong><span>{evidence.saved_shares.length?'Already linked (read only)':'Link preview'}</span></div>
+     {flags.length>0&&<p role="alert" className="rounded bg-amber-50 p-2 text-amber-900">Review Required: {flags.join(', ')}. No partner balance or transfer can be authorized from this receipt.</p>}
+     <div className="overflow-auto"><table className="w-full min-w-[560px] text-xs"><thead className="bg-slate-50"><tr><th className="p-2 text-left">Partner</th><th className="text-right">Invoice gross</th><th className="text-right">Previously linked</th><th className="text-right">Available</th>{!evidence.saved_shares.length&&<th className="text-right">Manual SAR</th>}</tr></thead><tbody>
+       {evidence.partners.map((p,i)=><tr key={p.partner_id??`unassigned-${i}`} className="border-t"><td className="p-2">{p.partner_name}</td><td className="p-2 text-right">{fmt(p.gross)}</td><td className="p-2 text-right">{fmt(p.previously_linked)}</td><td className="p-2 text-right">{fmt(p.capacity)}</td>
+         {!evidence.saved_shares.length&&<td className="p-2 text-right"><input aria-label={`Split for ${p.partner_name}`} className="input h-8 w-28 text-right" disabled={flags.length>0||method!=='manual'||!p.partner_id} value={p.partner_id?manual[p.partner_id]??'':''} onChange={e=>p.partner_id&&setManual(old=>({...old,[p.partner_id!]:e.target.value}))} placeholder="0.00"/></td>}</tr>)}
+     </tbody></table></div>
+     {evidence.saved_shares.length?<p className="rounded bg-slate-50 p-2">Saved immutable shares: {evidence.saved_shares.map(x=>`${partners.find(p=>p.partner_id===x.partner_id)?.partner_name??'Partner'} SAR ${fmt(x.amount)}`).join(' · ')}</p>:<>
+       <div className="flex flex-wrap items-center gap-3"><label className="inline-flex items-center gap-1"><input type="radio" checked={method==='auto'} onChange={()=>setMethod('auto')}/>Auto proportional</label>
+         <label className="inline-flex items-center gap-1"><input type="radio" checked={method==='manual'} onChange={()=>setMethod('manual')}/>Manual</label></div>
+       {preview.error&&<p role="alert" className="text-red-700">{preview.error}</p>}
+       {!flags.length&&!preview.error&&<p className="rounded bg-slate-50 p-2">Preview: {preview.shares.map(x=>`${partners.find(p=>p.partner_id===x.partnerId)?.partner_name??'Partner'} SAR ${halalasToSar(x.halalas)}`).join(' · ')}</p>}
+       <div className="flex flex-wrap items-end gap-2"><label className="grid gap-1">Reviewed source reference<input className="input h-8 min-w-60" value={sourceRef} onChange={e=>setSourceRef(e.target.value)} maxLength={160} placeholder="Bank/customer remittance advice reference"/></label>
+         <button className="btn-primary h-8" disabled={saving||flags.length>0||!!preview.error||!preview.shares.length||(partners.length>1||method==='manual')&&sourceRef.trim().length<6} onClick={()=>void save()}>{saving?'Linking…':'Save immutable partner link'}</button></div>
+       <p className="text-slate-500">Server recalculates Auto split and rejects stale, reversed or duplicate evidence. This cannot be used to pay a partner.</p>
+     </>}
+   </div>}
+ </section>;
+}
diff --git a/src/modules/transport/PartnerReceivableReview.tsx b/src/modules/transport/PartnerReceivableReview.tsx
new file mode 100644
index 00000000..e0abae4a
--- /dev/null
+++ b/src/modules/transport/PartnerReceivableReview.tsx
@@ -0,0 +1,83 @@
+import {useMemo,useState} from 'react';
+import {supabase} from '@/lib/supabase';
+import {sarToHalalas,halalasToSar,type PaymentShare} from './partnerCollectionCore';
+import {reviewInvoice,planExpectedReceipt,type InvoiceReview} from './partnerReceiptPlan';
+import {partnerReviewLabel} from './partnerReviewLabels';
+
+type InvoiceChoice={invoice_id:string;invoice_no:string;invoice_date:string;gross:number;received:number;status:string};
+const money=(v:number)=>Number(v||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
+/** Read-only Stage 3: actual saved receipt allocations are inspected, never posted. */
+export default function PartnerReceivableReview(){
+ const [search,setSearch]=useState('');const [choices,setChoices]=useState<InvoiceChoice[]>([]);
+ const [selected,setSelected]=useState('');const [review,setReview]=useState<InvoiceReview|null>(null);
+ const [expected,setExpected]=useState('');const [manual,setManual]=useState<Record<string,string>>({});
+ const [result,setResult]=useState<PaymentShare[]>([]);const [busy,setBusy]=useState(false);const [error,setError]=useState('');
+ const assessment=useMemo(()=>review?reviewInvoice(review):null,[review]);
+ async function findInvoices(){
+  setBusy(true);setError('');setReview(null);setSelected('');setResult([]);
+  try{
+   const r=await supabase.rpc('transport_collection_invoice_lookup',{p_search:search.trim(),p_limit:40});
+   if(r.error)throw r.error;
+   setChoices((r.data??[]) as InvoiceChoice[]);
+  }catch(e){setError((e as {message?:string}).message??'Invoice search failed');}
+  finally{setBusy(false);}
+ }
+ async function chooseInvoice(id:string){
+  setSelected(id);setBusy(true);setError('');setReview(null);setResult([]);setManual({});setExpected('');
+  if(!id){setBusy(false);return;}
+  try{
+   const r=await supabase.rpc('transport_collection_invoice_review',{p_invoice_id:id});
+   if(r.error)throw r.error;
+   setReview(r.data as InvoiceReview);
+  }catch(e){setError((e as {message?:string}).message??'Invoice reconciliation unavailable');}
+  finally{setBusy(false);}
+ }
+ const compute=(mode:'auto'|'manual')=>{
+  setResult([]);setError('');
+  try{
+   if(!review||!assessment)throw new Error('Select an invoice.');
+   const amount=sarToHalalas(expected);
+   const allocations=mode==='auto'?planExpectedReceipt(review,amount):planExpectedReceipt(review,amount,
