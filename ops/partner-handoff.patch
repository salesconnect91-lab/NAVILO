+ if exists(select 1 from public.transport_collection_finance_mapping where company_id=c and business_unit_id=b) then raise exception 'Existing approved mapping cannot be replaced; use reviewed migration';end if;
+ if (select count(distinct x) from unnest(array[p_payable,p_advance,p_vat,p_revenue]) x)<>4 then raise exception 'Four distinct GL accounts required';end if;
+ if (select count(*) from public.chart_of_accounts a where a.company_id=c and a.id=any(array[p_payable,p_advance,p_vat,p_revenue]) and a.is_active and not a.is_group and a.allow_manual_entries and coalesce(a.detail_type,'') not in('Accounts Receivable','Accounts Payable','Input VAT','Output VAT','Bank Account','Cash on Hand') and a.type=case when a.id=p_payable then 'liability' when a.id=p_revenue then 'revenue' else 'asset' end)<>4 then raise exception 'Dedicated active Partner Payable/Advance/VAT and original service revenue GL required';end if;
+ insert into public.transport_collection_finance_mapping(company_id,business_unit_id,partner_payable_account_id,partner_advance_account_id,partner_vat_receivable_account_id,revenue_clearing_account_id,reviewed_by,is_approved) values(c,b,p_payable,p_advance,p_vat,p_revenue,auth.uid(),true);
+ insert into public.audit_logs(user_id,module,action,table_name,record_name,performed_by,metadata) values(public.legacy_data_user_id(),'transport','PARTNER_GL_APPROVED','transport_collection_finance_mapping',p_reference,auth.uid(),jsonb_build_object('company_id',c,'business_unit_id',b,'reference',p_reference));
+end $$;
