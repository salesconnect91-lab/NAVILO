+create or replace function public.transport_collection_invoice_review(p_invoice_id uuid)
+returns jsonb
+language plpgsql stable security definer set search_path=public,pg_temp as $$
+declare
+ c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();
+ v_doc uuid;v_no text;v_date date;v_status text;v_total numeric;v_paid numeric;
+ v_line_gross numeric;v_trip_count integer;v_adjust_count integer;
+ v_allocated numeric;v_allocation_rows integer;v_reversed integer;
+ v_conflict integer;v_partner_count integer;v_partners jsonb;
+ v_historical_received numeric;v_opening_settled integer;
+begin
+ if auth.uid() is null or c is null or b is null or p_invoice_id is null
+ or not public.has_module_permission(c,'transport','view')
+ or not public.has_module_permission(c,'accounting','view')
+ or not exists(select 1 from public.transport_collection_settings cfg
+                 where cfg.company_id=c and cfg.business_unit_id=b and cfg.enabled)
+ then raise exception 'Partner Collections financial view denied';end if;
+ select d.id,s.order_no::text,s.order_date,s.status::text,s.total,s.paid_amount
+ into v_doc,v_no,v_date,v_status,v_total,v_paid
+ from public.sales_orders s join public.transport_customer_documents d
+ on d.sales_order_id=s.id and d.company_id=c and d.business_unit_id=b
+ where s.id=p_invoice_id and s.company_id=c and s.business_unit_id=b;
+ if not found then raise exception 'Invoice unavailable in the current workspace';end if;
+
+ select round(coalesce(sum(l.rate_snapshot+l.vat_snapshot),0),2),
+   count(*)::integer,count(*) filter(where coalesce(l.is_adjustment,false))::integer
+ into v_line_gross,v_trip_count,v_adjust_count
+ from public.transport_customer_document_trips l
+ where l.document_id=v_doc and l.company_id=c and l.business_unit_id=b;
+
+ select round(coalesce(sum(a.amount) filter(where j.status='posted'),0),2),
+   count(*)::integer,
+   count(*) filter(where exists (
+     select 1 from public.journal_entries reversal
+     where reversal.reversal_of_entry_id=a.journal_entry_id
+       and reversal.company_id=c and reversal.business_unit_id=b and reversal.status='posted'
+   ))::integer
+ into v_allocated,v_allocation_rows,v_reversed
+ from public.invoice_payment_allocations a
+ left join public.journal_entries j on j.id=a.journal_entry_id
+  and j.company_id=c and j.business_unit_id=b
+ where a.sales_order_id=p_invoice_id and a.company_id=c and a.business_unit_id=b;
+
+ -- Historical imported customer receipts are not assumed to be independent
+ -- or already canonical. Mark them for review before any partner allocation.
+ select round(coalesce(sum(h.received_gross),0),2) into v_historical_received
+ from public.transport_customer_document_trips l
+ join public.transport_historical_payment_effective h on h.trip_id=l.trip_id
+   and h.company_id=c and h.business_unit_id=b
+ where l.document_id=v_doc and l.company_id=c and l.business_unit_id=b;
+
+ select count(distinct od.id)::integer into v_opening_settled
+ from public.transport_customer_document_trips l
+ join public.transport_opening_invoice_lines ol on ol.trip_id=l.trip_id and ol.side='customer'
+ join public.transport_opening_invoice_documents od on od.id=ol.document_id
+   and od.company_id=c and od.business_unit_id=b and od.side='customer'
+ where l.document_id=v_doc and l.company_id=c and l.business_unit_id=b
+  and coalesce(od.historical_settled,0)>0;
+
+ -- Native posted invoice lines are the primary evidence. Opening lines are NOT
+ -- summed into native invoices. Compare them solely to surface conflicts.
+ with n as (
+   select l.trip_id,sum(l.rate_snapshot) net,sum(l.vat_snapshot) vat
+   from public.transport_customer_document_trips l
+   where l.document_id=v_doc and l.company_id=c and l.business_unit_id=b
+   group by l.trip_id
+ ),o as (
+   select l.trip_id,sum(l.original_net) net,sum(l.original_gross) gross
+   from public.transport_opening_invoice_lines l
+   join public.transport_opening_invoice_documents d on d.id=l.document_id
+     and d.company_id=c and d.business_unit_id=b and d.side='customer'
+   where l.side='customer' and l.trip_id in(select n.trip_id from n)
+   group by l.trip_id
+ )
+ select count(*) filter(where o.trip_id is not null
+   and (abs(n.net-o.net)>0.01 or abs(n.net+n.vat-o.gross)>0.01))::integer
+ into v_conflict from n left join o on o.trip_id=n.trip_id;
+
+ with n as (
+ select l.trip_id,t.owner_name_snapshot,l.rate_snapshot,l.vat_snapshot,
+  upper(regexp_replace(btrim(coalesce(t.owner_name_snapshot,'')),E'\\s+',' ','g')) owner_key
+ from public.transport_customer_document_trips l
+ join public.transport_trips t on t.id=l.trip_id and t.company_id=c and t.business_unit_id=b
+ where l.document_id=v_doc and l.company_id=c and l.business_unit_id=b
+ ),o as (
+   select l.trip_id,sum(l.original_net) net,sum(l.original_gross) gross
+   from public.transport_opening_invoice_lines l
+   join public.transport_opening_invoice_documents d on d.id=l.document_id
+     and d.company_id=c and d.business_unit_id=b and d.side='customer'
+   where l.side='customer' and l.trip_id in(select n.trip_id from n)
+   group by l.trip_id
+ ),classified as (
+ select n.*,p.id partner_id,coalesce(p.code,'review_required') partner_code,
+ coalesce(p.name,'Review Required') partner_name,
+ case when o.trip_id is not null and
+   (abs(n.rate_snapshot-o.net)>0.01 or abs(n.rate_snapshot+n.vat_snapshot-o.gross)>0.01)
+   then 1 else 0 end conflict
+ from n
+ join public.transport_collection_settings cfg on cfg.company_id=c and cfg.business_unit_id=b and cfg.enabled
+ left join public.transport_collection_owner_aliases a on a.company_id=c and a.business_unit_id=b and a.owner_key=n.owner_key
+ left join public.transport_collection_partners p on p.id=case when n.owner_key='' then null else coalesce(a.partner_id,cfg.default_partner_id) end
+   and p.company_id=c and p.business_unit_id=b and p.is_active
+ left join o on o.trip_id=n.trip_id
+ ),aggregated as (
+ select partner_id,partner_code,partner_name,round(sum(rate_snapshot),2) net,
+ round(sum(vat_snapshot),2) vat,
+ round(sum(rate_snapshot+vat_snapshot),2) gross,
+ count(*)::integer trip_count,sum(conflict)::integer opening_conflicts
+ from classified group by partner_id,partner_code,partner_name
+ )
+ select coalesce(jsonb_agg(to_jsonb(aggregated) order by partner_code),'[]'::jsonb),count(*)::integer
+ into v_partners,v_partner_count from aggregated;
+
+ return jsonb_build_object(
+   'invoice_id',p_invoice_id,'order_no',v_no,'order_date',v_date,'status',v_status,
+   'invoice_gross',coalesce(v_total,0),'trip_gross',coalesce(v_line_gross,0),
+   'order_paid',coalesce(v_paid,0),'posted_allocated',coalesce(v_allocated,0),
+   'allocation_rows',coalesce(v_allocation_rows,0),'reversed_rows',coalesce(v_reversed,0),
+   'opening_conflict_count',coalesce(v_conflict,0),
+   'historical_customer_received',coalesce(v_historical_received,0),
+   'opening_settled_document_count',coalesce(v_opening_settled,0),'adjustment_count',coalesce(v_adjust_count,0),
+   'partner_count',coalesce(v_partner_count,0),'trip_count',coalesce(v_trip_count,0),
+   'partners',coalesce(v_partners,'[]'::jsonb));
+end $$;
+revoke all on function public.transport_collection_invoice_review(uuid) from public,anon;
+grant execute on function public.transport_collection_invoice_review(uuid) to authenticated;
+
+-- Source stage: partner_collection_stage4_READ_ONLY_REVIEW.sql
+-- NAVILO Partner Collection & Settlement -- STAGE 4 REVIEW ONLY.
+-- REQUIRES Stage 2 and Stage 3 read-only foundations, neither is applied to production.
+-- Never run against production before isolated database, permissions and performance tests.
+-- Does NOT create customer receipt, AR, partner payout, journal, VAT or GL movements.
+-- Native posted sales invoice source wins; imported opening document is comparison ONLY.
+
+create or replace function public.transport_collection_partner_invoice_ledger(
+ p_partner_id uuid,
+ p_from date default null,
+ p_to date default null,
+ p_search text default '',
+ p_limit integer default 50,
+ p_offset integer default 0
+) returns jsonb
+language plpgsql stable security definer set search_path=public,pg_temp as $$
+declare
+ c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();
+ v_result jsonb;
+begin
+ if auth.uid() is null or c is null or b is null or p_partner_id is null
+  or not public.has_module_permission(c,'transport','view')
+  or not public.has_module_permission(c,'accounting','view')
+  or not exists(select 1 from public.transport_collection_settings cfg
+   where cfg.company_id=c and cfg.business_unit_id=b and cfg.enabled)
+ then raise exception 'Partner Collections ledger permission denied';end if;
+ if not exists(select 1 from public.transport_collection_partners p
+   where p.id=p_partner_id and p.company_id=c and p.business_unit_id=b and p.is_active)
+ then raise exception 'Active partner unavailable in current workspace';end if;
+ if p_from is not null and p_to is not null and p_from>p_to
+ then raise exception 'From date cannot exceed To date';end if;
+ if length(coalesce(p_search,''))>100 then raise exception 'Invoice search is too long';end if;
+
+ with classified as (
+  select d.sales_order_id,l.trip_id,l.rate_snapshot net,l.vat_snapshot vat,
+   coalesce(l.is_adjustment,false) is_adjustment,
+   case when btrim(coalesce(t.owner_name_snapshot,''))='' then null::uuid
+        else coalesce(a.partner_id,cfg.default_partner_id) end partner_id
+  from public.transport_customer_documents d
+  join public.sales_orders s on s.id=d.sales_order_id and s.company_id=c and s.business_unit_id=b
+  join public.transport_customer_document_trips l on l.document_id=d.id
+       and l.company_id=c and l.business_unit_id=b
+  join public.transport_trips t on t.id=l.trip_id and t.company_id=c and t.business_unit_id=b
+  join public.transport_collection_settings cfg on cfg.company_id=c and cfg.business_unit_id=b and cfg.enabled
+  left join public.transport_collection_owner_aliases a
+      on a.company_id=c and a.business_unit_id=b
+     and a.owner_key=upper(regexp_replace(btrim(coalesce(t.owner_name_snapshot,'')),E'\\s+',' ','g'))
+  where d.company_id=c and d.business_unit_id=b
+    and (p_from is null or s.order_date>=p_from)
+    and (p_to is null or s.order_date<=p_to)
+    and (btrim(coalesce(p_search,''))='' or s.order_no ilike '%'||btrim(p_search)||'%')
+ ), target_invoices as (
+   select distinct sales_order_id from classified where partner_id=p_partner_id
+ ), native_lines as (
+  select l.* from classified l join target_invoices ti on ti.sales_order_id=l.sales_order_id
+ ), by_partner as (
+  select sales_order_id,partner_id,round(sum(net),2) net,round(sum(vat),2) vat,
+         round(sum(net+vat),2) gross,count(*)::integer trip_lines
+  from native_lines group by sales_order_id,partner_id
+ ), invoice_stats as (
+  select sales_order_id,round(sum(net+vat),2) lines_gross,
+       count(distinct partner_id)::integer partner_count,
+       bool_or(partner_id is null) missing_partner,
+       bool_or(is_adjustment) adjusted
+  from native_lines group by sales_order_id
+ ), native_by_trip as (
+  select sales_order_id,trip_id,round(sum(net),2) net,round(sum(net+vat),2) gross
+  from native_lines group by sales_order_id,trip_id
+ ), opening_by_trip as (
+  select ol.trip_id,round(sum(ol.original_net),2) net,round(sum(ol.original_gross),2) gross,
+   bool_or(coalesce(od.historical_settled,0)>0) settled
+  from public.transport_opening_invoice_lines ol
+  join public.transport_opening_invoice_documents od on od.id=ol.document_id
+    and od.company_id=c and od.business_unit_id=b and od.side='customer'
+  where ol.side='customer' and ol.trip_id in (select trip_id from native_by_trip)
+  group by ol.trip_id
+ ), source_checks as (
+  select nt.sales_order_id,
+   bool_or(op.trip_id is not null and (abs(nt.net-op.net)>0.01 or abs(nt.gross-op.gross)>0.01)) opening_mismatch,
+   bool_or(coalesce(op.settled,false)) opening_settled,
+   bool_or(coalesce(h.received_gross,0)>0.01) historical_received
+  from native_by_trip nt
+  left join opening_by_trip op on op.trip_id=nt.trip_id
+  left join public.transport_historical_payment_effective h on h.trip_id=nt.trip_id
+   and h.company_id=c and h.business_unit_id=b
+  group by nt.sales_order_id
+ ), received as (
+  select al.sales_order_id,
+   round(coalesce(sum(al.amount) filter(where j.status='posted'),0),2) received,
+   count(*)::integer allocation_rows,
+   bool_or(coalesce(exists(
+     select 1 from public.journal_entries reversal
+     where reversal.reversal_of_entry_id=al.journal_entry_id
+       and reversal.company_id=c and reversal.business_unit_id=b and reversal.status='posted'),false)) has_reversal
+  from public.invoice_payment_allocations al
+  left join public.journal_entries j on j.id=al.journal_entry_id
+      and j.company_id=c and j.business_unit_id=b
+  where al.company_id=c and al.business_unit_id=b
+    and al.sales_order_id in(select sales_order_id from target_invoices)
+  group by al.sales_order_id
+ ), raw as (
+  select s.id invoice_id,s.order_no::text invoice_no,s.order_date invoice_date,
+   s.status::text status,round(coalesce(s.total,0),2) invoice_gross,
+   round(coalesce(s.paid_amount,0),2) canonical_paid,
+   coalesce(r.received,0) posted_allocated,
+   bp.net partner_net,bp.vat partner_vat,bp.gross partner_gross,bp.trip_lines,
+   st.lines_gross,st.partner_count,st.missing_partner,st.adjusted,
+   coalesce(sc.opening_mismatch,false) opening_mismatch,
+   coalesce(sc.opening_settled,false) opening_settled,
+   coalesce(sc.historical_received,false) historical_received,
+   coalesce(r.has_reversal,false) reversed_receipt
+  from target_invoices ti
+  join public.sales_orders s on s.id=ti.sales_order_id and s.company_id=c and s.business_unit_id=b
+  join by_partner bp on bp.sales_order_id=s.id and bp.partner_id=p_partner_id
+  join invoice_stats st on st.sales_order_id=s.id
+  left join source_checks sc on sc.sales_order_id=s.id
+  left join received r on r.sales_order_id=s.id
+ ), flagged as (
+  select raw.*,array_remove(array[
+   case when status<>'posted' then 'NOT_POSTED' end,
+   case when partner_gross<0 or invoice_gross<0 or partner_gross>invoice_gross then 'INVALID_EVIDENCE' end,
+   case when missing_partner then 'UNATTRIBUTED_OWNER' end,
+   case when abs(lines_gross-invoice_gross)>0.01 then 'INVOICE_TRIP_MISMATCH' end,
+   case when abs(canonical_paid-posted_allocated)>0.01 then 'CANONICAL_RECEIPT_MISMATCH' end,
+   case when canonical_paid>invoice_gross+0.01 then 'OVERPAYMENT' end,
+   case when opening_mismatch then 'OPENING_SOURCE_CONFLICT' end,
+   case when historical_received then 'HISTORICAL_RECEIPT_REVIEW' end,
+   case when opening_settled then 'OPENING_SETTLEMENT_REVIEW' end,
+   case when adjusted then 'ADJUSTMENT_REVIEW' end,
+   case when reversed_receipt then 'REVERSAL_REVIEW' end,
+   case when partner_count>1 and canonical_paid>0 then 'MIXED_PARTNER_PRIOR_RECEIPT' end
+  ]::text[],null::text) flags
+  from raw
+ ), reconciled as (
+  select flagged.*,
+   cardinality(flags)=0 verified,
+   case when cardinality(flags)=0 then
+     case when partner_count=1 then canonical_paid else 0::numeric end
+    else null::numeric end partner_received,
+   case when cardinality(flags)=0 then
+     partner_gross-(case when partner_count=1 then canonical_paid else 0::numeric end)
+    else null::numeric end partner_outstanding
+  from flagged
+ ), page_rows as (
+  select * from reconciled
+  order by invoice_date desc,invoice_no desc,invoice_id
+  limit least(greatest(coalesce(p_limit,50),1),100)
+  offset least(greatest(coalesce(p_offset,0),0),20000)
+ )
+ select jsonb_build_object(
+  'partner_id',p_partner_id,
+  'invoice_count',count(*),
+  'verified_invoice_count',count(*) filter(where verified),
+  'review_invoice_count',count(*) filter(where not verified),
+  'verified_billed',round(coalesce(sum(partner_gross) filter(where verified),0),2),
+  'verified_received',round(coalesce(sum(partner_received) filter(where verified),0),2),
+  'verified_outstanding',round(coalesce(sum(partner_outstanding) filter(where verified),0),2),
+  'review_billed',round(coalesce(sum(partner_gross) filter(where not verified),0),2),
+  'rows',(select coalesce(jsonb_agg(to_jsonb(page_rows) order by invoice_date desc,invoice_no desc,invoice_id),'[]'::jsonb) from page_rows)
+ ) into v_result from reconciled;
+ return coalesce(v_result,'{}'::jsonb);
+end $$;
+revoke all on function public.transport_collection_partner_invoice_ledger(uuid,date,date,text,integer,integer) from public,anon;
+grant execute on function public.transport_collection_partner_invoice_ledger(uuid,date,date,text,integer,integer) to authenticated;
+
+-- Source stage: partner_collection_stage5_RECEIPT_LINK_REVIEW.sql
+-- STAGE 5 FOR REVIEW/ISOLATED REHEARSAL ONLY. NOT A PRODUCTION MIGRATION.
+-- Requires Stage 2, 3 and 4 schema. Never re-post receipt, journal, VAT, AR or bank.
+-- Records only an immutable analytical attribution to a canonical posted invoice payment allocation.
+
+create table public.transport_collection_receipt_shares (
+ id uuid primary key default gen_random_uuid(),
+ company_id uuid not null references public.companies(id),
+ business_unit_id uuid not null references public.business_units(id),
+ receipt_allocation_id uuid not null references public.invoice_payment_allocations(id),
+ sales_order_id uuid not null references public.sales_orders(id),
+ partner_id uuid not null,
+ amount numeric(18,2) not null check(amount>0),
+ receipt_amount_snapshot numeric(18,2) not null check(receipt_amount_snapshot>0),
+ partner_gross_snapshot numeric(18,2) not null check(partner_gross_snapshot>=0),
+ allocation_method text not null check(allocation_method in ('auto','manual')),
+ evidence_reference text not null,
+ created_by uuid not null references auth.users(id),
+ created_at timestamptz not null default clock_timestamp(),
+ unique(receipt_allocation_id,partner_id),
+ foreign key(partner_id,company_id,business_unit_id)
+  references public.transport_collection_partners(id,company_id,business_unit_id)
+);
+create index transport_collection_receipt_shares_invoice_idx
+ on public.transport_collection_receipt_shares(company_id,business_unit_id,sales_order_id);
+create index transport_collection_receipt_shares_partner_idx
+ on public.transport_collection_receipt_shares(company_id,business_unit_id,partner_id,created_at);
+-- Application users can READ in their current authorized transport+accounting scope, never mutate directly.
+alter table public.transport_collection_receipt_shares enable row level security;
+revoke all on public.transport_collection_receipt_shares from public,anon,authenticated;
+grant select on public.transport_collection_receipt_shares to authenticated;
+create policy partner_receipt_shares_read on public.transport_collection_receipt_shares for select to authenticated
+ using(company_id=public.current_company_id() and business_unit_id=public.current_business_unit_id()
+   and public.has_module_permission(company_id,'transport','view')
+   and public.has_module_permission(company_id,'accounting','view')
+   and exists(select 1 from public.transport_collection_settings s where s.company_id=transport_collection_receipt_shares.company_id and s.business_unit_id=transport_collection_receipt_shares.business_unit_id and s.enabled));
+-- Immutable evidence. Audit correction is separate, future reviewed supersession, NOT UPDATE/DELETE.
+create function public.transport_collection_receipt_share_immutable() returns trigger
+language plpgsql set search_path=public,pg_temp as $$
+begin raise exception 'Saved partner receipt evidence is immutable; use a controlled reviewed correction'; end $$;
+create trigger transport_collection_receipt_share_no_mutation
+before update or delete on public.transport_collection_receipt_shares
+for each row execute function public.transport_collection_receipt_share_immutable();
+revoke all on function public.transport_collection_receipt_share_immutable() from public,anon,authenticated;
+
+-- Lightweight searchable receipt rows. Always require a current authenticated scoped user.
+create function public.transport_collection_receipt_list(p_search text default '',p_limit integer default 50)
+returns jsonb language plpgsql stable security definer set search_path=public,pg_temp as $$
+declare c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();out_data jsonb;
+begin
+ if auth.uid() is null or c is null or b is null
+  or not public.has_module_permission(c,'transport','view')
+  or not public.has_module_permission(c,'accounting','view')
+  or not exists(select 1 from public.transport_collection_settings s where s.company_id=c and s.business_unit_id=b and s.enabled)
+ then raise exception 'Partner receipt read permission denied';end if;
+ if length(coalesce(p_search,''))>80 then raise exception 'Search too long';end if;
+ select coalesce(jsonb_agg(to_jsonb(x) order by x.allocation_date desc,x.receipt_allocation_id desc),'[]'::jsonb) into out_data
+ from (
+  select a.id receipt_allocation_id,a.sales_order_id,s.order_no invoice_no,a.allocation_date,a.amount,
+   a.reference,a.journal_entry_id,je.status journal_status,
+   (select count(*) from public.transport_collection_receipt_shares sh where sh.receipt_allocation_id=a.id) linked_partner_count,
+   (select coalesce(sum(sh.amount),0) from public.transport_collection_receipt_shares sh where sh.receipt_allocation_id=a.id) linked_amount
+  from public.invoice_payment_allocations a
+  join public.sales_orders s on s.id=a.sales_order_id and s.company_id=c and s.business_unit_id=b
+  join public.transport_customer_documents d on d.sales_order_id=s.id and d.company_id=c and d.business_unit_id=b
+  join public.journal_entries je on je.id=a.journal_entry_id and je.company_id=c and je.business_unit_id=b
+  where a.company_id=c and a.business_unit_id=b
+   and (btrim(coalesce(p_search,''))='' or s.order_no ilike '%'||btrim(p_search)||'%' or coalesce(a.reference,'') ilike '%'||btrim(p_search)||'%')
+  order by a.allocation_date desc,a.id desc limit least(greatest(coalesce(p_limit,50),1),100)
+ ) x;
+ return out_data;
+end $$;
+revoke all on function public.transport_collection_receipt_list(text,integer) from public,anon;
+grant execute on function public.transport_collection_receipt_list(text,integer) to authenticated;
+
+-- Caller sees all partner capacities and any saved receipt share before choosing auto/manual.
+create function public.transport_collection_receipt_evidence(p_receipt_allocation_id uuid)
+returns jsonb language plpgsql stable security definer set search_path=public,pg_temp as $$
+declare c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();result jsonb;
+begin
+ if auth.uid() is null or c is null or b is null or p_receipt_allocation_id is null
+  or not public.has_module_permission(c,'transport','view')
+  or not public.has_module_permission(c,'accounting','view')
+  or not exists(select 1 from public.transport_collection_settings s where s.company_id=c and s.business_unit_id=b and s.enabled)
+ then raise exception 'Partner receipt evidence permission denied';end if;
+ with receipt as (
+  select a.*,s.order_no invoice_number,s.total invoice_total,s.paid_amount,s.status invoice_status,
+   je.status journal_status,je.currency_code journal_currency,
+   exists(select 1 from public.journal_entries rev where rev.reversal_of_entry_id=a.journal_entry_id
+    and rev.company_id=c and rev.business_unit_id=b and rev.status='posted') reversed
+  from public.invoice_payment_allocations a
+  join public.sales_orders s on s.id=a.sales_order_id and s.company_id=c and s.business_unit_id=b
+  join public.journal_entries je on je.id=a.journal_entry_id and je.company_id=c and je.business_unit_id=b
+  where a.id=p_receipt_allocation_id and a.company_id=c and a.business_unit_id=b
+ ), classified as (
+  select r.sales_order_id,case when btrim(coalesce(t.owner_name_snapshot,''))='' then null::uuid
+      else coalesce(oa.partner_id,cfg.default_partner_id) end partner_id,
+   l.rate_snapshot+l.vat_snapshot gross,coalesce(l.is_adjustment,false) adjusted
+  from receipt r
+  join public.transport_customer_documents d on d.sales_order_id=r.sales_order_id and d.company_id=c and d.business_unit_id=b
+  join public.transport_customer_document_trips l on l.document_id=d.id and l.company_id=c and l.business_unit_id=b
+  join public.transport_trips t on t.id=l.trip_id and t.company_id=c and t.business_unit_id=b
+  join public.transport_collection_settings cfg on cfg.company_id=c and cfg.business_unit_id=b
+  left join public.transport_collection_owner_aliases oa on oa.company_id=c and oa.business_unit_id=b
+    and oa.owner_key=upper(regexp_replace(btrim(coalesce(t.owner_name_snapshot,'')),E'\\s+',' ','g'))
+ ), partner_gross as (
+  select partner_id,round(sum(gross),2) gross,count(*) trip_lines from classified group by partner_id
+ ), capacities as (
+  select p.partner_id,coalesce(m.name,'REVIEW REQUIRED') partner_name,p.gross,p.trip_lines,
+   coalesce((select sum(sh.amount) from public.transport_collection_receipt_shares sh
+     where sh.company_id=c and sh.business_unit_id=b and sh.sales_order_id=(select sales_order_id from receipt)
+       and sh.partner_id=p.partner_id and sh.receipt_allocation_id<>p_receipt_allocation_id),0) previously_linked,
+   round(p.gross-coalesce((select sum(sh.amount) from public.transport_collection_receipt_shares sh
+     where sh.company_id=c and sh.business_unit_id=b and sh.sales_order_id=(select sales_order_id from receipt)
+       and sh.partner_id=p.partner_id and sh.receipt_allocation_id<>p_receipt_allocation_id),0),2) capacity
+  from partner_gross p left join public.transport_collection_partners m on m.id=p.partner_id and m.company_id=c and m.business_unit_id=b
+ )
+ select jsonb_build_object('receipt', (select to_jsonb(r) from (
+   select id receipt_allocation_id,sales_order_id,invoice_number invoice_no,allocation_date,amount,reference,invoice_total,paid_amount,
+       invoice_status,journal_status,currency_code,reversed from receipt) r),
+  'partners',coalesce((select jsonb_agg(to_jsonb(x) order by x.partner_name,x.partner_id) from capacities x),'[]'::jsonb),
+  'source_trip_gross',coalesce((select round(sum(gross),2) from classified),0),
+  'has_adjustment',coalesce((select bool_or(adjusted) from classified),false),
+  'saved_shares',coalesce((select jsonb_agg(jsonb_build_object('partner_id',partner_id,'amount',amount,'evidence_reference',evidence_reference)
+      order by partner_id) from public.transport_collection_receipt_shares where receipt_allocation_id=p_receipt_allocation_id),'[]'::jsonb),
+  'prior_unlinked_count',(select count(*) from public.invoice_payment_allocations prev join receipt r on prev.sales_order_id=r.sales_order_id
+    where prev.company_id=c and prev.business_unit_id=b and (prev.allocation_date,prev.id)<(r.allocation_date,r.id)
+      and not exists(select 1 from public.transport_collection_receipt_shares sh where sh.receipt_allocation_id=prev.id)),
+  'canonical_invoice_allocation_total',(select coalesce(sum(a.amount),0) from public.invoice_payment_allocations a
+    where a.sales_order_id=(select sales_order_id from receipt) and a.company_id=c and a.business_unit_id=b)
+ ) into result;
+ if result->'receipt' is null or result->'receipt'='null'::jsonb then raise exception 'Posted receipt allocation not found in current workspace';end if;
+ return result;
+end $$;
+revoke all on function public.transport_collection_receipt_evidence(uuid) from public,anon;
+grant execute on function public.transport_collection_receipt_evidence(uuid) to authenticated;
+
+-- Permanent analytical link. Serialized by invoice row lock; one posted receipt allocation is never posted again.
+-- auto: computed on server using largest remainder / exact integer halalas.
+-- manual: explicit positive reviewed shares must total the canonical receipt allocation exactly.
+create function public.transport_collection_link_posted_receipt(
+ p_receipt_allocation_id uuid,p_method text,p_shares jsonb default '[]'::jsonb,p_evidence_reference text default ''
+) returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
+declare
+ c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();v_receipt public.invoice_payment_allocations%rowtype;
+ v_invoice public.sales_orders%rowtype;v_journal public.journal_entries%rowtype;
+ v_gross numeric;v_bad_owner boolean;v_adjusted boolean;v_partners integer;v_existing numeric;v_saved_count integer;
+ v_total_capacity bigint;v_cents bigint;v_shares jsonb;v_sum numeric;v_issues integer;v_prior_unlinked integer;
+ v_input_count integer;v_mismatch integer;v_source_conflict boolean;v_historical boolean;
+begin
+ if auth.uid() is null or c is null or b is null or p_receipt_allocation_id is null
+    or not public.has_module_permission(c,'transport','edit')
+    or not public.has_module_permission(c,'accounting','edit')
+    or not exists(select 1 from public.transport_collection_settings s where s.company_id=c and s.business_unit_id=b and s.enabled)
+ then raise exception 'Partner receipt allocation permission denied';end if;
+ perform pg_advisory_xact_lock(hashtextextended('partner-owner-map:'||c::text||':'||b::text,0));
+ if p_method not in ('auto','manual') or coalesce(length(p_evidence_reference),0)>160
+ then raise exception 'Invalid receipt allocation request';end if;
+ -- No other SQL writer may change this one canonical payment allocation during our transaction.
+ select * into v_receipt from public.invoice_payment_allocations
+ where id=p_receipt_allocation_id and company_id=c and business_unit_id=b;
+ if not found then raise exception 'Canonical customer receipt allocation not found';end if;
+ select * into v_invoice from public.sales_orders where id=v_receipt.sales_order_id and company_id=c and business_unit_id=b for update;
+ if not found then raise exception 'Canonical transport invoice unavailable';end if;
+ -- Invoice lock FIRST, then receipt lock: avoids two same-invoice link calls deadlocking.
+ select * into v_receipt from public.invoice_payment_allocations
+ where id=p_receipt_allocation_id and company_id=c and business_unit_id=b and sales_order_id=v_invoice.id for update;
+ if not found then raise exception 'Receipt invoice link changed during review';end if;
+ select * into v_journal from public.journal_entries
+ where id=v_receipt.journal_entry_id and company_id=c and business_unit_id=b;
+ if not found or v_journal.status<>'posted' or v_invoice.status<>'posted'
+  or exists(select 1 from public.journal_entries rev where rev.reversal_of_entry_id=v_journal.id and rev.status='posted' and rev.company_id=c and rev.business_unit_id=b)
+ then raise exception 'Receipt/invoice is not currently posted or has been reversed';end if;
+ if coalesce(v_receipt.currency_code,'SAR')<>'SAR' or coalesce(v_invoice.currency_code,'SAR')<>'SAR'
+  or coalesce(v_journal.currency_code,'SAR')<>'SAR' or coalesce(v_receipt.invoice_exchange_rate,1)<>1
+ then raise exception 'Only exact SAR canonical receipts supported';end if;
+ if v_receipt.amount is null or v_receipt.amount<=0 or v_receipt.amount<>round(v_receipt.amount,2)
+ then raise exception 'Receipt amount must be positive SAR with two decimals';end if;
+ if not exists(select 1 from public.transport_customer_documents d where d.sales_order_id=v_invoice.id and d.company_id=c and d.business_unit_id=b)
+ then raise exception 'This is not a posted Transport customer invoice';end if;
+ -- Lock all of the invoice's receipt allocations in a fixed order to prevent competing link races.
+ perform 1 from public.invoice_payment_allocations a where a.sales_order_id=v_invoice.id and a.company_id=c and a.business_unit_id=b order by a.id for update;
+ select count(*),coalesce(sum(amount),0) into v_saved_count,v_existing
+ from public.transport_collection_receipt_shares where receipt_allocation_id=v_receipt.id;
+ if v_saved_count>0 then raise exception 'This receipt is already permanently allocated: no overwrite or duplicate';end if;
+ select count(*) into v_prior_unlinked from public.invoice_payment_allocations prev
+ where prev.sales_order_id=v_invoice.id and prev.company_id=c and prev.business_unit_id=b
+ and (prev.allocation_date,prev.id)<(v_receipt.allocation_date,v_receipt.id)
+ and not exists(select 1 from public.transport_collection_receipt_shares sh where sh.receipt_allocation_id=prev.id);
+ -- Do not allow future allocations to consume unknown historical shares.
+ if v_prior_unlinked>0 then raise exception 'Earlier customer receipts require partner allocation first';end if;
+ with classification as (
+  select case when btrim(coalesce(t.owner_name_snapshot,''))='' then null::uuid
+   else coalesce(alias.partner_id,cfg.default_partner_id) end partner_id,
+   l.rate_snapshot+l.vat_snapshot gross,coalesce(l.is_adjustment,false) adjusted,
+   l.trip_id
+  from public.transport_customer_documents d
+  join public.transport_customer_document_trips l on l.document_id=d.id and l.company_id=c and l.business_unit_id=b
+  join public.transport_trips t on t.id=l.trip_id and t.company_id=c and t.business_unit_id=b
+  join public.transport_collection_settings cfg on cfg.company_id=c and cfg.business_unit_id=b and cfg.enabled
+  left join public.transport_collection_owner_aliases alias on alias.company_id=c and alias.business_unit_id=b
+   and alias.owner_key=upper(regexp_replace(btrim(coalesce(t.owner_name_snapshot,'')),E'\\s+',' ','g'))
+  where d.sales_order_id=v_invoice.id and d.company_id=c and d.business_unit_id=b
+ ) select coalesce(round(sum(gross),2),0),coalesce(bool_or(partner_id is null),true),coalesce(bool_or(adjusted),false),count(distinct partner_id)
+ into v_gross,v_bad_owner,v_adjusted,v_partners from classification;
+ if v_bad_owner or v_adjusted or v_partners=0 or v_gross<>v_invoice.total
+ then raise exception 'Invoice/Trip/Owner snapshot mismatch or adjustment requires separate review';end if;
+ if exists(select 1 from public.invoice_payment_allocations a
+   join public.journal_entries rev on rev.reversal_of_entry_id=a.journal_entry_id
+    and rev.company_id=c and rev.business_unit_id=b and rev.status='posted'
+   where a.sales_order_id=v_invoice.id and a.company_id=c and a.business_unit_id=b)
+ then raise exception 'Invoice has a reversed receipt: controlled reconciliation required';end if;
+ if coalesce(v_invoice.paid_amount,0)<>(select coalesce(sum(amount),0) from public.invoice_payment_allocations a
+  join public.journal_entries j on j.id=a.journal_entry_id and j.company_id=c and j.business_unit_id=b and j.status='posted'
+  where a.company_id=c and a.business_unit_id=b and a.sales_order_id=v_invoice.id)
+ then raise exception 'Canonical receipt totals mismatch';end if;
+ -- Imported opening is comparison only. Ambiguous historical cash/amount conflicts cannot silently become partner cash.
+ select exists(
+  select 1 from public.transport_customer_documents d
+  join public.transport_customer_document_trips l on l.document_id=d.id
+  join public.transport_opening_invoice_lines ol on ol.trip_id=l.trip_id and ol.side='customer'
+  join public.transport_opening_invoice_documents od on od.id=ol.document_id and od.side='customer' and od.company_id=c and od.business_unit_id=b
+  where d.sales_order_id=v_invoice.id and d.company_id=c and d.business_unit_id=b
+   and (abs(coalesce(l.rate_snapshot,0)-coalesce(ol.original_net,0))>0.01
+     or abs(coalesce(l.rate_snapshot,0)+coalesce(l.vat_snapshot,0)-coalesce(ol.original_gross,0))>0.01)
+ ) into v_source_conflict;
+ if v_source_conflict then raise exception 'Imported opening differs from posted invoice Trip; reconcile before receipt link';end if;
+ select exists(
+  select 1 from public.transport_customer_documents d
+  join public.transport_customer_document_trips l on l.document_id=d.id
+  join public.transport_historical_payment_effective h on h.trip_id=l.trip_id and h.company_id=c and h.business_unit_id=b
+  where d.sales_order_id=v_invoice.id and d.company_id=c and d.business_unit_id=b and coalesce(h.received_gross,0)>0
+ ) into v_historical;
+ if v_historical and p_method='auto' then raise exception 'Historical cash evidence requires documented manual allocation';end if;
+ if v_partners>1 and length(btrim(coalesce(p_evidence_reference,'')))<6
+ then raise exception 'Mixed partner receipt allocation needs a reviewed source reference';end if;
+ if v_historical and length(btrim(coalesce(p_evidence_reference,'')))<6
+ then raise exception 'Historical receipt source reference required';end if;
+ -- Validate server-side partner capacity against all previously linked real receipts of this invoice.
+ with classification as (
+  select case when btrim(coalesce(t.owner_name_snapshot,''))='' then null::uuid else coalesce(alias.partner_id,cfg.default_partner_id) end partner_id,
+         l.rate_snapshot+l.vat_snapshot gross
+  from public.transport_customer_documents d join public.transport_customer_document_trips l on l.document_id=d.id and l.company_id=c and l.business_unit_id=b
+  join public.transport_trips t on t.id=l.trip_id and t.company_id=c and t.business_unit_id=b
+  join public.transport_collection_settings cfg on cfg.company_id=c and cfg.business_unit_id=b and cfg.enabled
+  left join public.transport_collection_owner_aliases alias on alias.company_id=c and alias.business_unit_id=b
+    and alias.owner_key=upper(regexp_replace(btrim(coalesce(t.owner_name_snapshot,'')),E'\\s+',' ','g'))
+  where d.sales_order_id=v_invoice.id and d.company_id=c and d.business_unit_id=b
+ ), partners as (
+  select partner_id,round(sum(gross),2) gross from classification group by partner_id
+ ), remaining as (
+  select p.partner_id,p.gross,round(p.gross-coalesce(sum(sh.amount),0),2) capacity
+  from partners p left join public.transport_collection_receipt_shares sh
+   on sh.partner_id=p.partner_id and sh.sales_order_id=v_invoice.id and sh.company_id=c and sh.business_unit_id=b
+  group by p.partner_id,p.gross
+ ), integer_caps as (
+  select partner_id,gross,(capacity*100)::bigint cap from remaining
+ )
+ select coalesce(sum(cap),0) into v_total_capacity from integer_caps;
+ v_cents:=(v_receipt.amount*100)::bigint;
+ if v_total_capacity<v_cents or v_total_capacity<1 then raise exception 'Partner outstanding is below posted receipt amount';end if;
+ if p_method='auto' then
+  -- Deterministic largest-remainder split. Last halala is assigned by fraction then UUID.
+  with classification as (
+   select coalesce(alias.partner_id,cfg.default_partner_id) partner_id,l.rate_snapshot+l.vat_snapshot gross
+   from public.transport_customer_documents d join public.transport_customer_document_trips l on l.document_id=d.id and l.company_id=c and l.business_unit_id=b
+   join public.transport_trips t on t.id=l.trip_id and t.company_id=c and t.business_unit_id=b
+   join public.transport_collection_settings cfg on cfg.company_id=c and cfg.business_unit_id=b and cfg.enabled
+   left join public.transport_collection_owner_aliases alias on alias.company_id=c and alias.business_unit_id=b
+     and alias.owner_key=upper(regexp_replace(btrim(coalesce(t.owner_name_snapshot,'')),E'\\s+',' ','g'))
+   where d.sales_order_id=v_invoice.id and d.company_id=c and d.business_unit_id=b
+  ), partners as (select partner_id,round(sum(gross),2) gross from classification group by partner_id),
+  caps as (select p.partner_id,round((p.gross-coalesce(sum(sh.amount),0))*100,0)::bigint cap
+   from partners p left join public.transport_collection_receipt_shares sh
+    on sh.partner_id=p.partner_id and sh.sales_order_id=v_invoice.id and sh.company_id=c and sh.business_unit_id=b group by p.partner_id,p.gross),
+  quotas as (select partner_id,cap,floor(v_cents::numeric*cap/v_total_capacity)::bigint base,
+    (v_cents::numeric*cap % v_total_capacity) rem from caps),
+  ranked as (select *,row_number() over(order by rem desc,partner_id) ranked from quotas),
+  left_over as (select v_cents-sum(base) n from quotas),
+  final as (select partner_id, (base+case when ranked<=(select n from left_over) then 1 else 0 end)::numeric/100 amount from ranked)
+  select coalesce(jsonb_agg(jsonb_build_object('partner_id',partner_id,'amount',amount) order by partner_id),'[]'::jsonb)
+  into v_shares from final where amount>0;
+  -- The server-generated Auto result must match exactly what the user approved in preview.
+  -- Refuse stale proposed ratios rather than silently moving money to another partner.
+  if jsonb_typeof(p_shares)<>'array' then raise exception 'Auto preview shares are required';end if;
+  with expected as (select x.partner_id,x.amount from jsonb_to_recordset(v_shares) x(partner_id uuid,amount numeric)),
+  submitted as (select x.partner_id,x.amount from jsonb_to_recordset(p_shares) x(partner_id uuid,amount numeric))
+  select count(*) into v_mismatch from expected e full join submitted s on s.partner_id=e.partner_id
+  where e.partner_id is null or s.partner_id is null or e.amount<>s.amount;
+  if v_mismatch>0 or jsonb_array_length(p_shares)<>jsonb_array_length(v_shares)
+  then raise exception 'Receipt share preview is stale; refresh and review again';end if;
+ else
+  if jsonb_typeof(p_shares)<>'array' or jsonb_array_length(p_shares)<1 or jsonb_array_length(p_shares)>100
+  then raise exception 'Manual shares must be a nonempty array';end if;
+  v_shares:=p_shares;
+ end if;
+ -- Reject duplicates, missing/unknown partners, too many decimals, over-capacity and under/over-allocation.
+ with proposed as (
+  select x.partner_id,x.amount from jsonb_to_recordset(v_shares) as x(partner_id uuid,amount numeric)
+ ), classified as (
+  select coalesce(alias.partner_id,cfg.default_partner_id) partner_id,l.rate_snapshot+l.vat_snapshot gross
+  from public.transport_customer_documents d join public.transport_customer_document_trips l on l.document_id=d.id and l.company_id=c and l.business_unit_id=b
+  join public.transport_trips t on t.id=l.trip_id and t.company_id=c and t.business_unit_id=b
+  join public.transport_collection_settings cfg on cfg.company_id=c and cfg.business_unit_id=b and cfg.enabled
+  left join public.transport_collection_owner_aliases alias on alias.company_id=c and alias.business_unit_id=b
+    and alias.owner_key=upper(regexp_replace(btrim(coalesce(t.owner_name_snapshot,'')),E'\\s+',' ','g'))
+  where d.sales_order_id=v_invoice.id and d.company_id=c and d.business_unit_id=b
+ ), gross_by_partner as (select partner_id,round(sum(gross),2) gross from classified group by partner_id),
+ available as (select g.partner_id,round(g.gross-coalesce((select sum(sh.amount) from public.transport_collection_receipt_shares sh
+  where sh.sales_order_id=v_invoice.id and sh.partner_id=g.partner_id and sh.company_id=c and sh.business_unit_id=b),0),2) capacity
+  from gross_by_partner g)
+ select coalesce(sum(p.amount),0),count(*) filter(where p.partner_id is null or p.amount is null or p.amount<=0 or p.amount<>round(p.amount,2)
+      or a.partner_id is null or p.amount>a.capacity)
+      +(count(*)-count(distinct p.partner_id)) into v_sum,v_issues
+ from proposed p left join available a on a.partner_id=p.partner_id;
+ if v_issues<>0 or v_sum<>v_receipt.amount
+ then raise exception 'Partner split does not match exact posted receipt amount or available partner receivables';end if;
+ -- Immutable exact-row INSERT only; no posted/canonical mutations.
+ with proposed as (select x.partner_id,x.amount from jsonb_to_recordset(v_shares) as x(partner_id uuid,amount numeric)),
+ classified as (
+  select coalesce(alias.partner_id,cfg.default_partner_id) partner_id,l.rate_snapshot+l.vat_snapshot gross
+  from public.transport_customer_documents d join public.transport_customer_document_trips l on l.document_id=d.id and l.company_id=c and l.business_unit_id=b
+  join public.transport_trips t on t.id=l.trip_id and t.company_id=c and t.business_unit_id=b
+  join public.transport_collection_settings cfg on cfg.company_id=c and cfg.business_unit_id=b and cfg.enabled
+  left join public.transport_collection_owner_aliases alias on alias.company_id=c and alias.business_unit_id=b
+    and alias.owner_key=upper(regexp_replace(btrim(coalesce(t.owner_name_snapshot,'')),E'\\s+',' ','g'))
+  where d.sales_order_id=v_invoice.id and d.company_id=c and d.business_unit_id=b
+ ), gross_by_partner as (select partner_id,round(sum(gross),2) gross from classified group by partner_id)
+ insert into public.transport_collection_receipt_shares(company_id,business_unit_id,receipt_allocation_id,sales_order_id,partner_id,
+  amount,receipt_amount_snapshot,partner_gross_snapshot,allocation_method,evidence_reference,created_by)
+ select c,b,v_receipt.id,v_invoice.id,p.partner_id,p.amount,v_receipt.amount,g.gross,p_method,
+  btrim(coalesce(p_evidence_reference,'')),auth.uid() from proposed p join gross_by_partner g on g.partner_id=p.partner_id;
+ return jsonb_build_object('receipt_allocation_id',v_receipt.id,'invoice_id',v_invoice.id,'amount',v_receipt.amount,
+  'method',p_method,'shares',v_shares,'accounting_posted',false,'result','linked_immutable');
+end $$;
+revoke all on function public.transport_collection_link_posted_receipt(uuid,text,jsonb,text) from public,anon;
+grant execute on function public.transport_collection_link_posted_receipt(uuid,text,jsonb,text) to authenticated;
