+/** Partner running statement. All amounts are analytical, not second statutory invoices or GL. */
+import {useCallback,useEffect,useRef,useState} from 'react';
+import {supabase} from '@/lib/supabase';
+import {useAuth} from '@/auth/AuthContext';
+import {formatNaviloDate} from '@/lib/naviloDate';
+import PartnerMonthlyReport from './PartnerMonthlyReport';
+import PartnerSettlementPreview from './PartnerSettlementPreview';
+
+type Partner={id:string;name:string;code:string;is_active:boolean};
+type Statement={
+ partner_id:string;as_of:string|null;invoice_count:number;verified_invoice_count:number;review_invoice_count:number;
+ verified_billed:number;verified_received:number;verified_customer_outstanding:number;attributed_vat_due:number;
+ partner_vat_received:number;partner_vat_balance:number;partner_advances_paid:number;partner_transfers_paid:number;
+ cash_held_before_vat_reimbursement:number;payout_enabled:boolean;review_required:boolean;review_reasons:(string|null)[];
+};
+type Event={id:string;kind:'partner_advance'|'partner_transfer'|'partner_vat_received';amount:number;evidence_reference:string;created_at:string;journal_entry_id:string};
+const fmt=(value:unknown)=>Number(value??0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
+const types=[{key:'partner_transfer',label:'Partner Transfer — paid out'},{key:'partner_advance',label:'Partner Advance — paid out'},{key:'partner_vat_received',label:'Partner VAT — received in bank'}] as const;
+export default function PartnerRunningStatement({partners}:{partners:Partner[]}){
+ const {activeCompany,activeBusinessUnit,isPlatformOwner}=useAuth();
+ const role=activeBusinessUnit?.membership_role??activeCompany?.membership_role;
+ const canRequestLink=isPlatformOwner||role==='company_owner'||role==='admin';
+ const [selected,setSelected]=useState('');
+ const [summary,setSummary]=useState<Statement|null>(null),[events,setEvents]=useState<Event[]>([]);
+ const [loading,setLoading]=useState(false),[busy,setBusy]=useState(false),[error,setError]=useState(''),[notice,setNotice]=useState('');
+ const [kind,setKind]=useState<typeof types[number]['key']>('partner_transfer');
+ const [journal,setJournal]=useState(''),[reference,setReference]=useState('');
+ const company=activeCompany?.company_id,unit=activeBusinessUnit?.business_unit_id;
+ const generation=useRef(0);
+ const partnerId=partners.find(p=>p.id===selected&&p.is_active)?.id??partners.find(p=>p.is_active)?.id??'';
+ const load=useCallback(async()=>{
+  const token=++generation.current;setSummary(null);setEvents([]);
+  if(!partnerId||!company||!unit){setSummary(null);setEvents([]);return;}
+  setLoading(true);setError('');
+  try{const [s,e]=await Promise.all([
+   supabase.rpc('transport_collection_running_statement',{p_partner_id:partnerId,p_as_of:null}),
+   supabase.from('transport_collection_cash_evidence')
+    .select('id,kind,amount,evidence_reference,created_at,journal_entry_id')
+    .eq('company_id',company).eq('business_unit_id',unit).eq('partner_id',partnerId)
+    .order('created_at',{ascending:false}).limit(100)
+  ]);
+  if(generation.current!==token)return;
+  if(s.error||e.error){setSummary(null);setEvents([]);setError(s.error?.message??e.error?.message??'Statement unavailable');}
+  else {setSummary(s.data as Statement);setEvents((e.data??[]) as Event[]);}
+  }catch(e){if(generation.current===token)setError((e as Error).message||'Statement unavailable');}
+  finally{if(generation.current===token)setLoading(false);}
+ },[partnerId,company,unit]);
+ useEffect(()=>{void load();const changed=()=>{void load();};window.addEventListener('navilo:partner-change',changed);return()=>{generation.current++;window.removeEventListener('navilo:partner-change',changed);};},[load]);
+ async function linkExistingPostedJournal(){
+  if(!canRequestLink||!partnerId||busy||!journal.trim()||reference.trim().length<6)return;
+  setBusy(true);setError('');setNotice('');
+  try{
+   const {error:e}=await supabase.rpc('transport_collection_link_posted_cash_evidence',{
+    p_partner_id:partnerId,p_kind:kind,p_journal_entry_id:journal.trim(),p_evidence_reference:reference.trim()
+   });
+   if(e)throw e;
+   setNotice('Existing posted bank/cash journal linked as immutable partner evidence. No new payment or GL posted.');
+   setJournal('');setReference('');await load();
+  }catch(e){setError((e as Error).message??'Cannot link journal. Check approved mapping and posting evidence.');}
+  finally{setBusy(false);}
+ }
+ return <section className="space-y-2 rounded border bg-white p-3 text-xs">
+  <header className="flex flex-wrap items-start justify-between gap-2">
+   <div><h3 className="text-sm font-bold">Partner Running Statement · Receivables, Collections, Transfers &amp; VAT</h3>
+    <p className="text-slate-600">Posted source references only. Partner advances and transfers reduce held collection; VAT reimbursement is separate.</p></div>
+   <button className="btn h-8" onClick={()=>void load()} disabled={loading||busy}>Refresh</button>
+  </header>
+  <div className="flex flex-wrap items-end gap-2">
+   <label className="grid gap-1">Partner<select className="input h-8" value={partnerId} onChange={e=>setSelected(e.target.value)}>{partners.filter(p=>p.is_active).map(p=><option value={p.id} key={p.id}>{p.name}</option>)}</select></label>
+   <span className="rounded border bg-slate-50 px-2 py-1 text-slate-600">Current balance only · dated cutoffs not yet verified</span>
+   <span className="rounded border bg-slate-50 px-2 py-1 text-slate-600">SAR · Analytical subledger</span>
+  </div>
+  {error&&<p role="alert" className="rounded bg-red-50 p-2 text-red-800">{error}</p>}
+  {notice&&<p role="status" className="rounded bg-green-50 p-2 text-green-800">{notice}</p>}
+  {loading&&<p role="status">Loading partner source evidence…</p>}
+  {summary&&!loading&&<>
+   <div className="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
+    {[
+      ['Verified Sales / Receivables',summary.verified_billed],
+      ['Customer Received',summary.verified_received],
+      ['Customer Outstanding',summary.verified_customer_outstanding],
+      ['Partner Advances Paid',summary.partner_advances_paid],
+      ['Partner Transfers Paid',summary.partner_transfers_paid],
+      ['Collections Held (provisional)',summary.cash_held_before_vat_reimbursement],
+      ['VAT Attributable (not a tax return)',summary.attributed_vat_due],
+      ['VAT Received from Partner',summary.partner_vat_received]
+    ].map(([label,val])=><div key={String(label)} className="rounded border bg-slate-50 p-2"><span className="text-slate-600">{label}</span><p className="font-semibold tabular-nums">{fmt(val)}</p></div>)}
+   </div>
+   <p className="rounded border p-2">Partner VAT balance (separate from collection payable): <strong>SAR {fmt(summary.partner_vat_balance)}</strong>. Review invoices: <strong>{summary.review_invoice_count}</strong> / {summary.invoice_count}.</p>
+   {summary.review_required&&<p role="alert" className="rounded border border-amber-300 bg-amber-50 p-2 text-amber-900">Review Required: {summary.review_reasons.filter(Boolean).join(' · ')||'Source reconciliation is pending'}. Totals are provisional and must not authorize a payout.</p>}
+   <p className="rounded bg-slate-100 p-2 font-medium">This source statement is analytical. Use the Partner Payments workflow for approved GL-backed postings and advance adjustments.</p>
+   <PartnerSettlementPreview statement={summary}/>
+  </>}
+  <PartnerMonthlyReport partnerId={partnerId}/>
+  <div className="overflow-auto rounded border"><table className="w-full min-w-[720px] text-xs"><thead className="bg-slate-50"><tr><th className="p-2 text-left">Evidence linked</th><th className="p-2 text-left">Kind</th><th className="p-2 text-right">Amount SAR</th><th className="p-2 text-left">Journal ID</th><th className="p-2 text-left">Source reference</th></tr></thead><tbody>
+   {events.map(e=><tr className="border-t" key={e.id}><td className="p-2">{formatNaviloDate(e.created_at?.slice(0,10)??'')}</td><td className="p-2">{types.find(t=>t.key===e.kind)?.label??e.kind}</td><td className="p-2 text-right tabular-nums">{fmt(e.amount)}</td><td className="p-2 font-mono">{e.journal_entry_id}</td><td className="p-2">{e.evidence_reference}</td></tr>)}
+   {!events.length&&<tr><td colSpan={5} className="p-3 text-center text-slate-500">No linked posted partner cash evidence.</td></tr>}
+  </tbody></table></div>
+  {canRequestLink&&<div className="rounded border p-2 space-y-2"><h4 className="font-semibold">Link an existing posted cash/bank journal (no new payment)</h4>
+   <p className="text-slate-600">Only works after approved partner Chart of Accounts mapping. Journal must be SAR, exactly two balanced lines, same tenant, and not a customer/supplier receipt or already linked journal.</p>
+   <div className="flex flex-wrap items-end gap-2">
+    <label className="grid gap-1">Movement<select className="input h-8" value={kind} onChange={e=>setKind(e.target.value as typeof kind)}>{types.map(t=><option key={t.key} value={t.key}>{t.label}</option>)}</select></label>
+    <label className="grid gap-1">Posted journal UUID<input className="input h-8 min-w-56" value={journal} onChange={e=>setJournal(e.target.value)} placeholder="Existing journal ID"/></label>
+    <label className="grid gap-1">Bank transfer / VAT reference<input className="input h-8 min-w-56" maxLength={160} value={reference} onChange={e=>setReference(e.target.value)} placeholder="Bank reference (6+ chars)"/></label>
+    <button className="btn h-8" onClick={()=>void linkExistingPostedJournal()} disabled={busy||!journal||reference.trim().length<6}>Review &amp; Link Posted Evidence</button>
+   </div>
+  </div>}
+  <p className="text-slate-600">This is not a substitute for ZATCA returns or Twakkal statutory GL. Do not link historical supplier rent payments as partner transfers.</p>
+ </section>;
+}
