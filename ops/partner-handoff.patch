+/** Professional operational labels; never expose import-layer implementation terms in reports. */
+const labels:Record<string,string>={
+ NOT_POSTED:'Invoice is not posted',
+ MISSING_TRIPS:'Invoice has no linked Trips',
+ UNATTRIBUTED_OWNER:'Trip owner needs mapping',
+ INVALID_EVIDENCE:'Invoice amount needs review',
+ LINE_TOTAL_MISMATCH:'Invoice and Trip amounts differ',
+ INVOICE_TRIP_MISMATCH:'Invoice and Trip amounts differ',
+ PAYMENT_TIEOUT_MISMATCH:'Posted receipt needs reconciliation',
+ CANONICAL_RECEIPT_MISMATCH:'Posted receipt needs reconciliation',
+ OVERPAYMENT:'Receipt exceeds invoice amount',
+ OPENING_SOURCE_CONFLICT:'Invoice source amounts differ',
+ ADJUSTMENT_REVIEW:'Invoice adjustment needs review',
+ REVERSED_RECEIPT_REVIEW:'Receipt reversal needs review',
+ REVERSAL_REVIEW:'Receipt reversal needs review',
+ MIXED_PARTNER_PRIOR_RECEIPT:'Previous receipt needs partner allocation',
+ HISTORICAL_RECEIPT_REVIEW:'Previous customer collection needs reconciliation',
+ OPENING_SETTLEMENT_REVIEW:'Previous settlement needs reconciliation',
+};
+export function partnerReviewLabel(flag:string):string{return labels[flag]??'Payment evidence needs review';}
diff --git a/src/modules/transport/partnerRunningAccount.ts b/src/modules/transport/partnerRunningAccount.ts
new file mode 100644
index 00000000..0a13be57
--- /dev/null
+++ b/src/modules/transport/partnerRunningAccount.ts
@@ -0,0 +1,106 @@
+/**
+ * Twakkal analytical PARTNER COLLECTION running account. Currency: integer SAR halalas.
+ * NEVER writes official Sales, customer AR, VAT, GL, bank, cash or invoices.
+ * Receipts are canonical posted invoice_payment_allocations evidence, not another cash entry.
+ * Advances/transfers/VAT reimbursements must be backed by a DIFFERENT posted bank/cash journal.
+ */
+export type PartnerInvoice = {
+  invoiceId: string; partnerId: string; gross: number; vat: number;
+  verified: boolean; reviewReasons?: readonly string[];
+};
+export type CollectionLink = {
+  receiptAllocationId: string; invoiceId: string; partnerId: string; amount: number;
+  posted: boolean; reversed: boolean;
+};
+export type CashEvidenceType = 'partner_advance' | 'partner_transfer' | 'partner_vat_received';
+export type PartnerCashEvidence = {
+  evidenceId: string; journalEntryId: string; partnerId: string;
+  kind: CashEvidenceType; amount: number; posted: boolean; reversed: boolean;
+  date: string; reference: string;
+};
+export type RunningStatement = {
+  partnerId: string;
+  billedGross: number; vatDue: number; customerReceived: number; customerOutstanding: number;
+  partnerAdvances: number; partnerTransfers: number; vatReceived: number; vatOutstanding: number;
+  collectedCashHeld: number; transferable: number | null; reviewRequired: boolean; flags: string[];
+};
+function validHalalas(n: number, name: string): number {
+  if (!Number.isSafeInteger(n) || n < 0) throw new Error(`Invalid ${name} halalas`);
+  return n;
+}
+function safeSum(a: number, b: number): number {
+  const sum = a + b;
+  if (!Number.isSafeInteger(sum)) throw new Error('Money total overflow');
+  return sum;
+}
+function requireId(s: string, label: string): void {
+  if (!s || !s.trim()) throw new Error(`Missing ${label}`);
+}
+export function buildPartnerRunningStatement(input: {
+  partnerId: string; invoices: readonly PartnerInvoice[];
+  receipts: readonly CollectionLink[]; cashEvents: readonly PartnerCashEvidence[];
+  historicalEvidenceCleared: boolean; openingBalanceConfirmed: boolean;
+}): RunningStatement {
+  const {partnerId,invoices,receipts,cashEvents} = input;
+  requireId(partnerId,'partner');
+  const flags = new Set<string>();
+  if (!input.historicalEvidenceCleared) flags.add('HISTORICAL_COLLECTION_REVIEW');
+  if (!input.openingBalanceConfirmed) flags.add('OPENING_BALANCE_UNCONFIRMED');
+  let billedGross=0,vatDue=0,customerReceived=0,partnerAdvances=0,partnerTransfers=0,vatReceived=0;
+  const invoiceGross = new Map<string,number>(), receivedByInvoice = new Map<string,number>();
+  for (const invoice of invoices) {
+    if (invoice.partnerId !== partnerId) throw new Error('Cross-partner invoice supplied');
+    requireId(invoice.invoiceId,'invoice ID');
+    const gross=validHalalas(invoice.gross,'invoice gross'),vat=validHalalas(invoice.vat,'VAT');
+    if (vat > gross) throw new Error('VAT exceeds invoice gross');
+    if (invoiceGross.has(invoice.invoiceId)) throw new Error('Duplicate invoice/partner row');
+    invoiceGross.set(invoice.invoiceId,gross);
+    billedGross=safeSum(billedGross,gross);
+    vatDue=safeSum(vatDue,vat);
+    if (!invoice.verified || (invoice.reviewReasons?.length ?? 0)>0) flags.add('INVOICE_REVIEW_REQUIRED');
+  }
+  const receiptIds = new Set<string>();
+  for (const r of receipts) {
+    if (r.partnerId!==partnerId) throw new Error('Cross-partner receipt supplied');
+    requireId(r.receiptAllocationId,'canonical receipt allocation ID');
+    requireId(r.invoiceId,'receipt invoice ID');
+    if (receiptIds.has(r.receiptAllocationId)) throw new Error('Duplicate canonical receipt allocation');
+    receiptIds.add(r.receiptAllocationId);
+    validHalalas(r.amount,'receipt');
+    if (!invoiceGross.has(r.invoiceId)) {flags.add('RECEIPT_INVOICE_NOT_RECONCILED');continue;}
+    if (!r.posted||r.reversed) {flags.add('RECEIPT_POSTING_REVIEW');continue;}
+    receivedByInvoice.set(r.invoiceId,safeSum(receivedByInvoice.get(r.invoiceId)??0,r.amount));
+    customerReceived=safeSum(customerReceived,r.amount);
+  }
+  for(const [id,received] of receivedByInvoice) {
+    if (received>(invoiceGross.get(id)??0)) flags.add('INVOICE_OVER_COLLECTION');
+  }
+  const journalIds=new Set<string>(), eventIds=new Set<string>();
+  for (const e of cashEvents) {
+    if (e.partnerId!==partnerId) throw new Error('Cross-partner cash evidence supplied');
+    requireId(e.evidenceId,'evidence ID');requireId(e.journalEntryId,'posted journal ID');
+    if (journalIds.has(e.journalEntryId)||eventIds.has(e.evidenceId)) throw new Error('Duplicate partner cash evidence');
+    journalIds.add(e.journalEntryId);eventIds.add(e.evidenceId);
+    validHalalas(e.amount,'partner cash event');
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(e.date)||!e.reference.trim()) flags.add('CASH_EVIDENCE_REFERENCE_REVIEW');
+    if (!e.posted||e.reversed) {flags.add('CASH_EVIDENCE_POSTING_REVIEW');continue;}
+    if(e.kind==='partner_advance')partnerAdvances=safeSum(partnerAdvances,e.amount);
+    else if(e.kind==='partner_transfer')partnerTransfers=safeSum(partnerTransfers,e.amount);
+    else if(e.kind==='partner_vat_received')vatReceived=safeSum(vatReceived,e.amount);
+    else throw new Error('Invalid partner cash event type');
+  }
+  const customerOutstanding=billedGross-customerReceived;
+  const collectedCashHeld=customerReceived-partnerAdvances-partnerTransfers;
+  const vatOutstanding=vatDue-vatReceived;
+  if(customerOutstanding<0)flags.add('NEGATIVE_CUSTOMER_OUTSTANDING');
+  if(collectedCashHeld<0)flags.add('PARTNER_ADVANCE_EXCEEDS_COLLECTION');
+  if(vatOutstanding<0)flags.add('PARTNER_VAT_CREDIT_REVIEW');
+  const reviewRequired=flags.size>0;
+  return {partnerId,billedGross,vatDue,customerReceived,customerOutstanding,
+    partnerAdvances,partnerTransfers,vatReceived,vatOutstanding,collectedCashHeld,
+    transferable:reviewRequired?null:collectedCashHeld,reviewRequired,flags:[...flags].sort()};
+}
+/** Possible net receivable from partner when an advance precedes receipts; not an asset posting. */
+export function partnerAdvanceUnrecovered(s:RunningStatement):number {
+  return Math.max(0,-s.collectedCashHeld);
+}
