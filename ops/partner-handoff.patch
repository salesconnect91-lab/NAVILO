+-- Source stage: partner_collection_stage5_LINKED_LEDGER_REVIEW.sql
+-- NAVILO Partner Collection & Settlement -- STAGE 5 LINK-AWARE LEDGER REPLACEMENT REVIEW ONLY.
+-- REQUIRES Stage 2, Stage 3, Stage 4 and Stage 5 receipt-share schema. Do not apply to production.
+-- Never run against production before isolated database, permissions and performance tests.
+-- Does NOT create customer receipt, AR, partner payout, journal, VAT or GL movements.
+-- Native posted sales invoice source wins; imported opening document is comparison ONLY.
+
+create or replace function public.transport_collection_partner_invoice_ledger(
+ p_partner_id uuid,
+ p_from date default null,
+ p_to date default null,
+ p_search text default '',
+ p_limit integer default 50,
+ p_offset integer default 0
+) returns jsonb
+language plpgsql stable security definer set search_path=public,pg_temp as $$
+declare
+ c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();
+ v_result jsonb;
+begin
+ if auth.uid() is null or c is null or b is null or p_partner_id is null
+  or not public.has_module_permission(c,'transport','view')
+  or not public.has_module_permission(c,'accounting','view')
+  or not exists(select 1 from public.transport_collection_settings cfg
+   where cfg.company_id=c and cfg.business_unit_id=b and cfg.enabled)
+ then raise exception 'Partner Collections ledger permission denied';end if;
+ if not exists(select 1 from public.transport_collection_partners p
+   where p.id=p_partner_id and p.company_id=c and p.business_unit_id=b and p.is_active)
+ then raise exception 'Active partner unavailable in current workspace';end if;
+ if p_from is not null and p_to is not null and p_from>p_to
+ then raise exception 'From date cannot exceed To date';end if;
+ if length(coalesce(p_search,''))>100 then raise exception 'Invoice search is too long';end if;
+
+ with classified as (
+  select d.sales_order_id,l.trip_id,l.rate_snapshot net,l.vat_snapshot vat,
+   coalesce(l.is_adjustment,false) is_adjustment,
+   case when btrim(coalesce(t.owner_name_snapshot,''))='' then null::uuid
+        else coalesce(a.partner_id,cfg.default_partner_id) end partner_id
+  from public.transport_customer_documents d
+  join public.sales_orders s on s.id=d.sales_order_id and s.company_id=c and s.business_unit_id=b
+  join public.transport_customer_document_trips l on l.document_id=d.id
+       and l.company_id=c and l.business_unit_id=b
+  join public.transport_trips t on t.id=l.trip_id and t.company_id=c and t.business_unit_id=b
+  join public.transport_collection_settings cfg on cfg.company_id=c and cfg.business_unit_id=b and cfg.enabled
+  left join public.transport_collection_owner_aliases a
+      on a.company_id=c and a.business_unit_id=b
+     and a.owner_key=upper(regexp_replace(btrim(coalesce(t.owner_name_snapshot,'')),E'\\s+',' ','g'))
+  where d.company_id=c and d.business_unit_id=b
+    and (p_from is null or s.order_date>=p_from)
+    and (p_to is null or s.order_date<=p_to)
+    and (btrim(coalesce(p_search,''))='' or s.order_no ilike '%'||btrim(p_search)||'%')
+ ), target_invoices as (
+   select distinct sales_order_id from classified where partner_id=p_partner_id
+ ), native_lines as (
+  select l.* from classified l join target_invoices ti on ti.sales_order_id=l.sales_order_id
+ ), by_partner as (
+  select sales_order_id,partner_id,round(sum(net),2) net,round(sum(vat),2) vat,
+         round(sum(net+vat),2) gross,count(*)::integer trip_lines
+  from native_lines group by sales_order_id,partner_id
+ ), invoice_stats as (
+  select sales_order_id,round(sum(net+vat),2) lines_gross,
+       count(distinct partner_id)::integer partner_count,
+       bool_or(partner_id is null) missing_partner,
+       bool_or(is_adjustment) adjusted
+  from native_lines group by sales_order_id
+ ), native_by_trip as (
+  select sales_order_id,trip_id,round(sum(net),2) net,round(sum(net+vat),2) gross
+  from native_lines group by sales_order_id,trip_id
+ ), opening_by_trip as (
+  select ol.trip_id,round(sum(ol.original_net),2) net,round(sum(ol.original_gross),2) gross,
+   bool_or(coalesce(od.historical_settled,0)>0) settled
+  from public.transport_opening_invoice_lines ol
+  join public.transport_opening_invoice_documents od on od.id=ol.document_id
+    and od.company_id=c and od.business_unit_id=b and od.side='customer'
+  where ol.side='customer' and ol.trip_id in (select trip_id from native_by_trip)
+  group by ol.trip_id
+ ), source_checks as (
+  select nt.sales_order_id,
+   bool_or(op.trip_id is not null and (abs(nt.net-op.net)>0.01 or abs(nt.gross-op.gross)>0.01)) opening_mismatch,
+   bool_or(coalesce(op.settled,false)) opening_settled,
+   bool_or(coalesce(h.received_gross,0)>0.01) historical_received
+  from native_by_trip nt
+  left join opening_by_trip op on op.trip_id=nt.trip_id
+  left join public.transport_historical_payment_effective h on h.trip_id=nt.trip_id
+   and h.company_id=c and h.business_unit_id=b
+  group by nt.sales_order_id
+ ), received as (
+  select al.sales_order_id,
+   round(coalesce(sum(al.amount) filter(where j.status='posted'),0),2) received,
+   count(*)::integer allocation_rows,
+   count(*) filter(where exists(select 1 from public.transport_collection_receipt_shares sh where sh.receipt_allocation_id=al.id and sh.company_id=c and sh.business_unit_id=b))::integer linked_rows,
+   round(coalesce(sum((select sum(sh.amount) from public.transport_collection_receipt_shares sh where sh.receipt_allocation_id=al.id and sh.company_id=c and sh.business_unit_id=b)),0),2) linked_gross,
+   round(coalesce(sum((select sum(sh.amount) from public.transport_collection_receipt_shares sh where sh.receipt_allocation_id=al.id and sh.company_id=c and sh.business_unit_id=b and sh.partner_id=p_partner_id)),0),2) linked_partner,
+   bool_or(coalesce(exists(
+     select 1 from public.journal_entries reversal
+     where reversal.reversal_of_entry_id=al.journal_entry_id
+       and reversal.company_id=c and reversal.business_unit_id=b and reversal.status='posted'),false)) has_reversal
+  from public.invoice_payment_allocations al
+  left join public.journal_entries j on j.id=al.journal_entry_id
+      and j.company_id=c and j.business_unit_id=b
+  where al.company_id=c and al.business_unit_id=b
+    and al.sales_order_id in(select sales_order_id from target_invoices)
+  group by al.sales_order_id
+ ), raw as (
+  select s.id invoice_id,s.order_no::text invoice_no,s.order_date invoice_date,
+   s.status::text status,round(coalesce(s.total,0),2) invoice_gross,
+   round(coalesce(s.paid_amount,0),2) canonical_paid,
+   coalesce(r.received,0) posted_allocated,
+   coalesce(r.linked_rows,0) linked_rows,coalesce(r.allocation_rows,0) allocation_rows,
+   coalesce(r.linked_gross,0) linked_gross,coalesce(r.linked_partner,0) linked_partner,
+   bp.net partner_net,bp.vat partner_vat,bp.gross partner_gross,bp.trip_lines,
+   st.lines_gross,st.partner_count,st.missing_partner,st.adjusted,
+   coalesce(sc.opening_mismatch,false) opening_mismatch,
+   coalesce(sc.opening_settled,false) opening_settled,
+   coalesce(sc.historical_received,false) historical_received,
+   coalesce(r.has_reversal,false) reversed_receipt
+  from target_invoices ti
+  join public.sales_orders s on s.id=ti.sales_order_id and s.company_id=c and s.business_unit_id=b
+  join by_partner bp on bp.sales_order_id=s.id and bp.partner_id=p_partner_id
+  join invoice_stats st on st.sales_order_id=s.id
+  left join source_checks sc on sc.sales_order_id=s.id
+  left join received r on r.sales_order_id=s.id
+ ), flagged as (
+  select raw.*,array_remove(array[
+   case when status<>'posted' then 'NOT_POSTED' end,
+   case when partner_gross<0 or invoice_gross<0 or partner_gross>invoice_gross then 'INVALID_EVIDENCE' end,
+   case when missing_partner then 'UNATTRIBUTED_OWNER' end,
+   case when abs(lines_gross-invoice_gross)>0.01 then 'INVOICE_TRIP_MISMATCH' end,
+   case when abs(canonical_paid-posted_allocated)>0.01 then 'CANONICAL_RECEIPT_MISMATCH' end,
+   case when canonical_paid>invoice_gross+0.01 or linked_partner>partner_gross+0.01 then 'OVERPAYMENT' end,
+   case when opening_mismatch then 'OPENING_SOURCE_CONFLICT' end,
+   case when historical_received then 'HISTORICAL_RECEIPT_REVIEW' end,
+   case when opening_settled then 'OPENING_SETTLEMENT_REVIEW' end,
+   case when adjusted then 'ADJUSTMENT_REVIEW' end,
+   case when reversed_receipt then 'REVERSAL_REVIEW' end,
+   case when partner_count>1 and canonical_paid>0
+     and (linked_rows<>allocation_rows or abs(linked_gross-canonical_paid)>0.01) then 'MIXED_PARTNER_PRIOR_RECEIPT' end
+  ]::text[],null::text) flags
+  from raw
+ ), reconciled as (
+  select flagged.*,
+   cardinality(flags)=0 verified,
+   case when cardinality(flags)=0 then
+     case when partner_count=1 then canonical_paid else linked_partner end
+    else null::numeric end partner_received,
+   case when cardinality(flags)=0 then
+     partner_gross-(case when partner_count=1 then canonical_paid else linked_partner end)
+    else null::numeric end partner_outstanding
+  from flagged
+ ), page_rows as (
+  select * from reconciled
+  order by invoice_date desc,invoice_no desc,invoice_id
+  limit least(greatest(coalesce(p_limit,50),1),100)
+  offset least(greatest(coalesce(p_offset,0),0),20000)
+ )
+ select jsonb_build_object(
+  'partner_id',p_partner_id,
+  'invoice_count',count(*),
+  'verified_invoice_count',count(*) filter(where verified),
+  'review_invoice_count',count(*) filter(where not verified),
+  'verified_billed',round(coalesce(sum(partner_gross) filter(where verified),0),2),
+  'verified_received',round(coalesce(sum(partner_received) filter(where verified),0),2),
+  'verified_outstanding',round(coalesce(sum(partner_outstanding) filter(where verified),0),2),
+  'review_billed',round(coalesce(sum(partner_gross) filter(where not verified),0),2),
+  'rows',(select coalesce(jsonb_agg(to_jsonb(page_rows) order by invoice_date desc,invoice_no desc,invoice_id),'[]'::jsonb) from page_rows)
+ ) into v_result from reconciled;
+ return coalesce(v_result,'{}'::jsonb);
+end $$;
+revoke all on function public.transport_collection_partner_invoice_ledger(uuid,date,date,text,integer,integer) from public,anon;
+grant execute on function public.transport_collection_partner_invoice_ledger(uuid,date,date,text,integer,integer) to authenticated;
+
+-- Source stage: partner_collection_stage6_POSTED_CASH_EVIDENCE_REVIEW.sql
+-- STAGE 6 / ISOLATED TEST REVIEW ONLY. NOT A PRODUCTION MIGRATION.
+-- Dependency: Stage 2 -> 3 -> 4 -> 5 receipt links -> Stage 5 linked ledger.
+-- LINKS ONE ALREADY-POSTED TWO-LINE SAR CASH/BANK JOURNAL. Does not post cash, bank, VAT, AR or P&L.
+-- Do not mark a partner as paid without the matching canonical posted journal + approved accounting mapping.
+
+create table public.transport_collection_finance_mapping (
+ company_id uuid not null references public.companies(id),
+ business_unit_id uuid not null references public.business_units(id),
+ partner_payable_account_id uuid not null references public.chart_of_accounts(id),
+ partner_advance_account_id uuid not null references public.chart_of_accounts(id),
+ partner_vat_receivable_account_id uuid not null references public.chart_of_accounts(id),
+ reviewed_by uuid not null references auth.users(id),
+ reviewed_at timestamptz not null default clock_timestamp(),
+ is_approved boolean not null default false,
+ primary key(company_id,business_unit_id),
+ check(partner_payable_account_id<>partner_advance_account_id
+  and partner_payable_account_id<>partner_vat_receivable_account_id
+  and partner_advance_account_id<>partner_vat_receivable_account_id)
+);
+alter table public.transport_collection_finance_mapping enable row level security;
+revoke all on public.transport_collection_finance_mapping from public,anon,authenticated;
+grant select on public.transport_collection_finance_mapping to authenticated;
+create policy transport_collection_mapping_view on public.transport_collection_finance_mapping
+ for select to authenticated using(company_id=public.current_company_id() and business_unit_id=public.current_business_unit_id()
+ and public.has_module_permission(company_id,'accounting','view')
+ and public.has_module_permission(company_id,'transport','view'));
+-- No client or public RPC writes to mapping; accounting controls and principal/agent treatment
+-- must be approved independently before a future controlled mapping activation migration.
+
+create table public.transport_collection_cash_evidence (
+ id uuid primary key default gen_random_uuid(),
+ company_id uuid not null references public.companies(id),
+ business_unit_id uuid not null references public.business_units(id),
+ partner_id uuid not null,
+ journal_entry_id uuid not null unique references public.journal_entries(id),
+ kind text not null check(kind in ('partner_advance','partner_transfer','partner_vat_received')),
+ amount numeric(18,2) not null check(amount>0),
+ evidence_reference text not null check(length(btrim(evidence_reference)) between 6 and 160),
+ created_at timestamptz not null default clock_timestamp(),
+ created_by uuid not null references auth.users(id),
+ foreign key(partner_id,company_id,business_unit_id)
+  references public.transport_collection_partners(id,company_id,business_unit_id)
+);
+create index transport_collection_cash_evidence_partner_idx
+ on public.transport_collection_cash_evidence(company_id,business_unit_id,partner_id,created_at);
+alter table public.transport_collection_cash_evidence enable row level security;
+revoke all on public.transport_collection_cash_evidence from public,anon,authenticated;
+grant select on public.transport_collection_cash_evidence to authenticated;
+create policy transport_collection_cash_evidence_view on public.transport_collection_cash_evidence
+ for select to authenticated using(company_id=public.current_company_id() and business_unit_id=public.current_business_unit_id()
+ and public.has_module_permission(company_id,'accounting','view')
+ and public.has_module_permission(company_id,'transport','view'));
+
+create function public.transport_collection_cash_evidence_immutable() returns trigger
+language plpgsql set search_path=public,pg_temp as $$
+begin raise exception 'Partner settlement cash evidence immutable: use separately reviewed reversal/supersession'; end $$;
+create trigger transport_collection_cash_evidence_no_mutation
+ before update or delete on public.transport_collection_cash_evidence
+ for each row execute function public.transport_collection_cash_evidence_immutable();
+revoke all on function public.transport_collection_cash_evidence_immutable() from public,anon,authenticated;
+
+-- This is EVIDENCE LINKING, not new payment creation. Explicit approved mapping required.
+create function public.transport_collection_link_posted_cash_evidence(
+ p_partner_id uuid,p_kind text,p_journal_entry_id uuid,p_evidence_reference text
+) returns uuid language plpgsql security definer set search_path=public,pg_temp as $$
+declare
+ c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();
+ v_mapping public.transport_collection_finance_mapping%rowtype;
+ v_journal public.journal_entries%rowtype;
+ v_line_count integer;v_cash_count integer;v_counterpart_count integer;
+ v_cash_account uuid;v_counterpart_account uuid;v_cash_debit numeric;v_cash_credit numeric;
+ v_counter_debit numeric;v_counter_credit numeric;v_amount numeric;
+ v_counter_type text;v_id uuid;
+begin
+ if auth.uid() is null or c is null or b is null
+  or not public.has_module_permission(c,'transport','edit')
+  or not public.has_module_permission(c,'accounting','edit')
+  or not exists(select 1 from public.transport_collection_settings s
+   where s.company_id=c and s.business_unit_id=b and s.enabled)
+ then raise exception 'Partner settlement evidence edit permission denied'; end if;
+ if p_kind not in('partner_advance','partner_transfer','partner_vat_received')
+  or p_journal_entry_id is null or p_partner_id is null
+  or length(btrim(coalesce(p_evidence_reference,''))) not between 6 and 160
+ then raise exception 'Invalid cash evidence request'; end if;
+ if not exists(select 1 from public.transport_collection_partners p
+   where p.id=p_partner_id and p.company_id=c and p.business_unit_id=b and p.is_active)
+ then raise exception 'Partner not in current Transport scope'; end if;
+ select * into v_mapping from public.transport_collection_finance_mapping m
+  where m.company_id=c and m.business_unit_id=b and m.is_approved for share;
+ if not found then raise exception 'Approved partner GL account mapping required';end if;
+ v_counterpart_account:=case p_kind when 'partner_transfer' then v_mapping.partner_payable_account_id
+  when 'partner_advance' then v_mapping.partner_advance_account_id
+  else v_mapping.partner_vat_receivable_account_id end;
+ select type into v_counter_type from public.chart_of_accounts
+  where id=v_counterpart_account and company_id=c and is_active and not is_group;
+ if not found or (p_kind='partner_transfer' and v_counter_type<>'liability')
+  or (p_kind in('partner_advance','partner_vat_received') and v_counter_type<>'asset')
+ then raise exception 'Approved chart of accounts mapping incompatible with transaction';end if;
+ select * into v_journal from public.journal_entries j
+  where j.id=p_journal_entry_id and j.company_id=c and j.business_unit_id=b
+  for update;
+ if not found or v_journal.status<>'posted' or v_journal.currency_code is distinct from 'SAR'
+ then raise exception 'Posted SAR journal in the current scope required';end if;
+ if v_journal.reversal_of_entry_id is not null or exists (
+  select 1 from public.journal_entries rev where rev.reversal_of_entry_id=p_journal_entry_id
+   and rev.status='posted' and rev.company_id=c and rev.business_unit_id=b)
+ then raise exception 'Reversed or reversal journal cannot prove partner payment';end if;
+ if exists(select 1 from public.invoice_payment_allocations a where a.journal_entry_id=p_journal_entry_id)
+  or exists(select 1 from public.purchase_payment_allocations a where a.journal_entry_id=p_journal_entry_id)
+ then raise exception 'Canonical customer/supplier settlement cannot be re-labelled a partner transfer';end if;
+ if exists(select 1 from public.transport_collection_cash_evidence e where e.journal_entry_id=p_journal_entry_id)
+ then raise exception 'This cash journal is already linked to a partner';end if;
+ if exists(select 1 from public.journal_lines jl where jl.entry_id=p_journal_entry_id
+ and (jl.company_id is distinct from c or jl.business_unit_id is distinct from b))
+ then raise exception 'Journal line has an invalid tenant or business unit';end if;
+ -- Deliberately reject compound/fee/FX journals. Only a straightforward balanced
+ -- 2-line SAR journal with one Bank/Cash asset and exact approved counterpart can link.
+ select count(*),
+  count(*) filter(where coalesce(coa.detail_type,'') in ('Bank Account','Cash on Hand')),
+  count(*) filter(where jl.account_id=v_counterpart_account),
+  (array_agg(jl.account_id) filter(where coa.detail_type in('Bank Account','Cash on Hand')))[1],
+  coalesce(sum(jl.debit) filter(where coa.detail_type in('Bank Account','Cash on Hand')),0),
+  coalesce(sum(jl.credit) filter(where coa.detail_type in('Bank Account','Cash on Hand')),0),
+  coalesce(sum(jl.debit) filter(where jl.account_id=v_counterpart_account),0),
+  coalesce(sum(jl.credit) filter(where jl.account_id=v_counterpart_account),0)
+ into v_line_count,v_cash_count,v_counterpart_count,v_cash_account,
+      v_cash_debit,v_cash_credit,v_counter_debit,v_counter_credit
+ from public.journal_lines jl left join public.chart_of_accounts coa on coa.id=jl.account_id
+ where jl.entry_id=p_journal_entry_id and jl.company_id=c and jl.business_unit_id=b
+  and coa.company_id=c and coa.is_active and not coa.is_group;
+ if v_line_count<>2 or v_cash_count<>1 or v_counterpart_count<>1
+  or v_cash_account=v_counterpart_account then
+  raise exception 'Journal must have exactly one Cash/Bank and one approved partner account line';end if;
+ if p_kind='partner_vat_received' then
+  if v_cash_credit<>0 or v_counter_debit<>0 or v_cash_debit<=0 or v_cash_debit<>v_counter_credit
+  then raise exception 'VAT reimbursement needs debit Cash/Bank, credit partner VAT receivable';end if;
+  v_amount:=v_cash_debit;
+ else
+  if v_cash_debit<>0 or v_counter_credit<>0 or v_cash_credit<=0 or v_cash_credit<>v_counter_debit
+  then raise exception 'Partner transfer/advance needs credit Cash/Bank, debit approved partner account';end if;
