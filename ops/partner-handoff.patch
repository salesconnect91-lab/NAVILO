+-- Read-only running account; invoice, collection and VAT are attributed analytics only.
+-- Historical conflicts, missing opening/approved account mapping quarantine payout eligibility.
+create function public.transport_collection_running_statement(p_partner_id uuid,p_as_of date default null)
+returns jsonb language plpgsql stable security definer set search_path=public,pg_temp as $$
+declare
+ c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();
+ v_invoice jsonb;v_vat_due numeric;v_advance numeric;v_transfer numeric;v_vat_received numeric;
+ v_review bigint;v_received numeric;v_outstanding numeric;v_mapping_ok boolean;v_has_reversal boolean;
+ v_result jsonb;
+begin
+ if p_as_of is not null then
+  raise exception 'Dated partner statements are disabled until canonical receipt-date cutoffs are reconciled';
+ end if;
+ if auth.uid() is null or c is null or b is null or p_partner_id is null
+  or not public.has_module_permission(c,'transport','view')
+  or not public.has_module_permission(c,'accounting','view')
+  or not exists(select 1 from public.transport_collection_settings s where s.company_id=c and s.business_unit_id=b and s.enabled)
+  or not exists(select 1 from public.transport_collection_partners p
+    where p.id=p_partner_id and p.company_id=c and p.business_unit_id=b)
+ then raise exception 'Partner running account view permission denied';end if;
+ -- Native, posted invoice evidence always stays a single source, never add imported opening documents.
+ v_invoice:=public.transport_collection_partner_invoice_ledger(p_partner_id,null,p_as_of,'',1,0);
+ v_review:=coalesce((v_invoice->>'review_invoice_count')::bigint,0);
+ v_received:=coalesce((v_invoice->>'verified_received')::numeric,0);
+ v_outstanding:=coalesce((v_invoice->>'verified_outstanding')::numeric,0);
+ select round(coalesce(sum(l.vat_snapshot),0),2) into v_vat_due
+ from public.transport_customer_documents d
+ join public.sales_orders s on s.id=d.sales_order_id and s.company_id=c and s.business_unit_id=b and s.status='posted'
+ join public.transport_customer_document_trips l on l.document_id=d.id and l.company_id=c and l.business_unit_id=b
+ join public.transport_trips t on t.id=l.trip_id and t.company_id=c and t.business_unit_id=b
+ join public.transport_collection_settings cfg on cfg.company_id=c and cfg.business_unit_id=b
+ left join public.transport_collection_owner_aliases oa on oa.company_id=c and oa.business_unit_id=b
+  and oa.owner_key=upper(regexp_replace(btrim(coalesce(t.owner_name_snapshot,'')),E'\\s+',' ','g'))
+ where d.company_id=c and d.business_unit_id=b and (p_as_of is null or s.order_date<=p_as_of)
+  and btrim(coalesce(t.owner_name_snapshot,''))<>''
+  and coalesce(oa.partner_id,cfg.default_partner_id)=p_partner_id;
+ with cash_source as (
+  select e.kind,e.amount,j.status,
+   exists(select 1 from public.journal_entries rev
+     where rev.reversal_of_entry_id=j.id and rev.status='posted'
+       and rev.company_id=c and rev.business_unit_id=b) reversed
+  from public.transport_collection_cash_evidence e
+  join public.journal_entries j on j.id=e.journal_entry_id and j.company_id=c and j.business_unit_id=b
+  where e.partner_id=p_partner_id and e.company_id=c and e.business_unit_id=b
+ )
+ select coalesce(sum(amount) filter(where kind='partner_advance' and status='posted' and not reversed),0),
+   coalesce(sum(amount) filter(where kind='partner_transfer' and status='posted' and not reversed),0),
+   coalesce(sum(amount) filter(where kind='partner_vat_received' and status='posted' and not reversed),0),
+   coalesce(bool_or(status<>'posted' or reversed),false)
+ into v_advance,v_transfer,v_vat_received,v_has_reversal from cash_source;
+ select exists(select 1 from public.transport_collection_finance_mapping m
+  where m.company_id=c and m.business_unit_id=b and m.is_approved) into v_mapping_ok;
+ v_result:=jsonb_build_object(
+  'partner_id',p_partner_id,'as_of',p_as_of,'invoice_count',v_invoice->'invoice_count',
+  'verified_invoice_count',v_invoice->'verified_invoice_count',
+  'review_invoice_count',v_review,
+  'verified_billed',v_invoice->'verified_billed',
+  'verified_received',v_received,
+  'verified_customer_outstanding',v_outstanding,
+  'attributed_vat_due',v_vat_due,'partner_vat_received',v_vat_received,
+  'partner_vat_balance',v_vat_due-v_vat_received,
+  'partner_advances_paid',v_advance,'partner_transfers_paid',v_transfer,
+  'cash_held_before_vat_reimbursement',v_received-v_advance-v_transfer,
+  'payout_enabled',false,
+  'review_required',(v_review>0 or not v_mapping_ok or v_has_reversal),
+  'review_reasons',jsonb_build_array(
+   case when v_review>0 then 'INVOICE_OR_HISTORICAL_SOURCE_REVIEW' end,
+   case when not v_mapping_ok then 'ACCOUNT_MAPPING_NOT_APPROVED' end,
+   case when v_has_reversal then 'CASH_EVIDENCE_REVERSED' end),
+  'disclaimer','Read-only analytical statement. No bank transfer or VAT return entry is created. Payout is disabled until separate financial acceptance.'
+ );
+ return v_result;
+end $$;
+revoke all on function public.transport_collection_running_statement(uuid,date) from public,anon;
+grant execute on function public.transport_collection_running_statement(uuid,date) to authenticated;
