+ it('conserves every halala across mixed-partner partial receipts',()=>{
+  for(let amount=1;amount<=30000;amount+=197){const shares=autoAllocate(amount,caps);expect(shares.reduce((s,x)=>s+x.halalas,0)).toBe(amount);for(const x of shares)expect(x.halalas).toBeLessThanOrEqual(caps.find(c=>c.key===x.key)!.availableHalalas);}
+ });
