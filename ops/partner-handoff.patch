+ if not exists(select 1 from public.transport_collection_settings s where s.company_id=c and s.business_unit_id=b and s.enabled)
+ then raise exception 'Partner collection disabled';end if;
+ p_code:=lower(btrim(coalesce(p_code,'')));
+ p_name:=btrim(coalesce(p_name,''));
+ if p_code !~ '^[a-z0-9_-]{1,40}$' or length(p_name) not between 1 and 120 then raise exception 'Invalid partner code/name';end if;
+ insert into public.transport_collection_partners(company_id,business_unit_id,code,name)
+ values(c,b,p_code,p_name) returning id into new_id;
+ return new_id;
+end $$;
