+ then raise exception 'Owner has immutable receipt shares; reviewed supersession required';end if;
+ select count(*) into n from public.transport_trips where company_id=c and business_unit_id=b and upper(regexp_replace(btrim(coalesce(owner_name_snapshot,'')),E'\\s+',' ','g'))=k;
+ insert into public.transport_collection_owner_aliases(company_id,business_unit_id,owner_key,partner_id) values(c,b,k,p_partner_id) returning id into new_id;
