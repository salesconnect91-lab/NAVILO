+import XLSX from 'xlsx';
+const file=process.argv[2];
+if(!file)throw Error('Usage: node scripts/reconcile_partner_workbook.mjs SOURCE.xlsm');
+const wb=XLSX.readFile(file), read=name=>XLSX.utils.sheet_to_json(wb.Sheets[name],{header:1,blankrows:false});
+const clean=x=>String(x??'').trim().toUpperCase();
+const money=x=>typeof x==='number'&&Number.isFinite(x)?Math.round(x*100):null;
+const invoices=read('Invoice Entry').slice(3).filter(r=>clean(r[1])&&clean(r[2])&&typeof r[6]==='number');
+const payments=read('Payment Entry').slice(3).filter(r=>clean(r[2])&&clean(r[3])&&typeof r[9]==='number');
+const key=(no,cust)=>clean(cust)+'|'+clean(no);
+const inv=new Map(),paid=new Map();const exceptions=[];
+let mixed=0,invoiceMismatch=0,invalidPaymentShares=0,paymentMismatch=0,subCentInvoice=0,subCentPayment=0;
+for(const r of invoices){const k=key(r[1],r[2]);inv.set(k,[...(inv.get(k)??[]),r]);const shares=r.slice(7,11).map(money);if(shares.filter(x=>x>0).length>1)mixed++;if(shares.some(x=>x===null)||shares.reduce((s,x)=>s+(x??0),0)!==money(r[6])){invoiceMismatch++;exceptions.push({kind:'invoice_rounded_split_mismatch',key:k,gross:r[6],shares:r.slice(7,11)});}if(Math.abs(r[6]*100-Math.round(r[6]*100))>1e-6)subCentInvoice++;}
+for(const r of payments){const k=key(r[2],r[3]);paid.set(k,(paid.get(k)??0)+money(r[9]));const shares=r.slice(5,9).map(money);if(shares.some(x=>x===null)){invalidPaymentShares++;exceptions.push({kind:'invalid_payment_share',key:k,shares:r.slice(5,9)});}else if(shares.reduce((s,x)=>s+x,0)!==money(r[9]))paymentMismatch++;if(Math.abs(r[9]*100-Math.round(r[9]*100))>1e-6)subCentPayment++;}
+let duplicateKeys=0,unmatchedPayments=0,overpaidInvoices=0;const examples=[];
+for(const [k,rs] of inv){if(rs.length>1){duplicateKeys++;if(examples.length<10)examples.push({kind:'duplicate_invoice',key:k,rows:rs.length});}const gross=rs.reduce((s,r)=>s+money(r[6]),0);if((paid.get(k)??0)>gross){overpaidInvoices++;exceptions.push({kind:'overpaid_invoice',key:k,invoiceSar:gross/100,receivedSar:paid.get(k)/100});}}
+for(const k of paid.keys())if(!inv.has(k)){unmatchedPayments++;if(examples.length<10)examples.push({kind:'payment_without_invoice',key:k});}
+console.log(JSON.stringify({source:file,invoiceRows:invoices.length,paymentRows:payments.length,mixedPartnerInvoices:mixed,duplicateInvoiceKeys:duplicateKeys,invoiceSplitMismatches:invoiceMismatch,invalidPaymentShareRows:invalidPaymentShares,paymentSplitMismatches:paymentMismatch,paymentKeysWithoutInvoice:unmatchedPayments,overpaidInvoiceKeys:overpaidInvoices,subCentInvoiceRows:subCentInvoice,subCentPaymentRows:subCentPayment,invoiceGrossSar:invoices.reduce((s,r)=>s+money(r[6]),0)/100,paymentGrossSar:payments.reduce((s,r)=>s+money(r[9]),0)/100,openingStatus:'NOT VERIFIED: workbook invoice/payment movements do not establish signed partner cutover balances or canonical NAVILO receipt identity',examples,exceptions},null,2));
