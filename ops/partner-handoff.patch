+create function public.transport_collection_add_owner_alias(p_owner_key text,p_partner_id uuid)
+returns uuid language plpgsql security definer set search_path=public,pg_temp as $$
+declare c uuid:=public.current_company_id();b uuid:=public.current_business_unit_id();new_id uuid;normalized text;
+begin
+ if auth.uid() is null or c is null or b is null
+   or not public.has_module_permission(c,'settings','edit')
+   or not public.has_module_permission(c,'transport','view') then raise exception 'Owner settings permission required';end if;
+ if not public.is_platform_owner()
+ and not exists(select 1 from public.company_memberships cm where cm.company_id=c and cm.user_id=auth.uid() and cm.is_active and cm.role in ('company_owner','admin'))
+ and not exists(select 1 from public.business_unit_memberships bm where bm.company_id=c and bm.business_unit_id=b and bm.user_id=auth.uid() and bm.is_active and bm.role in ('company_owner','admin'))
+ then raise exception 'Owner/Admin required';end if;
+ if not exists(select 1 from public.transport_collection_settings s where s.company_id=c and s.business_unit_id=b and s.enabled)
+ then raise exception 'Partner collection disabled';end if;
+ normalized:=upper(regexp_replace(btrim(coalesce(p_owner_key,'')),E'\\s+',' ','g'));
+ if length(normalized) not between 1 and 150 then raise exception 'Invalid owner alias';end if;
+ if exists(select 1 from public.transport_trips t where t.company_id=c and t.business_unit_id=b
+ and upper(regexp_replace(btrim(coalesce(t.owner_name_snapshot,'')),E'\\s+',' ','g'))=normalized) then
+ raise exception 'Existing Trips already use this Owner; an audited effective-date mapping is required';end if;
+ if not exists(select 1 from public.transport_collection_partners p where p.id=p_partner_id and p.company_id=c and p.business_unit_id=b and p.is_active)
+ then raise exception 'Active partner in current workspace required';end if;
+ insert into public.transport_collection_owner_aliases(company_id,business_unit_id,owner_key,partner_id)
+ values(c,b,normalized,p_partner_id) returning id into new_id;
+ return new_id;
+end $$;
