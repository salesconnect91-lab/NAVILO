+   <label className="grid max-w-56 gap-1">Expected payment · SAR<input className="input h-8" inputMode="decimal" placeholder="0.00" value={expected} onChange={e=>{setExpected(e.target.value);setResult([]);}}/></label>
+   <div className="flex flex-wrap gap-2"><button className="btn" onClick={()=>compute('auto')}>Auto allocate</button><button className="btn" onClick={()=>compute('manual')}>Validate manual</button></div>
+   <div className="grid gap-2 sm:grid-cols-2 xl:grid-cols-4">{assessment.capacities.map(cap=><label key={cap.key} className="grid gap-1">{review.partners.find(p=>p.partner_id===cap.partnerId)?.partner_name} · Manual SAR (max {halalasToSar(cap.availableHalalas)})
+    <input className="input h-8" inputMode="decimal" placeholder="0.00" value={manual[cap.key]??''} onChange={e=>{setManual(m=>({...m,[cap.key]:e.target.value}));setResult([]);}}/></label>)}</div>
+   {result.length>0&&<div className="rounded bg-slate-50 p-2"><b>Preview split — SAR {money(result.reduce((s,x)=>s+x.halalas,0)/100)}:</b>
+    {result.map(x=><div key={x.key} className="flex justify-between border-t py-1"><span>{review.partners.find(p=>p.partner_id===x.partnerId)?.partner_name}</span><b>{halalasToSar(x.halalas)}</b></div>)}
+    <p className="pt-2 text-slate-600">No cash receipt, partner payout, VAT entry, or invoice change created. The expected payment is not saved.</p></div>}
+  </div>}
+  </>}
+ </section>;
+}
