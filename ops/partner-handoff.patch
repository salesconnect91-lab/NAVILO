+name: Partner Collection isolated accounting
+on:
+  workflow_dispatch:
+  push:
+    branches: [main]
+    paths:
+      - '.github/workflows/partner-collection-isolated.yml'
+      - 'supabase/tests/*partner*'
+      - 'supabase/migrations/*partner_collection*'
+      - 'src/modules/transport/Partner*'
+      - 'src/modules/transport/partner*'
+permissions:
+  contents: read
+jobs:
+  partner-postgres:
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    services:
+      postgres:
+        image: postgres:17
+        env:
+          POSTGRES_DB: navilo_transport_rehearsal
+          POSTGRES_PASSWORD: navilo-rehearsal-only
+        ports:
+          - 6543:5432
+        options: >-
+          --health-cmd pg_isready
+          --health-interval 10s
+          --health-timeout 5s
+          --health-retries 5
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci --no-audit --no-fund
+      - run: npm install --prefix "$RUNNER_TEMP/navilo-rehearsal-driver" --no-save --package-lock=false --no-audit --no-fund pg@8.16.3
+      - name: Verify Partner accounting and concurrent sessions
+        env:
+          NAVILO_NATIVE_REHEARSAL: '1'
+          NAVILO_PG_DRIVER: ${{ runner.temp }}/navilo-rehearsal-driver/node_modules/pg/lib/index.js
+        run: npm run test:partner-db
