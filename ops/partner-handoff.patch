+import {useCallback,useEffect,useRef,useState} from 'react';
+import {supabase} from '@/lib/supabase';
+import {formatNaviloDate} from '@/lib/naviloDate';
+import {partnerReviewLabel} from './partnerReviewLabels';
+
+type Partner={id:string;code:string;name:string;is_active:boolean};
+type LedgerRow={invoice_id:string;invoice_no:string;invoice_date:string;status:string;
+ partner_net:number;partner_vat:number;partner_gross:number;canonical_paid:number;
+ partner_received:number|null;partner_outstanding:number|null;partner_count:number;
+ opening_mismatch:boolean;historical_received:boolean;opening_settled:boolean;
+ flags:string[];verified:boolean};
+type Ledger={partner_id:string;invoice_count:number;verified_invoice_count:number;review_invoice_count:number;
+ verified_billed:number;verified_received:number;verified_outstanding:number;review_billed:number;rows:LedgerRow[]};
+const money=(n:number|null|undefined)=>n==null?'Review Required':Number(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
+/** Read-only accounting EVIDENCE, NOT a partner payout authorization or statutory ledger. */
+export default function PartnerInvoiceLedger({partners}:{partners:Partner[]}){
+ const [partner,setPartner]=useState('');const [from,setFrom]=useState('');const [to,setTo]=useState('');
+ const [search,setSearch]=useState('');const [submittedSearch,setSubmittedSearch]=useState('');
+ const [page,setPage]=useState(0);const [ledger,setLedger]=useState<Ledger|null>(null);
+ const [loading,setLoading]=useState(false);const [error,setError]=useState('');const generation=useRef(0);
+ const selected=partner||partners.find(p=>p.is_active)?.id||'';
+ const load=useCallback(async()=>{
+  const token=++generation.current;setLedger(null);setError('');
+  if(!selected)return;
+  if(from&&to&&from>to){setError('From date cannot be after To date.');return;}
+  setLoading(true);
+  try{
+   const r=await supabase.rpc('transport_collection_partner_invoice_ledger',{
+    p_partner_id:selected,p_from:from||null,p_to:to||null,p_search:submittedSearch,p_limit:50,p_offset:page*50
+   });
+   if(r.error)throw r.error;
+   if(generation.current===token)setLedger(r.data as Ledger);
+  }catch(e){if(generation.current===token)setError((e as {message?:string})?.message||'Could not load partner invoice ledger');}
+  finally{if(generation.current===token)setLoading(false);}
+ },[selected,from,to,submittedSearch,page]);
+ useEffect(()=>{void load();const changed=()=>{void load();};window.addEventListener('navilo:partner-change',changed);return()=>{generation.current++;window.removeEventListener('navilo:partner-change',changed);};},[load]);
+ const changePartner=(v:string)=>{setPartner(v);setPage(0);};
+ const submitSearch=()=>{setPage(0);setSubmittedSearch(search.trim());};
+ return <section className="space-y-2 rounded border bg-white p-3 text-xs">
+  <div className="flex flex-wrap items-start justify-between gap-2"><div><h3 className="text-sm font-bold">Partner Receivables Ledger · Invoice Evidence</h3>
+   <p className="text-slate-600">Partner invoice shares, verified customer receipts and outstanding. Imported source differences are flagged for review. No payout is posted here.</p></div>
+   <span className="rounded bg-slate-100 px-2 py-1 font-semibold text-slate-700">Read only · SAR</span></div>
+  <div className="flex flex-wrap items-end gap-2">
+   <label className="grid gap-1">Partner<select aria-label="Ledger partner" className="input h-8 min-w-40" value={selected} onChange={e=>changePartner(e.target.value)}>{partners.filter(p=>p.is_active).map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</select></label>
+   <label className="grid gap-1">Invoice from<input aria-label="Invoice from date" className="input h-8" type="date" value={from} onChange={e=>{setFrom(e.target.value);setPage(0);}}/></label>
+   <label className="grid gap-1">Invoice to<input aria-label="Invoice to date" className="input h-8" type="date" value={to} onChange={e=>{setTo(e.target.value);setPage(0);}}/></label>
+   <label className="grid gap-1">Invoice number<input aria-label="Ledger invoice search" className="input h-8 w-44" value={search} onChange={e=>setSearch(e.target.value)} onKeyDown={e=>{if(e.key==='Enter')submitSearch();}}/></label>
+   <button className="btn h-8" onClick={submitSearch} disabled={loading}>Search</button><button className="btn h-8" onClick={()=>void load()} disabled={loading}>Refresh</button>
+  </div>
+  {loading&&<p role="status" className="text-slate-500">Reconciling partner invoices…</p>}
+  {error&&<p role="alert" className="rounded border border-red-200 bg-red-50 p-2 text-red-700">{error}</p>}
+  {ledger&&!loading&&<>
+   <div className="grid grid-cols-2 gap-2 md:grid-cols-4">
+    <div className="rounded bg-slate-50 p-2"><div className="text-slate-500">Verified Sales · gross</div><strong>{money(ledger.verified_billed)}</strong></div>
+    <div className="rounded bg-slate-50 p-2"><div className="text-slate-500">Verified Customer Received</div><strong>{money(ledger.verified_received)}</strong></div>
+    <div className="rounded bg-slate-50 p-2"><div className="text-slate-500">Verified Customer Outstanding</div><strong>{money(ledger.verified_outstanding)}</strong></div>
+    <div className="rounded bg-amber-50 p-2"><div className="text-amber-800">Review Required · invoice gross</div><strong>{money(ledger.review_billed)}</strong></div>
+   </div>
+   <p className="rounded border border-amber-200 bg-amber-50 p-2 text-amber-900">{ledger.verified_invoice_count} verified invoices; {ledger.review_invoice_count} held for review. Verified totals exclude review invoices and opening-only invoices. Amounts reflect canonical customer invoice/receipt evidence, NOT partner payout balance or Twakkal statutory P&amp;L.</p>
+   <div className="overflow-x-auto rounded border"><table className="w-full min-w-[850px] text-right text-xs"><thead className="bg-slate-50"><tr><th className="p-2 text-left">Invoice</th><th className="p-2 text-left">Date</th><th className="p-2">Partners</th><th className="p-2">Net Sales</th><th className="p-2">VAT</th><th className="p-2">Partner Gross</th><th className="p-2">Received</th><th className="p-2">Receivable</th><th className="p-2 text-left">Status / reason</th></tr></thead>
+    <tbody>{ledger.rows.map(r=><tr className="border-t" key={r.invoice_id}><td className="p-2 text-left font-semibold">{r.invoice_no}</td><td className="p-2 text-left">{formatNaviloDate(r.invoice_date)}</td><td className="p-2">{r.partner_count}</td><td className="p-2">{money(r.partner_net)}</td><td className="p-2">{money(r.partner_vat)}</td><td className="p-2">{money(r.partner_gross)}</td><td className="p-2">{money(r.partner_received)}</td><td className="p-2">{money(r.partner_outstanding)}</td><td className="p-2 text-left">{r.verified?'Verified':`Review Required: ${r.flags.map(partnerReviewLabel).join(', ')}`}</td></tr>)}
+    {!ledger.rows.length&&<tr><td colSpan={9} className="p-4 text-center text-slate-500">No invoices matching these filters.</td></tr>}</tbody></table></div>
+   <div className="flex items-center gap-2"><button className="btn" disabled={page===0} onClick={()=>setPage(p=>p-1)}>Previous</button><span>{ledger.invoice_count?`${page*50+1}–${Math.min((page+1)*50,ledger.invoice_count)} / ${ledger.invoice_count}`:'0 invoices'}</span><button className="btn" disabled={(page+1)*50>=ledger.invoice_count} onClick={()=>setPage(p=>p+1)}>Next</button></div>
+   <p className="text-slate-500">Mixed-partner receipts are shown only after every receipt has an immutable, verified partner link. No partner transfers or VAT reimbursements are inferred from supplier-payment records. Filter totals cover all matched invoices, not just the current page.</p>
+  </>}
+ </section>;
+}
diff --git a/src/modules/transport/PartnerMonthlyReport.tsx b/src/modules/transport/PartnerMonthlyReport.tsx
new file mode 100644
